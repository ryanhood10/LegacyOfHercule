; Chapter 1, the opening (docs/story.md section 0 item 1), applied by ch1_opening.json:
;  - future prologue: old Hercule is player 2 beside Trunks (party slot 5), comic relief, no hint of
;    what he becomes; he leaves with Trunks at the end of the Goku-arrival scene;
;  - present day: Krillin visits Gohan instead of phoning and joins (slot 6, player 2);
;  - the forest "spirit" (Frieza + Cooler, the stock dream's clearing zone 2 area 8) replaces the dream;
;  - Krillin's NPC is gone from the Frieza landing site (zone 3 areas 4 and 6).
; Speakers: 1 Gohan/Trunks box, 3 Piccolo, 44 Cooler, 49 Frieza, 57 Future Gohan, 67 Hercule, 126 old Hercule (Buu's Fury portrait),
; 73 Krillin, 98 Trunks. Sprites: 48 Frieza (dream), 34 Cooler, 76 Krillin, 128 Trunks, 158 old Hercule.
; Story flags of this chapter: 360 = Krillin has visited.

; ---- future prologue ----------------------------------------------------------------------------

; map 0 (zone 1 area 1) trigger 0: Future Gohan's training, with old Hercule hanging back
sequence ch1_training
  text 0 "@^Choose the difficulty.  It can't be changed later."    ; [0] (src/coop/difficulty.h, flags 460 / 461)
  script                                 ; [1] a yes / no question (CoopCall 18: A yes, B no)
        CoopCall 18, 1, 0, 0
  text 0 "@^Play on Normal?  (A: Yes  B: No)"
  script                                 ; [3] yes: Normal (no flag); no: the next question
        CoopCall 18, 0, 0, 0
        PushByte 1
        CmpEq
        JumpIfFalse L1
        PushByte 9
        END
      L1:
        PushByte 4
        END
  script                                 ; [4]
        CoopCall 18, 1, 0, 0
  text 0 "@^Easy or Hard?  (A: Easy  B: Hard)"
  script                                 ; [6]
        CoopCall 18, 0, 0, 0
        PushByte 1
        CmpEq
        JumpIfFalse L1
        SetStoryFlag 460
        PushByte 7
        END
      L1:
        SetStoryFlag 461
        PushByte 8
        END
  text 0 "@^Easy difficulty." -> 10
  text 0 "@^Hard difficulty." -> 10
  text 0 "@^Normal difficulty."
  stockseq @083b6ec8 0 5                 ; Trunks' doubts, Gohan's answer, "I won't let you down"
  text 126 "#HERCULE: And don't you boys worry about me!\x0bI'll be guarding the rear.  From way back here."
  stockseq @083b6ec8 6 7                 ; Gohan: the melee practice, destroy that boulder
  text 126 "#A boulder?  Ha!  I've chopped bigger rocks than that in my sleep!\x0b...You go first, kid."
  stockseq @083b6ec8 8                   ; Gohan walks off, control back
end

; map 1 (zone 1 area 2) trigger 0: Gohan's death and the jump to the present
sequence ch1_future_end
  stockseq @083b7adc 0 3                 ; the androids' attack, Trunks finds Gohan
  text 126 "#T-Trunks...  They're gone.\x0bLet's get out of here before those two come back!"
  stockseq @083b7adc 4                   ; "Present day Earth...", Gohan's chapter begins
end

; map 0 record 0 (Future Gohan) talk: the knock-out, then Hercule's protest and Gohan's answer (Ryan, 2026-11-01)
; before Gohan's "Sorry about that, Trunks." (stock entry 15)
sequence ch1_knockout
  stockseq @083b725c 0 14                ; the melee / ki lessons, "Let's go get 'em!", the knock-out
  text 126 "#HERCULE: What are you doing?!"
  text 57 "#GOHAN: It's not safe out there, Hercule!  You stay here and watch after Trunks."
  stockseq @083b725c 15 20               ; "Sorry about that, Trunks", Gohan flies off, Trunks wakes
end

; ---- present day: Krillin visits ------------------------------------------------------------------

; map 19 (Gohan's room, zone 2 area 22) trigger 0 condition: math time, before Krillin's visit
script ch1_room_cond
    StackTestStoryFlag 4
    StackTestStoryFlagNot 360
    And
end

; map 19 trigger 0: no dozing off and no dream; Krillin walks in instead of phoning
sequence ch1_krillin_visit
  stock @083bb624                        ; Gohan sits down at his desk
  stock @083bb662                        ; "I guess I'll just do my math for a while..."
  script
        WaitFrames 40
        PlayAudio 10
        SpawnCharacterEntity 76, 216, 148
        WalkToPosition 76, 160, 120
        WalkToPosition 76, 144, 108
        SetEntityFacing 76, 2
        SetEntityFacing 0, 3
        PlayAudio 50
  stock @083b9d16                        ; Krillin: are you feeling what I'm feeling? (the stock call, in person)
  stock @083b9d4e
  stock @083b9d94
  stock @083b9ddc
  stock @083b9e30
  stock @083b9ec0                        ; Gohan: first I need my Saiyan Battle Armor, hidden in a cave
  stock @083b9f2c
  text 73 "KRILLIN: I'll come with you.  With Frieza around, two of us are safer than one."
  text 1 "#Thanks, Krillin!  The cave is in the forest, just past our house."
  script
        SetCharacterInPartyFlag 6
        SetCharacterFlag_Bit1 6
        RemoveItem 37
        SetStoryFlag 11
        SetStoryFlag 360
        PlayAudio 62
  text 0 "@^Krillin is now available!"
  stock @083b9f82                        ; Journal Updated!
  script                                 ; Gohan gets up from the desk (the stock sit puts him inside its collision)
        SetEntityPositionInstant 0, 136, 104
        WalkToPosition 0, 136, 120
        BeginCommandBatch
        WalkToPosition 76, 160, 120
        WalkToPosition 0, 152, 132
        CommitCommandBatch
        CoopCall 5, 0, 0, 0                   ; two players: he ends where player 2's entity appears (12 px left of player 1)
        JumpIfFalse K1
        WalkToPosition 76, 140, 132
        Jump K2
      K1:
        WalkToPosition 76, 216, 148
      K2:
        DespawnEntity 76
        SetPlayerVisible 1
end

; ---- the forest spirit (zone 2 area 8, map 14) ----------------------------------------------------

; trigger 0: on the way to the cave the forest goes quiet, Frieza and Cooler appear
sequence ch1_spirit
  [0] script                             ; only who is played (Ryan, 2026-11-05): player 1 walks up; both played: Gohan's line (1), Gohan alone (2), Krillin alone (3)
        SetPlayerVisible 0
        WalkToPosition 0, 96, 176
        SetEntityFacing 0, 1
        PanCameraToPosition 0, 104, 2         ; (was 0, 0: the box hid Frieza and the players stood below the view)
        WaitFrames 40
        PlayAudio 50
        CoopCall 22, 4, 6, 0
        JumpIfFalse g
        CoopCall 22, 4, 0, 0
        JumpIfFalse k
        PushByte 1
        END
      g:
        PushByte 2
        END
      k:
        PushByte 5
        END
  [1] text 1 "#GOHAN: Krillin, wait...\x0bHuh?  The whole forest just went quiet." -> 4
  [2] text 1 "#GOHAN: Huh?  The whole forest just went quiet." -> 6
  stop
  [4] text 73 "KRILLIN: Gohan...  Do you feel that?  Something is here with us." -> 6
  [5] text 73 "KRILLIN: Huh?  The whole forest just went quiet...\x0bSomething is here." -> 6
  [6] script
        FadeToWhite 120
        TriggerMapEvent 1
        WhiteFadeOut 30
        WhiteFlash 40
  [7] stock @083b952c                    ; Frieza: your dad isn't coming back!
  [8] text 44 "COOLER: And when we are finished with you, Earth will learn what it means to cross our family."
  [9] script                             ; player 1 recoils a step; Krillin played: his line (10), else Gohan's (11)
        WalkToPosition 0, 96, 186
        SetEntityFacing 0, 1
        CoopCall 22, 4, 6, 0
        JumpIfFalse a
        PushByte 10
        END
      a:
        PushByte 11
        END
  [10] text 73 "KRILLIN: Frieza AND Cooler?!  This can't be happening!" -> 12
  [11] text 1 "#GOHAN: Frieza AND Cooler?!  This can't be happening!"
  [12] stock @083b958c                   ; boss bar, battle music, control back
  [13] script                            ; the camera follows the player again (entry 0's pan kept it on the clearing's top)
        SetActiveEntity 0
end

; record 1 (Frieza, stat 41; Cooler is his pair, src/coop/bosses.c) defeat: the two fade and the players are told it was the
; forest's spirit. They stay in the clearing: behind the white fade the scene moves to the real clearing (zone 2 area 3: the
; fight's area 8 has the same layout but no way out), which also clears both bodies. Only who is played (Ryan, 2026-11-05).
sequence ch1_spirit_end
  [0] script                             ; Gohan played: his line (1), else Krillin's (2)
        WhiteFlash 5
        WaitFrames 40
        FindPlayerEntity
        AddEXP 20
        SetPlayerVisible 0
        SetStoryFlag 9
        FadeToWhite 120
        WarpToMapWithEntities 2, 3, 0, 96, 176
        WhiteFadeOut 120
        PlayAudio 50
  [1] text 0 "@^The two figures melted away into the mist..."
  [2] script
        CoopCall 22, 4, 0, 0
        JumpIfFalse a
        PushByte 3
        END
      a:
        PushByte 4
        END
  [3] text 1 "#GOHAN: They're gone...  Were they even real?" -> 5
  [4] text 73 "KRILLIN: They're gone...  Were they even real?"
  [5] script                             ; the voice comes from everywhere: player 1 looks up
        SetEntityFacing 0, 1
        WaitFrames 20
  [6] text 0 "@^VOICE: Do not be afraid, children.  You did not fight Frieza and Cooler...\x0b...but the spirit of the forest, wearing the faces of your fears."
  [7] script                             ; both played (8, 9), Krillin alone (8), Gohan alone (10)
        CoopCall 22, 4, 6, 0
        JumpIfFalse g
        PushByte 8
        END
      g:
        PushByte 10
        END
  [8] text 73 "KRILLIN: The spirit of the forest?  Well, it sure hit like Frieza!"
  [9] script
        CoopCall 22, 4, 0, 0
        JumpIfFalse a
        PushByte 11
        END
      a:
        PushByte 12
        END
  [10] text 1 "#GOHAN: The spirit of the forest...\x0bLet's get my armor from the cave." -> 12
  [11] text 1 "#Never mind, Krillin.  Let's get my armor from the cave."
  [12] script
        SetPlayerVisible 1
end

