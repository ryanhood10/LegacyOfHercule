; Chapter 1, the opening (docs/story.md section 0 item 1), applied by ch1_opening.json:
;  - future prologue: old Hercule is player 2 beside Trunks (party slot 5), comic relief, no hint of
;    what he becomes; he leaves with Trunks at the end of the Goku-arrival scene;
;  - present day: Krillin visits Gohan instead of phoning and joins (slot 6, player 2);
;  - the forest "spirit" (Frieza + Cooler, the stock dream's clearing zone 2 area 8) replaces the dream;
;  - Krillin's NPC is gone from the Frieza landing site (zone 3 areas 4 and 6).
; Speakers: 1 Gohan/Trunks box, 3 Piccolo, 44 Cooler, 49 Frieza, 57 Future Gohan, 67 Hercule, 126 old Hercule (Buu's Fury portrait),
; 73 Krillin, 98 Trunks. Sprites: 48 Frieza (dream), 34 Cooler, 76 Krillin, 128 Trunks, 158 old Hercule.
; Story flags of this chapter: 360 = Krillin has visited.

; ---- future prologue ----------------------------------------------------------------------------

; map 0 (zone 1 area 1) trigger 0: Future Gohan's training, with old Hercule hanging back
sequence ch1_training
  text 0 "@^Choose the difficulty.  It can't be changed later."    ; [0] (src/coop/difficulty.h, flags 460 / 461)
  script                                 ; [1] a yes / no question (CoopCall 18: A yes, B no)
        CoopCall 18, 1, 0, 0
  text 0 "@^Play on Normal?  (A: Yes  B: No)"
  script                                 ; [3] yes: Normal (no flag); no: the next question
        CoopCall 18, 0, 0, 0
        PushByte 1
        CmpEq
        JumpIfFalse L1
        PushByte 9
        END
      L1:
        PushByte 4
        END
  script                                 ; [4]
        CoopCall 18, 1, 0, 0
  text 0 "@^Easy or Hard?  (A: Easy  B: Hard)"
  script                                 ; [6]
        CoopCall 18, 0, 0, 0
        PushByte 1
        CmpEq
        JumpIfFalse L1
        SetStoryFlag 460
        PushByte 7
        END
      L1:
        SetStoryFlag 461
        PushByte 8
        END
  text 0 "@^Easy difficulty." -> 10
  text 0 "@^Hard difficulty." -> 10
  text 0 "@^Normal difficulty."
  stockseq @083b6ec8 0 5                 ; Trunks' doubts, Gohan's answer, "I won't let you down"
  text 126 "#HERCULE: And don't you boys worry about me!\x0bI'll be guarding the rear.  From way back here."
  stockseq @083b6ec8 6 7                 ; Gohan: the melee practice, destroy that boulder
  text 126 "#A boulder?  Ha!  I've chopped bigger rocks than that in my sleep!\x0b...You go first, kid."
  stockseq @083b6ec8 8                   ; Gohan walks off, control back
end

; map 1 (zone 1 area 2) trigger 0: Gohan's death and the jump to the present
; The cutscene pass (2026-11-06, docs/cutscenes/batch1_ch1-4.md 1.3): the androids are seen (the stock spawned them above the view and the
; blasts came from off screen): the view sits 56 px higher, 17 and 18 walk in from the top, a held look, and the stock's six batches fall as
; one storm from both of them with the ground shaking harder; the stock ending; 17 turns away first and both fly off (the stock despawned
; them where they stood). Old Hercule's line is Ryan's and stays where it is; the scream's power-up shakes the ground and old Hercule is
; pushed back a step. Entry 0 holds the hand-over of player 2's old Hercule to an actor (CoopCall 31) that a json edit used to add.
; With the cinematic helpers (second commit): before the storm Gohan powers up and goes for 17, an exchange of 45 frames, they break; 18 is
; over him and one blow drives him back into the puddle (the marks are set so he lands where the stock's lying body appears); he gets up.
sequence ch1_future_end
  [0] script                             ; stock 0 re-staged
        SetPlayerVisible 0
        CoopCall 31, 0, 0, 0
        JumpIfFalse H1
        PushVarint 158
        CoopCall 31, 1, 0, 0
        CoopCall 31, 2, 0, 0
        Step SpawnCharacterEntity
        CoopCall 31, 3, 0, 0
      H1:
        PanCameraToPosition 104, 232, 3
        WaitFrames 40
        WhiteFlash 3
        SpawnCharacterEntity 11, 200, 204
        SpawnCharacterEntity 9, 288, 204
        BeginCommandBatch
        WalkToPosition 9, 288, 292
        WalkToPosition 11, 200, 280
        SetEntityFacing 11, 2                 ; 18 looks away
        CommitCommandBatch
        WaitFrames 40                         ; a held look
        CoopCall 37, 1, 54, 9
        CoopCall 37, 7, 30, 1                 ; Gohan's power, and he goes for 17: an exchange he holds
        CoopCall 37, 6, 45, 0
        CoopCall 37, 1, 11, 54
        CoopCall 37, 4, 3, 0                  ; 18 is over him: one blow drives him back into the water
        CoopCall 37, 5, 1, 36
        WaitFrames 24
        CoopCall 37, 10, 1, 0                 ; he gets up
        CoopCall 37, 0, 0, 0
        SetEntityFacing 54, 1
        WaitFrames 16
        BeginCommandBatch                     ; the storm: eight blasts from both sides, each a hit
        NPCFireKiBlastAtEntity 9, 54, 120
        EntityWaitFrames 9, 34
        NPCFireKiBlastAtEntity 9, 54, 120
        EntityWaitFrames 9, 30
        NPCFireKiBlastAtEntity 9, 54, 120
        EntityWaitFrames 9, 22
        NPCFireKiBlastAtEntity 9, 54, 120
        EntityWaitFrames 11, 18
        NPCFireKiBlastAtEntity 11, 54, 120
        EntityWaitFrames 11, 32
        NPCFireKiBlastAtEntity 11, 54, 120
        EntityWaitFrames 11, 26
        NPCFireKiBlastAtEntity 11, 54, 120
        EntityWaitFrames 11, 20
        NPCFireKiBlastAtEntity 11, 54, 120
        PushByte 8
        PushToAltStack
      hit:
        EntityWaitTouchPlayer 54
        StackRand 54, 34, 3
        Add
        PlaySFX
        PlayDamageEffect 54
        SetEntityAnimationNoWait 54, 2
        LoopOrJump hit
        ScreenShake 0, 2, 40
        ScreenShake 0, 4, 40
        ScreenShake 0, 7, 50
        CommitCommandBatch
        PlaySFX 54, 20                        ; the stock ending: the explosions round him, the flash, he lies in the water
        EntitySetVelocity 54, 16, 8
        EntityWaitFrames 54, 2
        EntitySetVelocity 54, -8, -16
        EntityWaitFrames 54, 2
        EntitySetVelocity 54, 12, 0
        EntityWaitFrames 54, 2
        EntitySetVelocity 54, -16, 8
        EntityWaitFrames 54, 2
        EntitySetVelocity 54, 0, 0
        PlayAudioBlocking 20, 10
        WhiteFlash 10
        PlayMusic 22
        SetEntityAnimation 54, 3
        DespawnEntity 54
        FindCharacterEntity 0
        WaitFrames 50
        SetEntityFacing 9, 1                  ; 17 turns away first
        WaitFrames 30
        SetEntityFacing 11, 1
        PlayAudio 26
        BeginCommandBatch
        FlyToPosition 9, 260, 190
        EntityWaitFrames 11, 10
        FlyToPosition 11, 190, 190
        CommitCommandBatch
        DespawnEntity 9
        DespawnEntity 11
        PanCameraToPosition 104, 288, 2
        SetActiveEntity 0
        WalkToPosition 0, 272, 392
        WalkToPosition 0, 256, 352
        WalkToPosition 0, 208, 360
        CoopCall 22, 2, 158, 0
        JumpIfFalse H2
        WalkToPosition 158, 240, 376
        SetEntityFacing 158, 2
      H2:
        SetEntityFacing 0, 0
        WaitFrames 150
        PlayAudio 50
        END
  stockseq @083b7adc 1 3                 ; Trunks finds Gohan; "GOHAN!!!!!!!!!!!!!"
  text 126 "#T-Trunks...  They're gone.\x0bLet's get out of here before those two come back!"
  [5] script                             ; stock 4: the scream becomes his first Super Saiyan: the ground shakes under the stock power-up, old Hercule is pushed back a step
        PlayAudio 55
        CoopCall 22, 2, 158, 0
        JumpIfFalse a
        BeginCommandBatch
        SetEntityAnimation 0, 24
        ScreenShake 158, 3, 24
        ScreenShake 158, 7, 30
        GlideToPosition 158, 258, 382, 250
        CommitCommandBatch
        Jump b
      a:
        SetEntityAnimation 0, 24
      b:
        WarpToMapNoEntities 1, 6, 1, 120, 80
        PlayAudio 23
        StopAudio 55
        StopAudio 39
        WaitFrames 180
        UploadSpritePalette
        PlayMusic 10
        END
  stockseq @083b7adc 5                   ; "Present day Earth...", Gohan's chapter begins
end

; map 0 record 0 (Future Gohan) talk: the knock-out, then Hercule's protest and Gohan's answer (Ryan, 2026-11-01)
; before Gohan's "Sorry about that, Trunks." (stock entry 15)
sequence ch1_knockout
  stockseq @083b725c 0 14                ; the melee / ki lessons, "Let's go get 'em!", the knock-out
  text 126 "#HERCULE: What are you doing?!"
  text 57 "#GOHAN: It's not safe out there, Hercule!  You stay here and watch after Trunks."
  stockseq @083b725c 15 20               ; "Sorry about that, Trunks", Gohan flies off, Trunks wakes
end

; ---- present day: Krillin visits ------------------------------------------------------------------

; map 19 (Gohan's room, zone 2 area 22) trigger 0 condition: math time, before Krillin's visit
script ch1_room_cond
    StackTestStoryFlag 4
    StackTestStoryFlagNot 360
    And
end

; map 19 trigger 0: no dozing off and no dream; Krillin walks in instead of phoning
sequence ch1_krillin_visit
  stock @083bb624                        ; Gohan sits down at his desk
  stock @083bb662                        ; "I guess I'll just do my math for a while..."
  script
        WaitFrames 40
        PlayAudio 10
        SpawnCharacterEntity 76, 216, 148
        WalkToPosition 76, 160, 120
        WalkToPosition 76, 144, 108
        SetEntityFacing 76, 2
        SetEntityFacing 0, 3
        PlayAudio 50
  stock @083b9d16                        ; Krillin: are you feeling what I'm feeling? (the stock call, in person)
  stock @083b9d4e
  stock @083b9d94
  stock @083b9ddc
  stock @083b9e30
  stock @083b9ec0                        ; Gohan: first I need my Saiyan Battle Armor, hidden in a cave
  stock @083b9f2c
  text 73 "KRILLIN: I'll come with you.  With Frieza around, two of us are safer than one."
  text 1 "#Thanks, Krillin!  The cave is in the forest, just past our house."
  script
        SetCharacterInPartyFlag 6
        SetCharacterFlag_Bit1 6
        RemoveItem 37
        SetStoryFlag 11
        SetStoryFlag 360
        PlayAudio 62
  text 0 "@^Krillin is now available!"
  stock @083b9f82                        ; Journal Updated!
  script                                 ; Gohan gets up from the desk (the stock sit puts him inside its collision)
        SetEntityPositionInstant 0, 136, 104
        WalkToPosition 0, 136, 120
        BeginCommandBatch
        WalkToPosition 76, 160, 120
        WalkToPosition 0, 152, 132
        CommitCommandBatch
        CoopCall 5, 0, 0, 0                   ; two players: he ends where player 2's entity appears (12 px left of player 1)
        JumpIfFalse K1
        WalkToPosition 76, 140, 132
        Jump K2
      K1:
        WalkToPosition 76, 216, 148
      K2:
        DespawnEntity 76
        SetPlayerVisible 1
end

