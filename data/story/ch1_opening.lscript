; Chapter 1, the opening (docs/story.md section 0 item 1), applied by ch1_opening.json:
;  - future prologue: old Hercule is player 2 beside Trunks (party slot 5), comic relief, no hint of
;    what he becomes; he leaves with Trunks at the end of the Goku-arrival scene;
;  - present day: Krillin visits Gohan instead of phoning and joins (slot 6, player 2);
;  - the forest "spirit" (Frieza + Cooler, the stock dream's clearing zone 2 area 8) replaces the dream;
;  - Krillin's NPC is gone from the Frieza landing site (zone 3 areas 4 and 6).
; Speakers: 1 Gohan/Trunks box, 3 Piccolo, 44 Cooler, 49 Frieza, 57 Future Gohan, 67 Hercule, 126 old Hercule (Buu's Fury portrait),
; 73 Krillin, 98 Trunks. Sprites: 48 Frieza (dream), 34 Cooler, 76 Krillin, 128 Trunks, 158 old Hercule.
; Story flags of this chapter: 360 = Krillin has visited.

; ---- future prologue ----------------------------------------------------------------------------

; map 0 (zone 1 area 1) trigger 0: Future Gohan's training, with old Hercule hanging back
sequence ch1_training
  text 0 "@^Choose the difficulty.  It can't be changed later."    ; [0] (src/coop/difficulty.h, flags 460 / 461)
  script                                 ; [1] a yes / no question (CoopCall 18: A yes, B no)
        CoopCall 18, 1, 0, 0
  text 0 "@^Play on Normal?  (A: Yes  B: No)"
  script                                 ; [3] yes: Normal (no flag); no: the next question
        CoopCall 18, 0, 0, 0
        PushByte 1
        CmpEq
        JumpIfFalse L1
        PushByte 9
        END
      L1:
        PushByte 4
        END
  script                                 ; [4]
        CoopCall 18, 1, 0, 0
  text 0 "@^Easy or Hard?  (A: Easy  B: Hard)"
  script                                 ; [6]
        CoopCall 18, 0, 0, 0
        PushByte 1
        CmpEq
        JumpIfFalse L1
        SetStoryFlag 460
        PushByte 7
        END
      L1:
        SetStoryFlag 461
        PushByte 8
        END
  text 0 "@^Easy difficulty." -> 10
  text 0 "@^Hard difficulty." -> 10
  text 0 "@^Normal difficulty."
  stockseq @083b6ec8 0 5                 ; Trunks' doubts, Gohan's answer, "I won't let you down"
  text 126 "#HERCULE: And don't you boys worry about me!\x0bI'll be guarding the rear.  From way back here."
  stockseq @083b6ec8 6 7                 ; Gohan: the melee practice, destroy that boulder
  text 126 "#A boulder?  Ha!  I've chopped bigger rocks than that in my sleep!\x0b...You go first, kid."
  stockseq @083b6ec8 8                   ; Gohan walks off, control back
end

; map 1 (zone 1 area 2) trigger 0: Gohan's death and the jump to the present
sequence ch1_future_end
  stockseq @083b7adc 0 3                 ; the androids' attack, Trunks finds Gohan
  text 126 "#T-Trunks...  They're gone.\x0bLet's get out of here before those two come back!"
  stockseq @083b7adc 4                   ; "Present day Earth...", Gohan's chapter begins
end

; ---- present day: Krillin visits ------------------------------------------------------------------

; map 19 (Gohan's room, zone 2 area 22) trigger 0 condition: math time, before Krillin's visit
script ch1_room_cond
    StackTestStoryFlag 4
    StackTestStoryFlagNot 360
    And
end

; map 19 trigger 0: no dozing off and no dream; Krillin walks in instead of phoning
sequence ch1_krillin_visit
  stock @083bb624                        ; Gohan sits down at his desk
  stock @083bb662                        ; "I guess I'll just do my math for a while..."
  script
        WaitFrames 40
        PlayAudio 10
        SpawnCharacterEntity 76, 216, 148
        WalkToPosition 76, 160, 120
        WalkToPosition 76, 144, 108
        SetEntityFacing 76, 2
        SetEntityFacing 0, 3
        PlayAudio 50
  stock @083b9d16                        ; Krillin: are you feeling what I'm feeling? (the stock call, in person)
  stock @083b9d4e
  stock @083b9d94
  stock @083b9ddc
  stock @083b9e30
  stock @083b9ec0                        ; Gohan: first I need my Saiyan Battle Armor, hidden in a cave
  stock @083b9f2c
  text 73 "KRILLIN: I'll come with you.  With Frieza around, two of us are safer than one."
  text 1 "#Thanks, Krillin!  The cave is in the forest, just past our house."
  script
        DespawnEntity 76
        SetCharacterInPartyFlag 6
        SetCharacterFlag_Bit1 6
        RemoveItem 37
        SetStoryFlag 11
        SetStoryFlag 360
        PlayAudio 62
  text 0 "@^Krillin is now available!"
  stock @083b9f82                        ; Journal Updated!
  script                                 ; Gohan gets up from the desk (the stock sit puts him inside its collision)
        SpawnCharacterEntity 76, 144, 108
        SetEntityFacing 76, 2
        SetEntityPositionInstant 0, 136, 104
        WalkToPosition 0, 136, 120
        BeginCommandBatch
        WalkToPosition 76, 160, 120
        WalkToPosition 0, 152, 132
        CommitCommandBatch
        WalkToPosition 76, 216, 148
        DespawnEntity 76
        SetPlayerVisible 1
end

; ---- the forest spirit (zone 2 area 8, map 14) ----------------------------------------------------

; trigger 0: on the way to the cave the forest goes quiet, Frieza and Cooler appear
sequence ch1_spirit
  script
        SetPlayerVisible 0
        WalkToPosition 0, 96, 176
        SetEntityFacing 0, 1
        PanCameraToPosition 0, 0, 2
        WaitFrames 40
        PlayAudio 50
  text 1 "#GOHAN: Krillin, wait...\x0bHuh?  The whole forest just went quiet."
  text 73 "KRILLIN: Gohan...  Do you feel that?  Something is here with us."
  script
        FadeToWhite 120
        TriggerMapEvent 1
        WhiteFadeOut 30
        WhiteFlash 40
  stock @083b952c                        ; Frieza: your dad isn't coming back!
  text 44 "COOLER: And when we are finished with you, Earth will learn what it means to cross our family."
  text 73 "KRILLIN: Frieza AND Cooler?!  This can't be happening!"
  stock @083b958c                        ; boss bar, battle music, control back
  script                                 ; the camera follows the player again (entry 0's pan kept it on the clearing's top)
        SetActiveEntity 0
end

; record 1 (Frieza, stat 41; Cooler is his pair, src/coop/bosses.c) defeat: the two fade and Gohan and
; Krillin are told it was the forest's spirit. They stay in the clearing: behind the white fade the scene
; moves to the real clearing (zone 2 area 3: the fight's area 8 has the same layout but no way out), which
; also clears both bodies
sequence ch1_spirit_end
  script
        WhiteFlash 5
        WaitFrames 40
        FindPlayerEntity
        AddEXP 20
        SetPlayerVisible 0
        SetStoryFlag 9
        FadeToWhite 120
        WarpToMapWithEntities 2, 3, 0, 96, 176
        WhiteFadeOut 120
        PlayAudio 50
  text 0 "@^The two figures melted away into the mist..."
  text 1 "#GOHAN: They're gone...  Were they even real?"
  text 0 "@^VOICE: Do not be afraid, children.  You did not fight Frieza and Cooler...\x0b...but the spirit of the forest, wearing the faces of your fears."
  text 73 "KRILLIN: The spirit of the forest?  Well, it sure hit like Frieza!"
  text 1 "#Never mind, Krillin.  Let's get my armor from the cave."
  script
        SetPlayerVisible 1
end

; ---- Frieza's landing (zone 3 area 4, map 52, trigger 0): Future Trunks with old Hercule ------------
; The stock scene restated around old Hercule (sprite 158, portrait 126): he arrives with Trunks, nobody but
; Trunks knows him, he knocks out one of Frieza's soldiers (66) himself, and leaves with Trunks. Krillin's
; actor stays out (Krillin is in the party by now). Entries 0, 15, 37, 48 and 52 are restated from the stock.
sequence ch1_frieza_landing
  script                                 ; stock 0 without Krillin's actor: the Z fighters gather (Gohan's actor when nobody plays him), Frieza and King Cold land
        SetPlayerVisible 0
        PlayMusic 14
        PlayAudioBlocking 30, 120
        WalkToPosition 0, 192, 136
        WalkToPosition 0, 192, 88
        SpawnCharacterEntity 137, 144, 202
        SpawnCharacterEntity 121, 176, 208
        SpawnCharacterEntity 32, 192, 216
        SpawnCharacterEntity 156, 216, 208
        SpawnCharacterEntity 107, 240, 224
        SpawnCharacterEntity 23, 240, 216
        SpawnCharacterEntity 103, 216, 232
        CoopCall 22, 1, 0, 0                  ; nobody plays Gohan: he walks in with the others (sprite 55)
        JumpIfFalse G1
        SpawnCharacterEntity 55, 248, 200
      G1:
        BeginCommandBatch
        WalkToPosition 137, 152, 112
        SetEntityFacing 137, 1
        WalkToPosition 121, 184, 104
        SetEntityFacing 121, 1
        WalkToPosition 32, 192, 120
        SetEntityFacing 32, 1
        CommitCommandBatch
        BeginCommandBatch
        WalkToPosition 156, 208, 104
        SetEntityFacing 156, 1
        SetEntityAnimation 121, 4
        WalkToPosition 107, 208, 120
        SetEntityFacing 107, 1
        CoopCall 22, 2, 55, 0
        JumpIfFalse G2
        WalkToPosition 55, 216, 112
        SetEntityFacing 55, 1
        SetEntityAnimation 55, 4
      G2:
        CommitCommandBatch
        BeginCommandBatch
        WalkToPosition 23, 224, 120
        SetEntityFacing 23, 1
        WalkToPosition 103, 272, 136
        SetEntityAnimation 137, 4
        SetEntityFacing 103, 1
        CommitCommandBatch
        WaitFrames 40
        SetEntityAnimation 23, 4
        LoadMapWithEntities 3, 5, 1, 8, 16
        RegisterScouterEntry 74
        RegisterScouterEntry 48
        BeginCommandBatch
        WalkToPosition 74, 72, 88
        WalkToPosition 49, 144, 96
        CommitCommandBatch
        WaitFrames 100
        PlayAudio 50
        END
  stockseq @083be798 1 14    ; Frieza and King Cold, the soldiers march out
  script                                 ; stock 15: Trunks appears, old Hercule with him
        PlayMusic 38
        WaitFrames 80
        FadeToWhite 10
        SpawnCharacterEntity 128, 120, 448
        SetEntityFacing 128, 1
        SpawnCharacterEntity 158, 92, 440
        SetEntityFacing 158, 1
        WhiteFadeOut 10
        WaitFrames 60
        END
  stockseq @083be798 16 16    ; "Not so fast!  You must be Frieza!"
  text 126 "OLD HERCULE: Yeah!  What he said!"
  text 70 "!We have guests!\x0b...And what is that thing with the hair?"
  stockseq @083be798 18 27    ; Trunks and Frieza, the Z fighters sense Trunks' power
  text 73 "!KRILLIN: And who's that old guy with the afro?\x0bHis power level is...  um...  barely there."
  stockseq @083be798 28 36    ; the Super Saiyan
  script                                 ; stock 37, first half: Trunks cuts down five soldiers; old Hercule knocks out the sixth
        SetEntityFacing 67, 0
        WaitFrames 15
        SetEntityFacing 70, 0
        WalkToPosition 134, 104, 432
        BeginCommandBatch
        SetEntityFacing 71, 2
        SetEntityAnimation 134, 6
        EntityWaitTouchPlayer 68
        PlaySFX 68, 34
        EntitySetVelocity 68, 0, 0
        PlayDamageEffect 68
        SetEntityAnimation 68, 2
        DespawnEntity 68
        CommitCommandBatch
        BeginCommandBatch
        WalkToPosition 134, 120, 424
        SetEntityFacing 134, 1
        WalkToPosition 71, 136, 424
        SetEntityAnimation 134, 7
        EntityWaitTouchPlayer 71
        PlaySFX 71, 35
        EntitySetVelocity 71, 0, 0
        PlayDamageEffect 71
        SetEntityAnimation 71, 2
        DespawnEntity 71
        WalkToPosition 70, 136, 416
        SetEntityAnimation 134, 6
        EntityWaitTouchPlayer 70
        PlaySFX 70, 36
        EntitySetVelocity 70, 0, 0
        PlayDamageEffect 70
        SetEntityAnimation 70, 2
        DespawnEntity 70
        NPCFireKiBlastAtEntity 134, 67, 100
        EntityWaitTouchPlayer 67
        PlaySFX 67, 36
        EntitySetVelocity 67, 0, 0
        PlayDamageEffect 67
        SetEntityAnimation 67, 2
        DespawnEntity 67
        CommitCommandBatch
        BeginCommandBatch
        WalkToPosition 69, 136, 392
        NPCFireKiBlastAtEntity 134, 69, 100
        EntityWaitTouchPlayer 69
        PlaySFX 69, 35
        EntitySetVelocity 69, 0, 0
        PlayDamageEffect 69
        SetEntityAnimation 69, 2
        DespawnEntity 69
        CommitCommandBatch
        SetEntityFacing 158, 1
        WalkToPosition 66, 96, 432
        SetEntityFacing 66, 0
        WaitFrames 20
        SetEntityAnimation 158, 6
        PlaySFX 66, 34
        EntitySetVelocity 66, 0, 0
        PlayDamageEffect 66
        SetEntityAnimation 66, 2
        WaitFrames 30
        DespawnEntity 66
        SetEntityAnimation 158, 0
  text 126 "OLD HERCULE: Ha!  Did you see that, Trunks?\x0bOne punch!  That's the power of the World Champion!"
  text 98 "TRUNKS: ...Stay behind me, Hercule."
  script                                 ; stock 37, second half: Frieza
        WaitFrames 120
        WalkToPosition 134, 120, 384
        BeginCommandBatch
        SetEntityAnimation 134, 16
        EntityWaitTouchPlayer 49
        PlaySFX 49, 59
        PlayDamageEffect 49
        FlashScreenColor 49, 255, 0, 0, 10
        CommitCommandBatch
        WalkToPosition 134, 160, 424
        SetEntityFacing 134, 1
        END
  stockseq @083be798 38 47    ; Frieza falls, King Cold's offer, King Cold falls
  script                                 ; stock 48 without Krillin's actor: Trunks flies to the landing site; old Hercule runs up; Gohan's actor when nobody plays him
        SetStoryFlag 21
        WarpToMapWithEntities 3, 4, 1, 192, 88
        SetActiveEntity 0
        CoopCall 22, 1, 0, 0                  ; Gohan with the others (Krillin's spot)
        JumpIfFalse G1
        SpawnCharacterEntity 55, 208, 112
        SetEntityFacing 55, 0
      G1:
        SetEntityFacing 103, 0
        WaitFrames 15
        WaitFrames 10
        SetEntityFacing 23, 0
        SetEntityFacing 121, 0
        WaitFrames 5
        SetEntityFacing 156, 0
        WaitFrames 10
        SetEntityFacing 0, 0
        SpawnCharacterEntity 128, 80, 288
        SetEntityFollow 107, 128
        SetEntityFollow 32, 128
        SetEntityFollow 103, 128
        SetEntityFollow 137, 128
        SetEntityFollow 121, 128
        SetEntityFollow 23, 128
        SetEntityFollow 156, 128
        CoopCall 22, 2, 55, 0
        JumpIfFalse G2
        SetEntityFollow 55, 128
      G2:
        PanCameraToPosition 8, 96, 2
        FlyToPosition 128, 88, 200
        FlyToPosition 128, 136, 184
        SetActiveEntity 128
        WalkToPosition 128, 192, 136
        SpawnCharacterEntity 158, 364, 248             ; old Hercule runs up the path from below, off screen
        WalkToPosition 158, 300, 200
        WalkToPosition 158, 168, 152
        SetEntityFollow 158, 128
        WaitFrames 30
        PlayAudio 50
        END
  text 126 "OLD HERCULE: *huff*  *huff*\x0bTrunks...  wait up...  I can't fly, remember?"
  text 73 "!KRILLIN: Uh...  who's your friend?"
  text 126 "OLD HERCULE: Friend?  I'm his bodyguard!"
  text 98 "TRUNKS: He's...  with me.  Don't worry about him."
  stockseq @083be798 49 51    ; "I'm heading off to meet Goku", "Just follow me."
  script                                 ; stock 52: Trunks flies off, old Hercule runs after him
        PlayAudio 47
        FindCharacterEntity 0
        SetStoryFlag 22
        ClearStoryFlag 21
        WalkToPosition 128, 128, 160
        WaitFrames 20
        PlayAudio 26
        PushMulti 128, 24
        Negate
        FlyToPosition 192
        DespawnEntity 128
        WalkToPosition 158, 300, 200             ; old Hercule runs off down the path he came by
        WalkToPosition 158, 364, 248
        DespawnEntity 158
        CoopCall 22, 2, 55, 0
        JumpIfFalse G1
        DespawnEntity 55
      G1:
        SetActiveEntity 0
        ReloadMap
        SetPlayerVisible 1
        END
end

; ---- the Goku-arrival scene (zone 3 area 6, map 54): old Hercule travels with Trunks and leaves with him --------------

sequence ch1_trunks_talk
  stockseq @083bfddc 0 77                ; the whole stock conversation up to Trunks' secret
  script                                 ; old Hercule comes out from the crater's rim to Trunks
        WalkToPosition 158, 552, 272
        SetEntityFollow 158, 128
  text 126 "#HERCULE: Psst!  Trunks!  Is it safe to come out now?\x0bThat Frieza fellow isn't coming back, is he?"
  text 98 "#He's gone for good, Hercule.  Come on, it's time we went home."
  stockseq @083bfddc 78                  ; everyone gathers, the warning retold, home
end
