; Chapter 6 before the Time Chamber (docs/story.md section 0 item 6, section 4e "After the fight"),
; applied by ch6_basement.json. Trunks and Krillin are the locked pair for Dr. Gero's lab basement:
; player 1 Trunks, player 2 Krillin (Gingertown's end, ch5_lookout, locks them). The stock Krillin NPC that walked
; beside Trunks is gone (his lines are his only when he is played). At Kame House Piccolo is a scene actor (his selectable
; bit stays clear after the lab), Goku wakes as stock, and Krillin stays home when Trunks flies to the Lookout.
; Only who is played is in a scene (Ryan, 2026-11-05; docs/howto.md "Stage a scene" rule 2): alone as Trunks no Krillin (no NPC walk,
; no actor at the lab's exit), alone as Krillin no Trunks; with two players both are the players. Krillin's stock lines play only
; when someone plays him; the exchange at the computer only with both; his "We better get out" and "head back to Roshi's" go to
; player 1 (speaker 1) without his name when he is not there (drafts). CoopCall 22 op 4: 1 = played.

; ---- zone 8 area 61: the plans room -------------------------------------------------------------

sequence ch6_basement_enter
  script
        SetStoryFlag 137
end

; ---- zone 8 area 62: Cell's larva ----------------------------------------------------------------

sequence ch6_larva
  [0] script                             ; stock entry 0 without Krillin's NPC
        SetPlayerVisible 0
        WalkToPosition 0, 128, 208
        PanCameraToPosition 16, 80, 2
        PlayAudio 50
  [1] stockseq @083db220 1 1             ; "%s: This has to be Cell in his larval form."
  [2] script                             ; Krillin played: "even mine!" (next 3), else 4
        CoopCall 22, 4, 6, 0
        JumpIfFalse a
        PushByte 3
        END
      a:
        PushByte 4
        END
  [3] stock @083db0d8                    ; Krillin: "It has Goku's cells... and even mine!"
  [4] stock @083db14c                    ; "I better destroy it"
  [5] script                             ; stock entry 4: player 1's blast, area 64
        BeginCommandBatch
        NPCFireKiBlast 0, 136, 144, 100
        SpawnDustCloud 0, 136, 144
        CommitCommandBatch
        PlayAudio 20
        FadeToWhite 10
        WarpToMapNoEntities 8, 64, 1, 128, 208
        PanCameraToPosition 16, 80, 10
        SetEntityFacing 0, 1
        WhiteFadeOut 20
  [6] stockseq @083db220 5 6             ; "Now let's go find Dr. Gero's master computer.", flag 138
end

; ---- zone 8 area 63: the master computer and the self-destruct -----------------------------------

sequence ch6_computer
  [0] script                             ; stock entry 0 without Krillin's NPC
        WalkToPosition 0, 216, 256
        PanCameraToPosition 64, 96, 2
        PlayAudio 50
  [1] stockseq @083db43c 1 1             ; "%s: This must be Dr. Gero's master computer."
  [2] script                             ; both played: Krillin's question and the plan (next 3), else the blast (6)
        CoopCall 22, 4, 3, 0
        CoopCall 22, 4, 6, 0
        And
        JumpIfFalse a
        PushByte 3
        END
      a:
        PushByte 6
        END
  [3] stock @083db2ac                    ; Krillin: "You mean this is the thing that created Cell?"
  [4] stock @083db2e8                    ; "Yeah."
  [5] stock @083db2f4                    ; Krillin: "Why don't we blast it?"
  [6] script                             ; stock entry 5: flags 139, 140, player 1's blast, area 65
        SetStoryFlag 139
        SetStoryFlag 140
        BeginCommandBatch
        NPCFireKiBlast 0, 184, 192, 100
        SpawnDustCloud 0, 184, 192
        CommitCommandBatch
        PlayAudio 20
        FadeToWhite 10
        WarpToMapNoEntities 8, 65, 1, 216, 256
        SetEntityFacing 0, 1
        WhiteFadeOut 20
  [7] stock @083db374                    ; WARNING!  SELF-DESTRUCT
  [8] script                             ; stock entry 7; Krillin played: his line (next 9), else player 1's (10)
        PlayAudioBlocking 20, 80
        CoopCall 22, 4, 6, 0
        JumpIfFalse a
        PushByte 9
        END
      a:
        PushByte 10
        END
  [9] stock @083db3c0 -> 11              ; Krillin: "We better get out of here!"
  [10] text 1 "Destroying the computer set off some sort of self-destruct!\x0bWe better get out of here!"
  [11] script                            ; stock entry 9
        SetActiveEntity 0
end

; ---- zone 8 area 48: out of the lab, "head back to Master Roshi's Island" -------------------------

; the stock actor 76 stood here after the blast (flag 140, not 141): never now (nobody plays him: he is not there; played, he is a player)
script ch6_a48_krillin_cond
        PushByte 0
end

sequence ch6_lab_exit
  [0] script                             ; stock entry 0, without Krillin's actor; Krillin played: his line (next 1), else player 1's (2)
        SetPlayerVisible 0
        WalkToPosition 0, 152, 304
        SetEntityFacing 0, 1
        PlayAudioBlocking 30, 120
        PlayAudio 20
        FindCharacterEntity 10
        ClearCollisionRect 128, 272, 192, 296
        PlayAudioBlocking 50, 60
        WaitFrames 60
        SetEntityFacing 0, 3
        WaitFrames 60
        PlayAudio 50
        CoopCall 22, 4, 6, 0
        JumpIfFalse a
        PushByte 1
        END
      a:
        PushByte 2
        END
  [1] stock @083d86bc -> 3               ; Krillin: "head back to Master Roshi's Island?"
  [2] text 1 "Let's head back to Master Roshi's Island.\x0bMaybe Goku is getting better."
  [3] script                             ; stock entry 2
        WaitFrames 60
        SetStoryFlag 141
        PlayAudio 62
        ReloadMap
  [4] stock @083d8758                    ; Journal Updated!
  [5] script                             ; stock entry 4, without Piccolo's selectable bit (a scene actor
        PanCameraToPosition 80, 368, 3   ; at Kame House; the Time Chamber's end makes him player 1)
        WaitFrames 120
        PlayAudio 47
        EnableLayer 1
        FindCharacterEntity 2
        ClearCollisionRect 192, 456, 208, 464
        WaitFrames 180
        SetActiveEntity 0
        SetPlayerVisible 1
end

; ---- zone 11 area 3: Goku wakes; Krillin stays at Kame House --------------------------------------
; Trunks stays in this stock scene alone as Krillin: Goku takes him to the Lookout (the plot); Krillin's line only when he is played

sequence ch6_goku_wakes
  [0] stockseq @083e42f4 0 36            ; Piccolo and Chi-Chi, Goku wakes, "Kamiccolo", "Meet me at Kami's Lookout."
  [37] script                            ; Krillin played: he stays (next 38), else 39
        CoopCall 22, 4, 6, 0
        JumpIfFalse a
        PushByte 38
        END
      a:
        PushByte 39
        END
  [38] text 73 "!KRILLIN: I'll stay here and keep an eye on things, Trunks.\x0bIf the Androids show up, somebody has to warn everybody!"
  [39] script                            ; stock entry 37, with Krillin's selectable bit cleared
        WalkToPosition 60, 88, 152
        SetEntityFacing 60, 2
        WaitFrames 60
        PlayAudio 26
        FlyToPosition 60, 0, 135
        DespawnEntity 60
        SetStoryFlag 143
        ClearCharacterFlag_Bit1 6
        FadeOut 30
        PushActiveCharIndex                   ; alone as Krillin, who stays home: Trunks flies on (in the fade)
        PushByte 6
        CmpEq
        JumpIfFalse K9
        SetActiveCharacter 3
      K9:
        WarpToMapNoEntities 11, 1, 1, 528, 400
        PanCameraToPosition 440, 160, 20
        SetBgLayerPriority 0, 3
        FadeFromWhite 30
        SpawnCharacterEntity 60, 568, 232
        SetActiveEntity 60
        BeginCommandBatch
        PushMulti 60, 32
        Negate
        FlyToPosition 216
        WalkToPosition 0, 512, 336
        WalkToPosition 0, 432, 312
        SetEntityFacing 0, 2
        CommitCommandBatch
        SetActiveEntity 0
        SetPlayerVisible 1
        SetBgLayerPriority 0, 1
        PlayAudio 62
  [40] stock @083e42dc                   ; Journal Updated!
end
