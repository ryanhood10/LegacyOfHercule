        WhiteFlash 10
        PlayAudio 26
        SpawnCharacterEntity 29, 216, 272
        WalkToPosition 29, 240, 272
        SetEntityFacing 29, 2
        WaitFrames 30
  [17] text 99 "TRUNKS: Father, he's split in two!\x0bThat's the trick Piccolo told us about at Gingertown!"
  [18] text 4 "VEGETA: Hmph.  Then I'll destroy both halves."
  [19] script                            ; the body that walked goes (a step finds the same one first); the record stands on the other and its twin on this spot
        DespawnEntity 29
  [20] script                            ; stock 083e6608, the fight (25-100), with the camera given back to player 1
        SetActiveEntity 0
        DespawnCharacterAndRecordPosition 29, 1
        SetPlayerVisible 1
        DrawBossHealthBarRange 29, 25, 100
end

; Semi-Perfect Cell beaten: the duplicate is taken back in co-op; Cell talks Vegeta into letting him
