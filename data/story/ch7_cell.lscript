  [5] text 73 "KRILLIN: Ugh...  One hit...  He took me out with one hit..."
  stockseq @083e77b0 1 13                ; "pump up your muscles", the tournament in ten days, Cell leaves
  script                                 ; stock entry 14, with Krillin on his feet and Vegeta up from where he fell; then Trunks + Krillin
        SetEntityAnimation 76, 0         ; by default with Vegeta, Piccolo and Hercule selectable too
        SetEntityFacing 76, 1
