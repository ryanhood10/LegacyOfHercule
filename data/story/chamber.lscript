; The Hyperbolic Time Chamber as a game mode (docs/time-chamber.md; state of the build and how to add a room: section 12; Ryan's
; first play and what changed for it: section 13). Shared by the open area (data/maps/chamber_open.json), every room's map
; (data/maps/chamber_dojo.json is the pattern) and the side rooms (chamber_saiyan_bed / _store / _lounge, chamber_frieza_crystal / _control); the rows
; and the rooms' lines are in src/coop/chamber.c. CoopCall 35's op numbers are chamber.c's enum.
; Every line here is Claude's draft (DRAFT), not dictated.

; ---- the open area --------------------------------------------------------------------------------------------------

; the gate as stock zone 8 area 16 has it, with six flags, one light each: decorations 0-5 the lights, 6-8 the beams; all six
; out: the beams gone, the way open, the portal between the pillars lit (decorations 25 / 26, chamber.c shows them in turn).
; CoopCall 35, 23 hands chamber.c the open area's scenes (the opening of a run, the door home's question, the training's end)
script ch_open_onload
        CoopCall 35, 23, seq:ch_open_scenes, 0
        PlayAudioVolume 17, 40
        StackTestStoryFlag 504
        JumpIfFalse L1
        FindEntityByType 0
      L1:
        StackTestStoryFlag 505
        JumpIfFalse L2
        FindEntityByType 1
      L2:
        StackTestStoryFlag 506
        JumpIfFalse L3
        FindEntityByType 2
      L3:
        StackTestStoryFlag 507
        JumpIfFalse L4
        FindEntityByType 3
      L4:
        StackTestStoryFlag 508
        JumpIfFalse L5
        FindEntityByType 4
      L5:
        StackTestStoryFlag 509
        JumpIfFalse L6
        FindEntityByType 5
      L6:
        CoopCall 35, 15, 0, 0
        JumpIfFalse L7
        StopAudio 17
        FindEntityByType 6
        FindEntityByType 7
        FindEntityByType 8
        SetCollisionRect 1008, 320, 1048, 400
        CoopCall 35, 39, 1, 0
      L7:
end

script ch_open_onleave
        StopAudio 17
end

; a jar's drop and a regular enemy's: both read both players' bars (chamber.c drop_item)
script ch_jar_drop
        CoopCall 35, 17, 0, 0
end

script ch_enemy_drop
        CoopCall 35, 18, 0, 0
end

; the portal between the gate's pillars (its rect is blocked until all six lights are out): chamber.c queues the warp, a flash, its
; sound, the hidden room (Mr. Popo's, popo.c; ch_open_scenes 42). A warp inside this trigger's own fire broke the trigger scan
; (an "enter" box is taken off the list after its fire, and the load had reset the list: a crash)
script ch_portal
        CoopCall 35, 53, 0, 0
end

; ---- the open area's scenes (docs/time-chamber.md 13, Ryan's first play) ---------------------------------------------
; One sequence for the open area's three scenes; chamber.c starts it (coop2's action object) once player 1 is free and entry 0
; asks where: the opening of a run (1), the questions at the door home (28), the training's end (36), the portal (42). The opening is skipped
; with Start or B (chamber.c sets the skip; every entry's end and every 24 frames of a pan ask CH_GOING / CH_GO): out of the
; rooms' views through RestoreMap (22), else to the end (26). Absolute indexes (chamber.c's E_*): keep the `[n]` checks.
; Lines: DRAFT, Mr. Popo's voice (portrait 82, his third-person way of talking); he is not seen here.
sequence ch_open_scenes
  [0] script                             ; -> the queued scene's first entry
        CoopCall 35, 24, 0, 0
        END
  [1] script                             ; the run begins: the void's bodies leave, the players look round
        CoopCall 35, 25, 0, 0
        WaitFrames 20
        CoopCall 35, 26, 2, 0
        WaitFrames 18
        CoopCall 35, 26, 3, 0
        WaitFrames 18
        CoopCall 35, 26, 1, 0
        WaitFrames 12
        CoopCall 35, 27, 2, 26
        END
  [2] text 82 "MR. POPO: The chamber is ready.\x0bSix rooms stand in this white. Popo will show you."
  [3] script                             ; the pan to the next entrance
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        PanCameraToPosition 1496, 1624, 12
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 10
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        CoopCall 35, 27, 4, 26
        END
      S:
        PushByte 26
        END
  [4] text 82 "MR. POPO: Master Roshi's dojo."
  [5] script                             ; the pan to the next entrance
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        PanCameraToPosition 1688, 1016, 12
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 10
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        CoopCall 35, 27, 6, 26
        END
      S:
        PushByte 26
        END
  [6] text 82 "MR. POPO: The pirates' airship.\x0bGeneral Tao and his men."
  [7] script                             ; the pan to the next entrance
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        PanCameraToPosition 1496, 440, 12
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 8
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        CoopCall 35, 27, 8, 26
        END
      S:
        PushByte 26
        END
  [8] text 82 "MR. POPO: Frieza's ship."
  [9] script                             ; the pan to the next entrance
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        PanCameraToPosition 312, 440, 12
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 10
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        CoopCall 35, 27, 10, 26
        END
      S:
        PushByte 26
        END
  [10] text 82 "MR. POPO: The Namekian ship."
  [11] script                             ; the pan to the next entrance
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        PanCameraToPosition 120, 1016, 12
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 8
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        CoopCall 35, 27, 12, 26
        END
      S:
        PushByte 26
        END
  [12] text 82 "MR. POPO: The Saiyan ship."
  [13] script                             ; the pan to the next entrance
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        PanCameraToPosition 312, 1624, 12
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 10
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        CoopCall 35, 27, 14, 26
        END
      S:
        PushByte 26
        END
  [14] text 82 "MR. POPO: Dr. Gero's lab."
  [15] text 82 "MR. POPO: In every room a fighter waits,\x0band on the wall beside him, a lever. Lit."
  [16] script                            ; inside room 0: the lit plaque, then the boss at the far end
        SetMapRestoreFlag
        PushByte 15
        CoopCall 35, 31, 0, 0
        PushByte 1
        CoopCall 35, 29, 0, 0
        CoopCall 35, 30, 0, 0
        Step LoadMapNoEntities
        CoopCall 35, 28, 0, 0
        WaitFrames 24
        CoopCall 35, 29, 0, 1
        CoopCall 35, 30, 0, 1
        PushByte 2
        Step PanCameraToPosition
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        CoopCall 35, 27, 17, 22
        END
      S:
        PushByte 22
        END
  [17] script                            ; inside room 1: the lit plaque, then the boss at the far end
        PushByte 15
        CoopCall 35, 31, 1, 0
        PushByte 1
        CoopCall 35, 29, 1, 0
        CoopCall 35, 30, 1, 0
        Step LoadMapNoEntities
        CoopCall 35, 28, 1, 0
        WaitFrames 24
        CoopCall 35, 29, 1, 1
        CoopCall 35, 30, 1, 1
        PushByte 2
        Step PanCameraToPosition
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        CoopCall 35, 27, 18, 22
        END
      S:
        PushByte 22
        END
  [18] script                            ; inside room 2: the lit plaque, then the boss at the far end
        PushByte 15
        CoopCall 35, 31, 2, 0
        PushByte 1
        CoopCall 35, 29, 2, 0
        CoopCall 35, 30, 2, 0
        Step LoadMapNoEntities
        CoopCall 35, 28, 2, 0
        WaitFrames 24
        CoopCall 35, 29, 2, 1
        CoopCall 35, 30, 2, 1
        PushByte 2
        Step PanCameraToPosition
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        CoopCall 35, 27, 19, 22
        END
      S:
        PushByte 22
        END
  [19] script                            ; inside room 3: the lit plaque, then the boss at the far end
        PushByte 15
        CoopCall 35, 31, 3, 0
        PushByte 1
        CoopCall 35, 29, 3, 0
        CoopCall 35, 30, 3, 0
        Step LoadMapNoEntities
        CoopCall 35, 28, 3, 0
        WaitFrames 24
        CoopCall 35, 29, 3, 1
        CoopCall 35, 30, 3, 1
        PushByte 2
        Step PanCameraToPosition
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        CoopCall 35, 27, 20, 22
        END
      S:
        PushByte 22
        END
  [20] script                            ; inside room 5: the lit plaque, then the boss at the far end
        PushByte 15
        CoopCall 35, 31, 5, 0
        PushByte 1
        CoopCall 35, 29, 5, 0
        CoopCall 35, 30, 5, 0
        Step LoadMapNoEntities
        CoopCall 35, 28, 5, 0
        WaitFrames 24
        CoopCall 35, 29, 5, 1
        CoopCall 35, 30, 5, 1
        PushByte 2
