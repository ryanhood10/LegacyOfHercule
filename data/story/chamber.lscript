        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        CoopCall 35, 27, 21, 22
        END
      S:
        PushByte 22
        END
  [21] script                            ; inside room 4: the lit plaque, then the boss at the far end
        PushByte 15
        CoopCall 35, 31, 4, 0
        PushByte 1
        CoopCall 35, 29, 4, 0
        CoopCall 35, 30, 4, 0
        Step LoadMapNoEntities
        CoopCall 35, 28, 4, 0
        WaitFrames 24
        CoopCall 35, 29, 4, 1
        CoopCall 35, 30, 4, 1
        PushByte 2
        Step PanCameraToPosition
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        CoopCall 35, 27, 22, 22
        END
      S:
        PushByte 22
        END
  [22] script                            ; back to the open area (from any room's view)
        RestoreMap
        WaitFrames 10
        CoopCall 35, 27, 23, 26
        END
  [23] script                            ; from the quarters up the red carpet to the gate in its wall
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        PanCameraToPosition 908, 920, 12
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 18
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        PanCameraToPosition 908, 280, 12
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 24
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        WaitFrames 13
        CoopCall 35, 32, 0, 0
        JumpIfFalse S
        CoopCall 35, 27, 24, 26
        END
      S:
        PushByte 26
        END
  [24] text 82 "MR. POPO: Each lever puts out one light on Popo's gate.\x0bSix lights out, and the gate opens."
  [25] text 82 "MR. POPO: Defeat the six. Switch off their six levers.\x0bThen walk into the gate. Follow the red carpet."
  [26] script                            ; the end (and the skip's): the camera back on player 1
        FadeToWhite 16
        SetActiveEntity 0
        WaitFrames 6
        WhiteFadeOut 16
        CoopCall 35, 33, 0, 0
  [27] stop 0x0
  [28] script                            ; the door home: the players face it; -> 29 the question, 34 out at once (the training done)
        CoopCall 35, 34, 0, 0
        WaitFrames 12
        CoopCall 35, 35, 0, 0
        END
  [29] script
        CoopCall 18, 1, 0, 0
  [30] text 0 "@^Leave the Time Chamber?\x0a(A: Yes  B: No)" -> 33
  [31] script                            ; mid-run, after a yes: Ryan's own question (a held A from the first does not answer it)
        CoopCall 18, 1, 0, 0
  [32] text 0 "@^Are you sure?\x0aYou will lose all progress.\x0a(A: Yes  B: No)" -> 33
  [33] script                            ; yes: the second question (mid-run) or out; no: a step back from the door
        CoopCall 18, 0, 0, 0
        PushByte 1
        CmpEq
        JumpIfFalse L1
        CoopCall 35, 35, 1, 0
        END
      L1:
        BeginCommandBatch
        CoopCall 35, 36, 0, 0
        CommitCommandBatch
        CoopCall 35, 33, 0, 0
        PushByte 35
        END
  [34] script                            ; out: the run's lights on again (first wins and Popo's rounds stay), the Lookout
        CoopCall 35, 37, 0, 0
        CoopCall 35, 33, 0, 0
        PlayAudio 10
        FadeOut 60
        WaitFrames 20
        WarpToMapWithEntities 9, 3, 1, 96, 168
        FadeFromWhite 60
  [35] stop 0x0
  [36] script                            ; back from Popo's room, the training complete: the way home shown
        CoopCall 35, 38, 0, 0
        WaitFrames 20
  [37] text 0 "@^Training complete!"
  [38] script                            ; down the carpet from the gate to the quarters' door
        PanCameraToPosition 896, 1160, 12
        WaitFrames 24
        WaitFrames 24
        WaitFrames 24
        WaitFrames 4
  [39] text 82 "MR. POPO: Popo's training is complete. The chamber is quiet.\x0bThe door home is open. Follow the red carpet."
  [40] script
        FadeToWhite 16
        SetActiveEntity 0
        WaitFrames 6
        WhiteFadeOut 16
        CoopCall 35, 33, 0, 0
  [41] stop 0x0
  [42] script                            ; the portal: a flash, its sound, the hidden room (another part of the chamber)
        PlayAudio 26
        WhiteFlash 8
        WaitFrames 10
        FadeToWhite 24
        CoopCall 35, 33, 0, 0
        WarpToMapWithEntities 15, 25, 1, 244, 340
        WhiteFadeOut 30
  [43] stop 0x0
end

; ---- a room ---------------------------------------------------------------------------------------------------------

; the plaque starts ON (lit: decoration 0) and the player switches it OFF (Ryan, 2026-11-05); once thrown, a side room's
; doorways are open (Broly's ship, Frieza's throne room: chamber.c ChRoom.ways)
script ch_room_onload
        CoopCall 35, 1, 0, 0
        JumpIfFalse L1
        CoopCall 35, 46, 0, 0
        Jump L2
      L1:
        FindCharacterEntity 0
      L2:
end

script ch_boss_cond
        CoopCall 35, 2, 0, 0
end

script ch_partner_cond
        CoopCall 35, 3, 0, 0
end

; walking in: the scene is built in C (tny_talk_scene): ch_room_parts [0], the lines of the room's row and each player's reply,
; ch_room_parts [1]
sequence ch_room_intro
  script
        CoopCall 35, 4, seq:ch_room_parts, seq:ch_crew_parts
end

; indexes: [0] -> 1 is the first line; [1] -> 6 is the scene's stop word (tny_talk_scene)
sequence ch_room_parts
  script -> 1
        CoopCall 35, 5, 0, 0
        BeginCommandBatch
        CoopCall 35, 6, 0, 0
        CoopCall 35, 7, 0, 0
        CoopCall 35, 8, 0, 0
        Step WalkToPosition
        CoopCall 35, 9, 0, 0
        JumpIfFalse L1
        CoopCall 35, 10, 0, 0
        CoopCall 35, 11, 0, 0
        CoopCall 35, 12, 0, 0
        Step WalkToPosition
      L1:
        CommitCommandBatch
        WaitFrames 15
  script -> 6
        PlayAudio 47
        ScreenShake 0, 2, 12
        CoopCall 35, 13, 0, 0
        WaitFrames 20
end

; a room with a crew first (the airship): the crew is down, the lead's line (built in C) as he steps up 24 px towards the
; players, then the fight; indexes as ch_room_parts
sequence ch_crew_parts
  script -> 1
        BeginCommandBatch
        CoopCall 35, 6, 0, 0
        CoopCall 35, 21, 0, 0
        CoopCall 35, 22, 0, 0
        Step WalkToPosition
        CommitCommandBatch
        WaitFrames 10
  script -> 6
        ScreenShake 0, 2, 12
        CoopCall 35, 13, 0, 0
        WaitFrames 20
end

; the plaque: refused (the stock click) until the room's boss is down and its bodies gone, and once thrown. Both stop words are
; 0: a dialogue trigger starts its next run at the index its last stop word names, so a plain `stop` here made the second press
; start at the throw (entry 3) without asking CH_LEVER (found 2026-11-05: a click before the fight, then any press threw it).
; The throw (Ryan's first play, docs/time-chamber.md 13): the plaque goes OFF; the cut-away starts at this room's entrance on the
; open map and pans along the red carpet to the gate (chamber.c `way`), where the light goes out; the sixth also drops the
; beams, opens the portal and holds on it with a line; back in the room the door opens, then the prize in a box of its own
; (stock wording), then, once and only with Gohan in the party, Gohan's Super Saiyan in a box of its own (decision 6).
; Absolute indexes (chamber.c's E_PRIZE_SENZU .. E_LEVER_END): keep the `[n]` checks.
sequence ch_lever
  [0] script
        CoopCall 35, 14, 0, 0
        END
  [1] script
        PlayAudio 19
  [2] stop 0x0
  [3] script                             ; the throw: OFF; the open map at this room's entrance
        FindEntityByType 0
        PlayAudio 57
        WaitFrames 40
        SetMapRestoreFlag
        PushByte 15
        PushByte 18
        PushByte 1
        CoopCall 35, 40, 0, 0
        CoopCall 35, 41, 0, 0
        Step LoadMapNoEntities
        WaitFrames 30
  [4] script                             ; leg 0 of the way along the carpet (chamber.c `way`), else the gate
        CoopCall 35, 42, 0, 0
        JumpIfFalse G
        CoopCall 35, 43, 0, 0
        CoopCall 35, 44, 0, 0
        PushByte 8
        Step PanCameraToPosition
        CoopCall 35, 45, 0, 0
        Step WaitFrames
        PushByte 5
        END
      G:
        PushByte 11
        END
  [5] script                             ; leg 1 of the way along the carpet (chamber.c `way`), else the gate
        CoopCall 35, 42, 1, 0
        JumpIfFalse G
        CoopCall 35, 43, 1, 0
        CoopCall 35, 44, 1, 0
        PushByte 8
        Step PanCameraToPosition
        CoopCall 35, 45, 1, 0
        Step WaitFrames
        PushByte 6
        END
      G:
        PushByte 11
        END
  [6] script                             ; leg 2 of the way along the carpet (chamber.c `way`), else the gate
        CoopCall 35, 42, 2, 0
        JumpIfFalse G
        CoopCall 35, 43, 2, 0
        CoopCall 35, 44, 2, 0
        PushByte 8
        Step PanCameraToPosition
        CoopCall 35, 45, 2, 0
        Step WaitFrames
        PushByte 7
        END
      G:
        PushByte 11
        END
  [7] script                             ; leg 3 of the way along the carpet (chamber.c `way`), else the gate
        CoopCall 35, 42, 3, 0
        JumpIfFalse G
        CoopCall 35, 43, 3, 0
        CoopCall 35, 44, 3, 0
        PushByte 8
        Step PanCameraToPosition
        CoopCall 35, 45, 3, 0
        Step WaitFrames
        PushByte 8
        END
      G:
        PushByte 11
        END
  [8] script                             ; leg 4 of the way along the carpet (chamber.c `way`), else the gate
        CoopCall 35, 42, 4, 0
        JumpIfFalse G
        CoopCall 35, 43, 4, 0
        CoopCall 35, 44, 4, 0
        PushByte 8
        Step PanCameraToPosition
        CoopCall 35, 45, 4, 0
        Step WaitFrames
        PushByte 9
        END
      G:
        PushByte 11
        END
  [9] script                             ; leg 5 of the way along the carpet (chamber.c `way`), else the gate
        CoopCall 35, 42, 5, 0
        JumpIfFalse G
        CoopCall 35, 43, 5, 0
        CoopCall 35, 44, 5, 0
        PushByte 8
        Step PanCameraToPosition
        CoopCall 35, 45, 5, 0
        Step WaitFrames
        PushByte 10
        END
      G:
        PushByte 11
        END
  [10] script                             ; leg 6 of the way along the carpet (chamber.c `way`), else the gate
        CoopCall 35, 42, 6, 0
        JumpIfFalse G
        CoopCall 35, 43, 6, 0
        CoopCall 35, 44, 6, 0
        PushByte 8
        Step PanCameraToPosition
        CoopCall 35, 45, 6, 0
        Step WaitFrames
        PushByte 11
        END
      G:
        PushByte 11
        END
  [11] script                            ; at the gate: the light goes out; the sixth: the beams, the portal
        WaitFrames 30
        PlayAudio 47
        CoopCall 35, 16, 0, 0
        Step FindEntityByType
        WaitFrames 90
        CoopCall 35, 19, 0, 0
        CoopCall 35, 15, 0, 0
        JumpIfFalse L1
        FindEntityByType 6
        WaitFrames 25
        FindEntityByType 7
        WaitFrames 25
        FindEntityByType 8
        PlayAudio 47
        WaitFrames 80
        StopAudio 17
        PlayAudio 18
        WaitFrames 60
        CoopCall 35, 39, 1, 0                  ; the portal opens
        PlayAudio 26
        WhiteFlash 6
        WaitFrames 70
        PushByte 12
        END
      L1:
        PushByte 13
        END
  [12] text 82 "MR. POPO: Six lights are out. The gate is open.\x0bFollow the red carpet north, past the quarters, into the light." -> 13
  [13] script                            ; back in the room: the door opens; then the prize (if owed) with its box
        RestoreMap
        CoopCall 35, 20, 0, 0
        PlayAudio 47
        WaitFrames 30
        CoopCall 35, 47, 0, 0
        JumpIfFalse P1
        CoopCall 35, 48, 0, 0
        Step PickUpItem
        CoopCall 35, 49, 0, 0
        END
      P1:
        PushByte 18
        END
  [14] text 0 "@^You received a Senzu Bean!" -> 18
  [15] text 0 "@^You received a +3 Strength Capsule!" -> 18
  [16] text 0 "@^You received a +3 Power Capsule!" -> 18
  [17] text 0 "@^You received a +3 Endurance Capsule!" -> 18
  [18] script                            ; -> 19 Gohan's Super Saiyan now, 21 the end
        CoopCall 35, 50, 0, 0
        END
  [19] script
        SetStoryFlag 468
        SetCharacterTransformation 0, 56
        PlayAudio 62
        WaitFrames 20
  [20] text 0 "@^Gohan's training has paid off!\x0bGohan can now become a Super Saiyan!"
  [21] stop 0x0
end

; ---- the side rooms (Broly's ship: the bedroom 15/27, the store room 15/28; Frieza's throne room 15/29) -------------------
; Explore only: two jars, and one thing to find (A facing it, either player); the find is taken once ever (flags 531-533).
; Entries: 1 + 2n room n's find (areas 27-31 in order), 2 + 2n its look once taken (chamber.c CH_FIND); a find's text leads to
; 11 + 2n, the item (flag 531 + n), and 12 + 2n, its box
sequence ch_find
  [0] script
        CoopCall 35, 51, 0, 0
        END
  [1] text 0 "@^A bed, neatly made. Something is under the pillow..." -> 11
  [2] text 0 "@^A bed, neatly made. Nothing else here." -> 21
  [3] text 0 "@^The cold box is stocked with rations...\x0band something green at the back." -> 13
  [4] text 0 "@^Rations, and nothing else." -> 21
  [5] text 0 "@^The crystal hums. Something glints at its foot..." -> 15
  [6] text 0 "@^The crystal hums quietly." -> 21
