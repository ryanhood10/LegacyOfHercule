        SetEntityFacing 28, 1
        WalkToPosition 11, 360, 200
        SetEntityFacing 11, 3
        WaitFrames 40
  stockseq @083e6078 8 30               ; "And 18!  Poetry in motion!" ... "NO!!!!!!!!!!!"
  script                                ; stock entry 31, restaged (6.8 a): Piccolo powers up and fires three blasts that burst on Cell; Cell is
        SetEntityFacing 9, 0            ; at his side in a blink and one heavy blow throws him 32 px into the stock lying pose. Player 2:
        PlayMusic 35                    ; Hercule cowers on a knee (he stays down until Goku comes); everyone looks at Piccolo
        SetEntityFacing 11, 2
        CoopCall 37, 1, 0, 28            ; (Ryan, 2026-11-08: "when he attacked he wasnt super anymore") he goes Super first, the stock transformation with the charge
        CoopCall 37, 7, 0, 4             ; beside it, and fires as his own form (row 7, sprite 104); Cell's blow knocks him out of it (flag 8)
        SetEntityAnimation 0, 35
        CoopCall 37, 7, -1, 0
        SetCharacterTransformation 1, 104
        WhiteFlash 12
        CoopCall 37, 8, 1, 3
        WaitFrames 40
        SetEntityFacing 28, 2
        WaitFrames 30
        CoopCall 37, 1, 28, 0
        CoopCall 37, 4, 0, 0
        CoopCall 37, 5, 9, 32
        SetEntityAnimation 0, 33
        CoopCall 37, 12, 0, 28
        CoopCall 37, 16, -15, 0
        JumpIfFalse H1
        CoopCall 37, 1, -15, 28
        CoopCall 37, 10, 0, 1
      H1:
  stockseq @083e6078 32 38              ; "I could absorb you if I wanted..." ... "I will kill Cell. ... I cannot let that happen."
  script                                ; (Ryan, 2026-11-08) the players fight Cell here, before 16's blows: as 16 and Piccolo with two players (player 2 is 16), alone as
        PlayAudio 60                    ; 16 with Piccolo left lying; behind a short fade. Cell goes from the actor to the boss record (stat 125, to half his health)
        FadeOut 30
        CoopCall 37, 0, 0, 0
        CoopCall 11, 1, 0, 0            ; 16 for this fight (a16_fight_join)
        CoopCall 5, 0, 0, 0
        JumpIfFalse alone
        SetEntityAnimation 0, 0
        CoopCall 9, 1, 300, 176
        Jump ready
      alone:
        PushVarint 103
        PushEntityPosition 0
        PushVarint 65536
        Div
        PushEntityPosition 0
        PushEntityPosition 0
        PushVarint 65536
        Div
        PushVarint 65536
        Mul
        Sub
        Step SpawnCharacterEntity
        CoopCall 37, 1, 103, -3          ; the actor lies by Cine's pose (held; SetEntityAnimation 33 never returned on a fresh actor)
        CoopCall 37, 10, 0, 2
        SetEntityAnimationNoWait 0, 0    ; the switch waits for the lying pose to end: he is stood up behind the fade first
        SetActiveCharacter 7
        SetEntityPositionInstant 0, 300, 176
      ready:
        DespawnEntity 8
        SetEntityPositionInstant 28, 340, 216
        SetEntityFacing 28, 2
        SetEntityFacing 0, 3
        DespawnCharacterAndRecordPosition 28, 7
        DrawBossHealthBarRange 28, 50, 100
        PlayMusic 35
        FadeFromWhite 30
        SetPlayerVisible 1
        SetActiveEntity 0
end

