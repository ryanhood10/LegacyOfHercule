; Android 16 is the island boss (docs/story.md 4e/4f, docs/coop-design.md "Android 16 boss").
; Kame House (zone 11 area 1, map 293): 16 is furious that Goku is not there and Piccolo tricks him into
; a fight on the next island. The island (areas 4-6, maps 296-298): 16 (enemy stat 109, sprite 160)
; instead of 17 (stat 3, sprite 9); the stock fight runs over two stages (bar 75-100 in area 4, 50-75 in
; area 6) and 16 stops at half health (src/coop/android16.c A16_END_PCT), stays standing, and Cell
; arrives as scripted. Sprites: 8 = 16's stock actor, 9 = 17, 11 = 18, 160 = 16's fighting model,
; 28 = Cell. Speakers: 3 Piccolo, 26 Android 16, 28 Android 17, 29 Android 18.
; Stock entries are referenced (stock @ADDR / stockseq), never restated; applied by a16_island.json.

; map 293 trigger 3 (condition: flag 144 set, 145 clear): the androids land at Kame House
sequence a16_kame_house
  [0] script                            ; arrival sound; Piccolo is player 1 for his deal and fight (the fade hands it over)
        PushActiveCharIndex
        PushByte 1
        CmpNe
        JumpIfFalse F9
        FadeOut 20
        CoopCall 8, 0, 0, 0
        PushByte 1
        CmpEq
        JumpIfFalse F1
        PushByte 6
        PushActiveCharIndex
        PushByte 0
        PushByte 0
        Step CoopCall
      F1:
        SetActiveCharacter 1
        FadeFromWhite 20
      F9:
        SetPlayerVisible 0              ; the HUD's bars stayed up over the first lines (the stock hides them one entry later)
        PlayAudio 50
        END
  [1] stock @083e2864                   ; 17: can Goku come out and play?
  [2] stock @083e2896                   ; 17, 18 and 16 fly in
  [3] stock @083e2920                   ; 16: I cannot detect him
  [4] stock @083e295e                   ; 17: not here?
  [5] stock @083e296c                   ; Piccolo walks up
  [6] text 3 "!PICCOLO: That's right.  Goku's not here."
  [7] script                            ; 16's anger is shown before it is spoken: two heavy steps toward Piccolo, the ground answers
        WalkToPosition 8, 592, 448
        SetEntityFacing 8, 3
        PlayAudio 43
        BeginCommandBatch
        ScreenShake 0, 10, 24
        SpawnDustCloud 8, 584, 452
        SpawnDustCloud 8, 600, 452
        SetEntityFacing 9, 2
        CommitCommandBatch
        StopAudio 43
        CoopCall 37, 16, -15, 0         ; player 2 (batch 2, 6.5 beat 3; the fade made Piccolo player 1): Hercule drops to a knee and
        JumpIfFalse P1                  ; cowers at the stomp; Krillin is level with Piccolo in a blink, on guard
        CoopCall 37, 1, -15, 8
        CoopCall 37, 10, 0, 1
      P1:
        CoopCall 37, 16, -16, 0
        JumpIfFalse P2
        CoopCall 37, 1, -16, 0
        CoopCall 37, 4, 1, 24
      P2:
        CoopCall 37, 11, 8, 0
  [8] text 26 "ANDROID 16: Not here...?\x0bI was built for one purpose: to destroy Goku.\x0bWhere is he?  Tell me where Goku is!"
  [9] script                            ; 17 gives him room (18 does not move: she is bored)
        WalkToPosition 9, 644, 502
        SetEntityFacing 9, 2
  [10] text 28 "Whoa, take it easy, 16.  I've never seen you like this."
  [11] script                           ; Piccolo steps toward 16 with his offer (a cowering Hercule gets up behind him)
        CoopCall 37, 1, -15, 0
        CoopCall 37, 10, 0, 0
        WalkToPosition 0, 630, 438
        SetEntityFacing 0, 2
  [12] text 3 "!You want Goku?  Then let's make a deal.\x0bBeat me on that island over there...\x0b...and I'll tell you where he is."
  [13] stock @083e2ac6                  ; camera pans to the island
  [14] stock @083e2ae4                  ; Piccolo: you and me
  [15] script                           ; stock 083e2af4 (camera back); 16 looks at the island, then at Piccolo
        PanCameraToPosition 496, 368, 3
        SetEntityFacing 8, 2
        WaitFrames 30
        SetEntityFacing 8, 3
  [16] text 26 "ANDROID 16: Agreed.\x0bWhen you lose, you will tell me where to find Goku."
  [17] script                           ; 16 goes first (he is the eager one; the stock sent him last)
        PlayAudio 26
        FlyToPosition 8, 500, 544
        DespawnEntity 8
        SetEntityFacing 9, 2
        SetEntityFacing 11, 2
  [18] text 28 "Ha!  This I've got to see.  Come on, 18."
  [19] text 3 "!(Heh.  He doesn't need to know I have no intention of telling him.)"
  [20] script                           ; stock 083e2b38 without 16: 17 and 18 fly after him together; flag 145, reload
        PlayAudio 26
        BeginCommandBatch
        FlyToPosition 9, 568, 544
        DespawnEntity 9
        FlyToPosition 11, 528, 536
        DespawnEntity 11
        CommitCommandBatch
        SetActiveEntity 0
        SetStoryFlag 145
        ReloadMap
        SetPlayerVisible 1
end

; map 293 trigger 4 (A on the flight pad after the scene): the stock flight, where Krillin and Tien come out to watch. A played
; Krillin is already beside Piccolo: his actor (76) stays away then (it stood as a second Krillin)
script a16_kame_flight
        PlayMusic 19
        PlayAudio 26
        FlyToPosition 0, 96, 800
        SetPlayerVisible 0
        FindEntityByType 5
        PanCameraToPosition 256, 512, 3
        CoopCall 22, 4, 6, 0
        JumpIfFalse K1
        SpawnCharacterEntity 121, 488, 504
        FlyToPosition 121, 456, 568
        WalkToPosition 121, 392, 608
        Jump K2
      K1:
        BeginCommandBatch
        SpawnCharacterEntity 76, 448, 496
        SpawnCharacterEntity 121, 488, 504
        FlyToPosition 121, 456, 568
        WalkToPosition 121, 392, 608
        FlyToPosition 76, 416, 544
        WalkToPosition 76, 376, 568
        CommitCommandBatch
        SetEntityAnimation 76, 4
      K2:
        PushMulti 11, 4, 1, 520, 32
        Negate
        WarpToMapWithEntities
        FlyToPosition 0, 352, 224
end

; map 296 trigger 0: on the island, before the fight
sequence a16_island_intro
  [0] stock @083e469c                   ; face, camera, music
  [1] stock @083e46b8                   ; 18 sits this one out
  [2] stock @083e46f4                   ; wait
  [3] text 26 "!ANDROID 16: Piccolo.  When I defeat you, you will tell me where Goku is."
  [4] text 3 "!PICCOLO: A deal's a deal.  But you have to beat me first!"
  [5] text 26 "!Then I will not hold back."
  [6] script
        DespawnCharacterAndRecordPosition 8, 1      ; 16's actor -> the boss record (stat 109, sprite 160)
        DrawBossHealthBarRange 160, 75, 100         ; first stage: 100 % -> 75 %
        SetPlayerVisible 1
        SetActiveEntity 0
end

; map 296 record 1 defeat (16 at 75 %): the island breaks apart, everyone moves to area 5
sequence a16_island_break
  [0] script                            ; stock 083e4818 behind a short fade: everyone on marks in the clearing with the camera on them
        PlayAudio 60                    ; (the fight left player 1 anywhere: the lines played over a tree with no speaker in view).
        SetPlayerVisible 0              ; The stock rumble (PlayAudioBlocking 30, 180 = sound 43 and a camera shake of 180 frames) as a
        FindPlayerEntity                ; batch, so dust bursts across the ground and 18 and 16 turn while it shakes
        FadeOut 20
        SetEntityPositionInstant 160, 264, 164
        SetEntityFacing 160, 3
        SetEntityPositionInstant 0, 304, 168
        SetEntityFacing 0, 2
        CoopCall 9, 1, 328, 172
        SetEntityFacing 9, 3
        SetEntityFacing 11, 3
        PanCameraToPosition 152, 100, 10
        FadeFromWhite 20
        PlayAudio 43
        BeginCommandBatch
        ScreenShake 0, 30, 180
        EntityWaitFrames 160, 20
        SpawnDustCloud 160, 232, 216
        EntityWaitFrames 160, 30
        SpawnDustCloud 160, 344, 150
        EntityWaitFrames 160, 30
        SpawnDustCloud 160, 290, 230
        SetEntityFacing 160, 1
        EntityWaitFrames 160, 30
        SpawnDustCloud 160, 200, 180
        EntityWaitFrames 11, 60
        SetEntityFacing 11, 0
        CommitCommandBatch
        StopAudio 43
  [1] text 29 "ANDROID 18: This island is breaking apart!\x0b16, is he really pushing you around?"
  [2] script                            ; stock 083e4884 (the second rumble) the same way: 16 turns back to Piccolo, 17 steps to the cliff's edge
        PlayAudio 43
        BeginCommandBatch
        ScreenShake 0, 40, 120
        SetEntityFacing 160, 3
        EntityWaitFrames 160, 30
        SpawnDustCloud 160, 250, 224
        EntityWaitFrames 160, 40
        SpawnDustCloud 160, 350, 200
        WalkToPosition 9, 196, 150
        SetEntityFacing 9, 3
        CommitCommandBatch
        StopAudio 43
  [3] stock @083e4890                   ; 17: he can't keep this up
  [4] script                            ; Piccolo steps up to 16 for his answer
        WalkToPosition 0, 290, 166
        SetEntityFacing 0, 2
  [5] stock @083e4904                   ; Piccolo: you're not perfect
  [6] script                            ; stock 083e494c with 16 = 160 (the boss) and 17 = 9 (watching)
        PlayAudioBlocking 50, 90
        PlayAudio 43
        FadeToWhite 120
        PlayAudio 20
        WaitFrames 30
        PlayAudio 21
        WarpToMapNoEntities 11, 5, 1, 336, 88
        PanCameraToPosition 152, 56, 10
        SetEntityFacing 160, 1
        SetEntityFacing 9, 1
        SetEntityFacing 11, 3
        WhiteFadeOut 120
        StopAudio 43
        WaitFrames 120
        PlayAudio 26
        FlyToPosition 160, 400, 240
        DespawnEntity 160
        BeginCommandBatch
        PlaySFX 9, 26
        FlyToPosition 9, 376, 264
        DespawnEntity 9
        FlyToPosition 11, 408, 232
        DespawnEntity 11
        CommitCommandBatch
        WaitFrames 60
        PlayAudio 47
        FindCharacterEntity 0
        SetStoryFlag 146
        WaitFrames 60
        SetActiveEntity 0
        SetPlayerVisible 1
end

; map 298 record 0 defeat (16 at 50 %, the end of his fight): he stays standing, Cell arrives
sequence a16_island_half
  [0] script
        PlayAudio 60
        SetPlayerVisible 0
        FindPlayerEntity
        WaitFrames 60
        DespawnCharacterAndRecordPosition 160, 6    ; the boss -> 16's standing actor (sprite 8, record 6)
        PlayAudio 50
  [1] text 26 "ANDROID 16: Enough.  You are stronger than my data predicted.\x0bNow keep your promise, Piccolo.  Where is Goku?"
