; Chapter 2, West City (docs/story.md section 0 item 2), applied by ch2_west_city.json:
;  - Hercule joins (party slot 5) right where Piccolo joins: he wants Piccolo's flying "magic trick",
;    Piccolo needs a roof for the three years of training, so: the mansion deal;
;  - Triceratops Jungle is Piccolo and Hercule only (Gohan's and Krillin's available bit is cleared
;    inside, restored on the way out), and Hercule claims the credit for the dinosaur peace.
; Speakers: 0 narration, 3 / 90 Piccolo, 67 Hercule, 96 / 97 King Triceratops. Sprites: 72 Hercule,
; 103 Piccolo. Story flags: 361 = inside the jungle (restore the bits on leaving), 362 = Hercule's deal.

; map 65 (West City, zone 4 area 3) record 2: Piccolo's talk, the mansion deal, both join
sequence ch2_piccolo_deal
  stock @083c31a4                        ; music, player hidden
  stock @083c31b0                        ; Piccolo: how's your training going, Gohan?
  stock @083c323c                        ; let someone else try
  script
        SpawnCharacterEntity 72, 360, 1000
        WalkToPosition 72, 304, 968
        SetEntityFacing 72, 2
        SetEntityFacing 103, 3
        PanCameraToPosition 168, 860, 2  ; (batch 1, 2.2) the view comes up so the boxes at its top leave the two of them in the clear
        CoopCall 37, 11, 72, 103
        PlayAudio 50
  text 67 "HERCULE: Hold it right there, Green Bean!\x0bI saw you fly in this morning.  What's the secret?  Wires?  Mirrors?"
  script                                 ; Hercule walks round him once, looking up over his head for the wires
        WalkToPosition 72, 302, 944
        WalkToPosition 72, 280, 936
        SetEntityFacing 72, 1
        WaitFrames 12
        WalkToPosition 72, 258, 950
        WalkToPosition 72, 266, 972
        WalkToPosition 72, 302, 968
        SetEntityFacing 72, 2
        CoopCall 37, 11, 103, -3
        SetEntityFacing 103, 1           ; Piccolo turns his back on him
  text 90 "PICCOLO: It's no trick.  Get lost."
  script                                 ; everyone but Piccolo (his back still turned) looks at Hercule
        CoopCall 37, 12, 72, 103

  text 67 "HERCULE: Teach me that flying act and the crowds will go wild!\x0bTell you what: you can stay at my mansion while you train.\x0bForty rooms, a pool, room service!"
  script                                 ; he half turns back
        CoopCall 37, 11, 103, 72
  text 90 "PICCOLO: (A roof over my head for three years...)\x0b...Fine.  But you train with us, and you do as I say."
  script                                 ; Hercule's victory shout
        CoopCall 37, 11, 72, 103
        SetEntityAnimation 72, 4
  text 67 "HERCULE: Ha ha ha!  You've got yourself a deal, Green Bean!"
  script
        SetActiveEntity 103
        BeginCommandBatch                ; they leave together, Hercule trotting after him
        WalkToPosition 103, 280, 888
        WalkToPosition 72, 280, 888
        CommitCommandBatch
        DespawnEntity 103
        DespawnEntity 72
        SetActiveEntity 0
        SetCharacterInPartyFlag 1
        SetCharacterTransformation 0, 55
        SetCharacterFlag_Bit1 1
        SetCharacterInPartyFlag 5
        SetCharacterFlag_Bit1 5
        SetStoryFlag 362
        PlayAudio 28
  stock @083c32c4                        ; save points switch characters
  stock @083c3328                        ; Piccolo is now available!
  text 0 "@^Hercule is now available!"
  stock @083c33c8                        ; Piccolo level 10, flag 57, reload
  stock @083c33e0                        ; Journal Updated!
end

; map 105 (zone 4 area 58) record 0 defeat: King Triceratops gives up, Hercule takes the credit
; zone 4 area 58 trigger 0 (the stock intro 083c9a38, its indexes kept: entry 4 returns 8): the King's power before his words
; (batch 1, 2.3): as the camera reaches him he stamps, the ground answers, and only then "What do you want?"; when he will not
; listen he takes two heavy steps at the players
sequence ch2_triceratops
  [0] script                             ; stock 0 and the stamp (the HUD's bars are hidden until the fight: they sat over him)
        SetPlayerVisible 0
        PanCameraToPosition 8, 64, 3
        PlayAudio 60
        BeginCommandBatch
        SetEntityAnimation 127, 6
        ScreenShake 0, 6, 16
        CommitCommandBatch
        SetEntityAnimation 127, 0
        SetEntityFacing 127, 0
  [1] stockseq @083c9a38 1 3             ; "What do you want?", the farmers' right, "This place belongs to the dinosaurs now!"
  [4] script                             ; stock 4 (Gohan as player 1 skips to the fight, 8), after two heavy steps toward the players
        WalkToPosition 127, 112, 140
        PlayAudio 60
        BeginCommandBatch
        ScreenShake 0, 4, 10
        CommitCommandBatch
        WalkToPosition 127, 112, 152
        PlayAudio 60
        BeginCommandBatch
        ScreenShake 0, 4, 10
        CommitCommandBatch
        SetEntityFacing 127, 0
        PushActiveCharIndex
        PushByte 0
        CmpEq
        JumpIfFalse L1
        PushByte 8
      L1:
  [5] stockseq @083c9a38 5 7             ; "Listen, I don't have all day...", "I'm King Triceratops!", "the hard way"
  [8] script                             ; stock 8, the fight, with the HUD back
        SetActiveEntity 0
        SetPlayerVisible 1
        DrawBossHealthBarRange 127, 25, 100
end

sequence ch2_triceratops_end
  [0] script                             ; stock 0: he sinks (his pose 4) with a last small shake
        PlayAudio 60
        PlayMusic 0
        FindPlayerEntity
        SetEntityAnimation 127, 4
        CoopCall 37, 15, 12, 0
        AddEXP 1500
        WaitFrames 60
  stockseq @083c9bf8 1 3                 ; "OK OK!  I give up!", the Triceratops of honor
  [4] script                             ; only who is played (Ryan, 2026-11-05: a party member nobody plays is not in the scene):
        CoopCall 22, 4, 5, 0                  ; Hercule takes the credit when someone plays him (next 5), else the stock end (8)
        JumpIfFalse a
        PushByte 5
        END
      a:
        PushByte 8
        END
  [5] text 67 "HERCULE: Ha ha ha!\x0bAnother peace treaty, brought to you by the World Martial Arts Champion!"
  [6] script                             ; Piccolo answers him when someone plays Piccolo too (next 7), else 8
        CoopCall 22, 4, 1, 0
        JumpIfFalse a
        PushByte 7
        END
      a:
        PushByte 8
        END
  [7] text 3 "!PICCOLO: You hid behind a rock the whole fight."
  [8] stockseq @083c9bf8 4                   ; flag 60, back to the farmers
end
