; The two duels (docs/story.md section 0 items 3 and 6, sections 4b and 4e), applied by ch3_duels.json.
; Both run through the script -> C bridge: CoopCall 1 (DuelStart: slot, flags, end sequence), CoopCall 2
; (DuelClear), CoopCall 3 (DuelWinner, pushes 1 / 2). Flags: 1 clone, 2 shadow, 4 swap pads when player 2
; wins, 8 full energy (Super Saiyan without drain). Without a player 2 a duel is skipped (player 1 wins).
; Sprites: 137 / 140 Vegeta base / Super Saiyan, 128 / 134 Trunks base / Super Saiyan, 72 Hercule.
; Speakers: 0 narration, 1 the active character's box, 67 Hercule, 99 Trunks, 106 Vegeta.

; ---- space (zone 6 area 50): Vegeta and his clone ----------------------------------------------------

; The cutscene pass (2026-11-06, docs/cutscenes/batch1_ch1-4.md 3.2), with the cinematic helpers (CoopCall 37): the same beats and lines,
; the blows played instead of posed. The two come at each other from the rock's two edges and trade a flurry; the clone is behind him for
; the two "lucky" blows; Vegeta's blast throws it to the edge; it gets up, powers up and is gold; one blow throws Vegeta across the rock;
; he is on a knee through the first half of the monologue and on his feet for the second; the long power-up; the stock transformation; a
; first clash, and the duel (two players) or the fight itself, ended by his blow (one player, in place of two blind flashes). The HUD is
; hidden until the duel. Player 1's body is Cine's body 0; the clone is an actor (137, then 140).
sequence ch3_space
  script
        SetPlayerVisible 0
        SetEntityPositionInstant 0, 220, 560
        SetEntityFacing 0, 3
        SpawnCharacterEntity 137, 340, 560
        SetEntityFacing 137, 2
        SetCharacterLevel 2, 18
        PlayMusic 39
        WaitFrames 60
        PlayAudio 50
  text 0 "@^In the deep reaches of space, Vegeta trains against a clone of himself..."
  script
        CoopCall 37, 1, 0, 137
        CoopCall 37, 6, 45, 0                 ; from the two edges into a flurry at the centre; they break apart
        WaitFrames 12
        CoopCall 37, 1, 137, 0
        CoopCall 37, 4, 5, 0                  ; the clone is behind him
        CoopCall 37, 5, 0, 0
        CoopCall 37, 5, 2, 0
        WaitFrames 24
  text 1 "#VEGETA: Tch...  A lucky shot."
  script
        CoopCall 37, 1, 0, 137
        CoopCall 37, 8, 32, 0                 ; his blast throws the clone to the edge
        WaitFrames 30
  text 1 "#Pathetic.  You're nothing but a cheap copy, made to keep the real prince sharp.\x0bKnow your place, shadow!"
  script
        CoopCall 37, 1, 137, 0
        CoopCall 37, 10, 0, 0                 ; it gets up
        WaitFrames 20
        CoopCall 37, 7, 50, 1                 ; its power, and the gold
        PushVarint 140
        PushEntityPosition 137
        PushVarint 65536
        Div
        PushEntityPosition 137
        PushEntityPosition 137
        PushVarint 65536
        Div
        PushVarint 65536
        Mul
        Sub
        Step SpawnCharacterEntity
        DespawnEntity 137
        CoopCall 37, 11, 140, 0
        WhiteFlash 20
        WaitFrames 40
  text 106 "CLONE: A copy?  Look again, Prince.\x0bOnly one of us leaves here alive.  I'm done living in your shadow!"
  script
        CoopCall 37, 1, 140, 0
        CoopCall 37, 4, 0, 0                  ; it is on him
        CoopCall 37, 5, 1, 56                 ; one blow: he is thrown across the rock
        WaitFrames 40                         ; it stands and waits
        CoopCall 37, 10, 1, 1                 ; he gets to a knee
        WaitFrames 20
  text 1 "#VEGETA: Frieza enslaved my race...\x0bThe true prince of all Saiyans was surpassed by a low-class warrior raised on Earth...\x0b...and now a clone, made for paltry training, reaches the legend before me?!"
  script                                 ; on his feet for the rest
        CoopCall 37, 1, 0, 140
        CoopCall 37, 10, 0, 0
  text 1 "#No!  It is in my blood.  This is MY legend...\x0b...and I will take what is mine!"
  script
        SetCharacterFlag_Bit5 2
        SetCharacterFlag_Dynamic 2, 1
        CoopCall 37, 1, 0, 140
        CoopCall 37, 7, 80, 2                 ; the long power-up, then the stock transformation
        SetEntityAnimation 0, 35
        SetCharacterTransformation 2, 140
        WhiteFlash 20
  stock @083d1fe8                        ; Vegeta: I'm finally a Super Saiyan!
  stock @083d1fac                        ; You are now playing as Vegeta.
  text 1 "#Only one of us leaves alive, shadow?  So be it!"
  script                                 ; two players: a first clash, then the clone is player 2's and the duel starts; one player: the clone stays for the end scene's fight
        CoopCall 5, 0, 0, 0
        JumpIfFalse one
        CoopCall 37, 1, 0, 140
        CoopCall 37, 6, 24, 0
        CoopCall 37, 3, 208, 576              ; and he is back on the spot the duel starts from (the stock's)
        SetEntityFacing 0, 3
        CoopCall 37, 0, 0, 0
        DespawnEntity 140
      one:
        PlayMusic 35
        CoopCall 1, -1, 15, seq:ch3_space_end
        SetPlayerVisible 1
end

; the duel is over: the winner is Vegeta (player 1's entity; the pads swapped if player 2 won)
sequence ch3_space_end
  script                                 ; [0] two players dueled: on to 2; alone: the fight at 1
        CoopCall 5, 0, 0, 0
        JumpIfFalse L1
        PushByte 2
        END
      L1:
        PushByte 1
        END
  script                                 ; [1] alone (no duel): the fight is shown (the stock: two blind flashes): a flurry, and his blow ends it
        SetPlayerVisible 0
        CoopCall 37, 1, 0, 140
        CoopCall 37, 6, 60, 1
        WaitFrames 10
        WhiteFlash 8
        CoopCall 37, 0, 0, 0
        CoopCall 22, 2, 140, 0
        JumpIfFalse gone
        DespawnEntity 140
      gone:
        PlayAudio 21
        WaitFrames 20
        SetPlayerVisible 1
  script
        WaitFrames 40
        PlayMusic 39
        PlayAudio 50
  text 1 "#VEGETA: I've won.  I'm a Super Saiyan."
  stock @083d20a8                        ; the Super Saiyan form tutorial
  stock @083d21bc                        ; "I have to get back to Earth..."
  script
        CoopCall 2, 0, 0, 0
        SetCharacterTransformation 2, 137
        SetStoryFlag 77
        FadeOut 60
        WaitFrames 60
        WarpToMapWithEntities 6, 22, 1, 240, 288
        WalkToPosition 0, 240, 312
end

; zone 6 area 22: Vegeta lands; Hercule was told by Piccolo to wait for him (the duel's loser plays him)
sequence ch3_landing
  [0] script                             ; stock's sound; player 2's entity (whoever the duel left him) waits out the scene, he comes back as Hercule
        PlayAudio 50
        CoopCall 31, 3, 0, 0
  [1] stock @083d1974                    ; Vegeta: those Androids must be here by now
  [2] script                             ; Hercule meets Vegeta only with two players, as player 2's new character (next 3); alone he is not
        CoopCall 5, 0, 0, 0                   ; in the scene (Ryan, 2026-11-05) and only becomes selectable (11)
        JumpIfFalse a
        SpawnCharacterEntity 72, 344, 352
        WalkToPosition 72, 272, 320
        SetEntityFacing 72, 2
        SetEntityFacing 0, 3
        PlayAudio 50
        PushByte 3
        END
      a:
        PushByte 11
        END
  [3] text 67 "HERCULE: Thank God you've arrived!  We need you in the fight!"
  [4] text 1 "#VEGETA: And who the hell are you?"
  [5] text 67 "HERCULE: The name's Hercule!  World Martial Arts Champion!\x0bPiccolo told me to wait here and keep an eye out for you."
  [6] text 67 "HERCULE: Don't you worry, I came prepared!  See?  Loaded and everything!"
  [7] text 1 "#VEGETA: A gun.  You brought a gun.  To fight androids."
  [8] text 67 "HERCULE: ...It's a really good gun."
  [9] text 1 "#VEGETA: Hmph.  Stay out of my way."
  [10] script                            ; Hercule goes to where player 2's entity appears (12 px left of player 1)
        PushByte 72
        PushEntityPosition 0
        PushVarint 65536
        Div
        PushVarint 12
        Sub
        PushEntityPosition 0
        PushEntityPosition 0
        PushVarint 65536
        Div
        PushVarint 65536
        Mul
        Sub
        PushVarint 24
        Add
        Step WalkToPosition
        PushByte 72
        PushEntityPosition 0
        PushVarint 65536
        Div
        PushVarint 12
        Sub
        PushEntityPosition 0
        PushEntityPosition 0
        PushVarint 65536
        Div
        PushVarint 65536
        Mul
        Sub
        Step WalkToPosition
        DespawnEntity 72
  [11] script
        SetCharacterFlag_Bit1 5
        CoopCall 6, 5, 0, 0                ; player 2's entity (kept across the warp) plays Hercule now
        SetStoryFlag 75
        PlayAudio 62
        ReloadMap
  [12] stock @083d19f2                   ; Journal Updated!
end

; ---- the Lookout (zone 9 area 3) and the Hyperbolic Time Chamber (zone 15 area 2): Vegeta vs Trunks ----

sequence ch6_lookout
  stockseq @083dde0c 0 17                ; Goku: only two can train; Vegeta first; Mr. Popo's rules
  script                                 ; Vegeta and Trunks walk into the chamber (stock 083ddd22's walk)
        BeginCommandBatch
        WalkToPosition 137, 96, 144
        SetEntityFacing 60, 1
        WalkToPosition 137, 96, 56
        CommitCommandBatch
        PushActiveCharIndex
        PushByte 3
        CmpEq
        JumpIfFalse L1
        WalkToPosition 0, 96, 120
        WalkToPosition 0, 96, 56
        Jump L2
      L1:
        WalkToPosition 128, 112, 160
        WalkToPosition 128, 96, 120
        WalkToPosition 128, 96, 56
      L2:
        FadeOut 120
        WaitFrames 30
        SetStoryFlag 144
        SetCharacterFlag_Bit1 2
        SetCharacterFlag_Bit1 3
        SetActiveCharacter 2
        SetCharacterTransformation 2, 140
        SetCharacterTransformation 3, 134
        WarpToMapWithEntities 15, 2, 1, 280, 320
        SpawnCharacterEntity 134, 344, 320
        SetEntityFacing 0, 2             ; Vegeta has his back to his son; Trunks looks about the white room
        SetEntityFacing 134, 2
        FadeFromWhite 60
        SetEntityFacing 134, 1
        WaitFrames 24
        SetEntityFacing 134, 0
        WaitFrames 24
        SetEntityFacing 134, 2
        PlayAudio 50
  text 99 "TRUNKS: Well, father, let's get settled in.  We have a whole year in here."
  script                                 ; Vegeta's answer is his power (shown, then spoken): a flare, and he turns
        CoopCall 37, 1, 0, 134
        CoopCall 37, 7, 40, 1
        SetEntityFacing 0, 3
  text 106 "VEGETA: Settled in?  Don't be ridiculous.\x0bWe spar.  Right now, boy!"
  text 99 "TRUNKS: Right now?  ...Fine.  Don't expect me to go easy on you."
  script                                 ; Trunks powers up too; a held look. Two players: his actor makes way for player 2 and the duel is
        CoopCall 37, 1, 134, 0           ; theirs. One player: the actor stays and the spar is played (ch6_chamber_end's entry 1): Vegeta
        CoopCall 37, 7, 40, 1            ; no longer tells an empty room to get up
        SetEntityFacing 134, 2
        WaitFrames 30
        CoopCall 5, 0, 0, 0
        JumpIfFalse L1
        DespawnEntity 134
      L1:
        PlayMusic 35
        CoopCall 1, 3, 12, seq:ch6_chamber_end
        SetPlayerVisible 1
end

; the winner's pad plays Piccolo next, the loser's Hercule (the pads swapped if Trunks won)
sequence ch6_chamber_end
  script                                 ; [0] two players dueled: on to 2; alone: the spar at 1
        CoopCall 5, 0, 0, 0
        JumpIfFalse L1
        PushByte 2
        END
      L1:
        PushByte 1
        END
  script                                 ; [1] alone (no duel): the spar between Vegeta and Trunks' actor (it was two flashes over Vegeta alone):
        SetPlayerVisible 0               ; an exchange too fast to follow, they break; Trunks is behind him in a blink, Vegeta catches it,
        CoopCall 37, 1, 0, 134           ; Trunks answers, and one blow from his father throws him across the floor
        CoopCall 37, 6, 110, 0
        CoopCall 37, 1, 134, 0
        CoopCall 37, 4, 5, 0
        CoopCall 37, 1, 0, 134
        CoopCall 37, 5, 0, 0
        CoopCall 37, 1, 134, 0
        CoopCall 37, 5, 0, 0
        CoopCall 37, 1, 0, 134
        CoopCall 37, 5, 1, 64
  script                                 ; [2] next entry: 3 if Vegeta won, 5 if Trunks did
        WaitFrames 40
        PlayAudio 50
        CoopCall 3, 0, 0, 0
        PushByte 1
        CmpEq
        JumpIfFalse L1
        PushByte 3
        END
      L1:
        PushByte 5
        END
  script                                 ; [3] Vegeta won: Trunks is down (his player's body on a knee; alone his actor lies where it fell)
        CoopCall 37, 1, -13, -12
        CoopCall 37, 10, 0, 1
        CoopCall 37, 11, -12, -13
  text 106 "VEGETA: Hmph.  That is how a prince fights.\x0bNow get up.  We have a year of training ahead of us." -> 7
  script                                 ; [5] Trunks won: Vegeta on a knee
        CoopCall 37, 1, -12, -13
        CoopCall 37, 10, 0, 1
        CoopCall 37, 11, -13, -12
  text 99 "TRUNKS: I won, father...\x0bNow let's train.  Cell won't wait for us." -> 7
  script                                 ; [7] the loser gets up; Trunks' actor (alone) rises and goes
        CoopCall 37, 1, -13, -3
        CoopCall 37, 10, 0, 0
        CoopCall 37, 1, -12, -3
        CoopCall 37, 10, 0, 0
        CoopCall 37, 1, 134, -3
        CoopCall 37, 10, 0, 0
        WaitFrames 20
        CoopCall 37, 0, 0, 0
        CoopCall 2, 0, 0, 0
        SetCharacterTransformation 2, 137
        SetCharacterTransformation 3, 128
        FadeOut 120
        CoopCall 22, 2, 134, 0
