; Piccolo's chapter (docs/story.md section 0 item 4, section 4c), applied by ch4_piccolo.json. Player 1
; Piccolo, player 2 Hercule (bound since the landing; the save pad keeps the others). Android 13 (sprite
; 165, speaker 0: no portrait) backs Dr. Gero up in all three of Gero's stages (bosses.c: stat 7 pairs
; with 13, stat 112, both-down) and flies off after each; in the lab he watches 17 and 18 turn on Gero
; and leaves. The road: in co-op Vegeta arrives and is player 2 for the fight against 18 and her twin 17
; (bosses.c: stat 4's partner model is 17's, sprite 9), then player 2 is Hercule again.
; Speakers: 0 narration, 3 Piccolo, 4 Vegeta, 28 Android 17, 29 Android 18, 32 Dr. Gero, 67 Hercule.

; ---- zone 8 area 13: Gero's first stage ("You're trying to find my secret lab") ---------------------

; Staging (Ryan, 2026-11-05: "account for 1 player or 2 player or what the combination of characters could be"; "dont have them stagnant"). Whoever nobody plays of Piccolo (103: his NPC sprite 73 has no walking group) and Hercule (72) walks in as an actor
; (CoopCall 22 op 1), hangs back and leaves before the fight: the chapter's selectable characters are Piccolo, Hercule and Krillin, in either player's hands. Only actors and player 1 are moved: player 2 may show any sprite, and
; a sprite-addressed step on a sprite nobody shows writes through a null pointer (docs/scripts.md). 13 comes in on foot or by air to the spot his boss twin takes (TWIN_OFFSET right of Gero), so the swap does not show.
; Lines marked (draft) are Claude's, for Ryan to read.

sequence ch4_gero_first
  [0] script                             ; stock entry 0, with 13 walking down beside Gero and the two walking up
        PlayAudio 50
        SetStoryFlag 90
        SpawnCharacterEntity 165, 216, 168
        CoopCall 22, 1, 5, 0
        JumpIfFalse a
        SpawnCharacterEntity 72, 164, 376
      a:
        CoopCall 22, 1, 1, 0
        JumpIfFalse b
        SpawnCharacterEntity 103, 220, 376
      b:
        BeginCommandBatch
        WalkToPosition 14, 192, 240
        WalkToPosition 165, 216, 240
        WalkToPosition 0, 192, 280
        CoopCall 22, 2, 72, 0
        JumpIfFalse c
        WalkToPosition 72, 164, 300
      c:
        CoopCall 22, 2, 103, 0
        JumpIfFalse d
        WalkToPosition 103, 220, 296
      d:
        CommitCommandBatch
        SetEntityFacing 0, 1
        SetEntityFacing 165, 0
        CoopCall 22, 2, 72, 0
        JumpIfFalse e
        SetEntityFacing 72, 1
      e:
        CoopCall 22, 2, 103, 0
        JumpIfFalse f
        SetEntityFacing 103, 1
      f:
        END
  [1] stock @083d5ddc                    ; Gero: you'll never get inside!
  [2] text 169 "ANDROID 13: Remember me?\x0bThe Doc's got me on guard duty.  Nobody gets near that lab while I'm around!"
  [3] text 67 "HERCULE: Y-yeah, we remember!\x0bNice seeing you again.  You can go now."
  [4] script                             ; Hercule's actor backs away; Piccolo's has a word first (next 5), else 6
        CoopCall 22, 2, 72, 0
        JumpIfFalse a
        WalkToPosition 72, 164, 376
        DespawnEntity 72
      a:
        CoopCall 22, 2, 103, 0
        JumpIfFalse b
        PushByte 5
        END
      b:
        PushByte 6
        END
  [5] text 3 "!PICCOLO: Keep them busy.\x0bI'll find another way in."
  [6] script                             ; stock entry 2: Gero (and 13, his boss twin) fight
        CoopCall 22, 2, 103, 0
        JumpIfFalse a
        FlyToPosition 103, 360, 296
        DespawnEntity 103
      a:
        DespawnEntity 165
        DespawnCharacterAndRecordPosition 14, 1
        DrawBossHealthBarRange 14, 75, 100
        ClearCollisionRect 72, 0, 208, 24
        ClearCollisionRect 240, 568, 376, 592
end

; ---- zone 8 areas 27 and 40: the two generators at the lab door (Gero's second and third stages) -----
; Stock: entry 0 skips to the second-visit lines when the other generator's flag is set. The index it
; returns is absolute, so the sequences are restated with it moved.

sequence ch4_gero_door_a27
  [0] script
        PlayAudio 50
        SetStoryFlag 89
        StackTestStoryFlag 88
        JumpIfFalse L1
        PushByte 12
        END
      L1:
        CoopCall 22, 1, 5, 0
        JumpIfFalse a
        SpawnCharacterEntity 72, 552, 172
      a:
        CoopCall 22, 1, 1, 0
        JumpIfFalse b
        SpawnCharacterEntity 103, 552, 212
      b:
        BeginCommandBatch
        WalkToPosition 0, 456, 192
        CoopCall 22, 2, 72, 0
        JumpIfFalse c
        WalkToPosition 72, 488, 172
      c:
        CoopCall 22, 2, 103, 0
        JumpIfFalse d
        WalkToPosition 103, 488, 212
      d:
        CommitCommandBatch
        SetEntityFacing 0, 2
        CoopCall 22, 2, 72, 0
        JumpIfFalse e
        SetEntityFacing 72, 2
      e:
        CoopCall 22, 2, 103, 0
        JumpIfFalse f
        SetEntityFacing 103, 2
      f:
        END
  [1] stock @083d6274                    ; Gero: I won't let you get into my lab!
  [2] text 67 "HERCULE: N-now hold on there, Doc!  No need for violence!\x0bLet's negotiate!  How about an autographed photo?  Two photos!"
  [3] text 3 "!PICCOLO: Hercule.  Get behind me."
  [4] script                             ; Piccolo steps up, Hercule's actor falls back; 13 drops in beside Gero
        BeginCommandBatch
        PushActiveCharIndex
        PushByte 1
        CmpEq
        JumpIfFalse a
        WalkToPosition 0, 428, 192
      a:
        CoopCall 22, 2, 103, 0
        JumpIfFalse b
        WalkToPosition 103, 428, 192
      b:
        CoopCall 22, 2, 72, 0
        JumpIfFalse c
        WalkToPosition 72, 500, 212
      c:
        WaitFrames 1
        CommitCommandBatch
        CoopCall 22, 2, 72, 0
        JumpIfFalse d
        SetEntityFacing 72, 2
      d:
        WaitFrames 10
        SpawnCharacterEntity 165, 360, 80
        PlayAudio 60
        FlyToPosition 165, 360, 176
        SetEntityFacing 165, 3
        WaitFrames 20
        END
  [5] text 169 "ANDROID 13: Negotiate?  Heh.  Here's my offer, chump:\x0bturn around and run, or me and the Doc scrap ya both."
  [6] text 67 "HERCULE: Run?  Now that's the first smart thing anyone's said all day!"
  [7] script                             ; Hercule's actor takes him up on it; Piccolo's has a word first (next 8), else 9
        CoopCall 22, 2, 72, 0
        JumpIfFalse a
        WalkToPosition 72, 552, 212
        DespawnEntity 72
      a:
        CoopCall 22, 2, 103, 0
        JumpIfFalse b
        PushByte 8
        END
      b:
        PushByte 9
        END
  [8] text 3 "!PICCOLO: Keep them busy.\x0bI'll find another way in."
  [9] script
        CoopCall 22, 2, 103, 0
        JumpIfFalse a
        FlyToPosition 103, 428, 40
        DespawnEntity 103
      a:
        DespawnEntity 165
  [10] stock @083d62dc                   ; the fight, stage 50-75
  stop
  [12] stock @083d6304                   ; Gero: the last generator
  [13] script                            ; 13 drops in again
        SpawnCharacterEntity 165, 360, 80
        PlayAudio 60
        FlyToPosition 165, 360, 176
        SetEntityFacing 165, 3
        WaitFrames 20
  [14] text 169 "ANDROID 13: Back for seconds, huh?\x0bSuit yourself."
  [15] script
        DespawnEntity 165
  [16] stock @083d6360                   ; the fight, stage 25-50
end

