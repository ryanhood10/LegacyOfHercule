; ---- zone 8 area 46: the cutaway into the lab (map 8/60): Gero wakes 17 and 18; 13 watches ----------

sequence ch4_lab
  script                                 ; stock entry 0, with 13 waiting just out of view
        SetPlayerVisible 0
        PanCameraToPosition 72, 392, 3
        WaitFrames 60
        SetMapRestoreFlag
        PlayMusic 7
        LoadMapWithEntities 8, 60, 1, 184, 168
        SpawnCharacterEntity 165, 344, 184
        PlayAudio 50
  stockseq @083d9f5c 1 1                 ; Gero: the time has come
  script                                 ; 13 strolls in to watch
        WalkToPosition 165, 304, 184
        SetEntityFacing 165, 3
  stockseq @083d9f5c 2 24                ; 17 and 18 wake; 17 takes the controller
  script                                 ; 13 takes a step back
        WalkToPosition 165, 316, 176
        SetEntityFacing 165, 3
  stockseq @083d9f5c 25 27               ; "You destroyed it!", "not going to put us to sleep again"
  script                                 ; 17 finishes him, and 13 has seen it
        WalkToPosition 9, 250, 216
        SetEntityAnimation 9, 6
        PlayAudio 21
        WhiteFlash 20
        DespawnEntity 14
        WaitFrames 50
        PlayAudio 50
  text 169 "ANDROID 13: DOC!"
  script
        WalkToPosition 165, 284, 204
        SetEntityFacing 165, 2
        SetEntityFacing 9, 3
        SetEntityFacing 11, 3
        WaitFrames 20
  text 169 "ANDROID 13: You...  You killed him!\x0bHe gave you life, and you killed him!  That man was my father!"
  text 169 "I'll get you for this, ya hear me?\x0bI swear it!  The both of you!"
  script                                 ; Ryan, 2026-11-05: his revenge, the blasts, and he flies off to the arctic
        NPCFireKiBlastAtEntity 165, 9, 30
        WaitFrames 12
        NPCFireKiBlastAtEntity 165, 11, 30
        WaitFrames 30
        WhiteFlash 12
        PlayAudio 21
        WaitFrames 40
  text 28 "ANDROID 17: ...Was that it?"
  text 169 "ANDROID 13: Laugh it up.\x0bNext time I see you two, I'll be stronger than the both of you put together."
  script
        FlyToPosition 165, 330, 40
        DespawnEntity 165
        WaitFrames 30
  text 29 "ANDROID 18: He's heading north.  Should we bother?"
  text 28 "ANDROID 17: Forget him.\x0bWe have Goku to find."
  stock @083d9f44                        ; back to area 46, flag 124
end

; ---- zone 8 area 49: the road. 17, 18 and 16; in co-op Vegeta arrives and fights beside Piccolo ------

sequence ch4_road
  stockseq @083d8b60 0 22                ; the car talk, 16 refuses, 18: "I'll handle this."
  [23] script                            ; a white cut: the heroes catch up, whoever they are, and walk the last steps
        FadeToWhite 16
        PanCameraToPosition 144, 232, 8
        SetEntityPositionInstant 0, 240, 346
        CoopCall 5, 0, 0, 0
        JumpIfFalse a
        CoopCall 9, 1, 204, 346
      a:
        CoopCall 22, 1, 5, 0
        JumpIfFalse b
        SpawnCharacterEntity 72, 200, 360
      b:
        CoopCall 22, 1, 1, 0
        JumpIfFalse c
        SpawnCharacterEntity 103, 276, 360
      c:
        FadeFromWhite 16
        BeginCommandBatch
        WalkToPosition 0, 240, 312
        CoopCall 22, 2, 72, 0
        JumpIfFalse d
        WalkToPosition 72, 200, 322
      d:
        CoopCall 22, 2, 103, 0
        JumpIfFalse e
        WalkToPosition 103, 276, 322
      e:
        CommitCommandBatch
        SetEntityFacing 0, 1
        CoopCall 22, 2, 72, 0
        JumpIfFalse f
        SetEntityFacing 72, 1
      f:
        CoopCall 22, 2, 103, 0
        JumpIfFalse g
        SetEntityFacing 103, 1
      g:
        END
  [24] text 67 "HERCULE: Uh...  Hey, look at the time!\x0bI'd love to stay, but I promised I'd guard the...  the road!"
  [25] script                            ; Hercule's actor goes to guard it; co-op: Vegeta's arrival (next 26), else 31
        CoopCall 22, 2, 72, 0
        JumpIfFalse a
        WalkToPosition 72, 200, 410
        DespawnEntity 72
      a:
        CoopCall 5, 0, 0, 0
        JumpIfFalse b
        PushByte 26
        END
      b:
        PushByte 31
        END
  [26] script                            ; Vegeta drops in from the sky
        SpawnCharacterEntity 137, 204, 180
        PlayAudio 60
        FlyToPosition 137, 204, 300
        SetEntityFacing 137, 3
        WaitFrames 16
  [27] text 4 "!VEGETA: Out of my way, clown.\x0bThe machines are mine.  Namek, try to keep up."
  [28] script                            ; player 2 plays Vegeta for the fight, where his actor stood; Hercule steps back
        FadeOut 30
        WaitFrames 20
        DespawnEntity 137
        ClearCharacterFlag_Bit1 0
        ClearCharacterFlag_Bit1 5
        SetCharacterFlag_Bit1 2
        CoopCall 6, 2, 0, 0
        CoopCall 9, 1, 204, 300
        FadeFromWhite 30
  [29] text 28 "ANDROID 17: Vegeta, isn't it?  Then I'll take you.\x0b18, the green one's yours."
  [30] text 29 "ANDROID 18: Fine by me."
  [31] script                            ; Piccolo's actor, when nobody plays him, leaves it to them (next 32), else 33
        CoopCall 22, 2, 103, 0
        JumpIfFalse a
        PushByte 32
        END
      a:
        PushByte 33
        END
  [32] text 3 "!PICCOLO: You want this fight so badly?\x0bIt's yours."
  [33] script
        CoopCall 22, 2, 103, 0
        JumpIfFalse a
        FlyToPosition 103, 276, 180
        DespawnEntity 103
      a:
        END
  [34] stock @083d8b38                   ; the fight: 18 (and 17, her twin)
end

; 18 (or the pair) beaten: she gets up and blasts Piccolo; player 2 is Hercule again for the stock ending
sequence ch4_road_end
  stockseq @083d98ac 0 1                 ; 18 falls, gets up, the blast, "Nice try!  Who's next?"
  script                                 ; stock entry 2, with player 2 back to Hercule during the fade
        PlayMusic 37
        FadeOut 120
        ClearCharacterFlag_Bit1 2
        SetCharacterFlag_Bit1 0
        SetCharacterFlag_Bit1 5
        PushActiveCharIndex
        PushByte 5
        CmpEq
        JumpIfFalse pl2
        CoopCall 6, 1, 0, 0                ; player 1 is Hercule: player 2 is Piccolo again
        Jump pl3
      pl2:
        CoopCall 6, 5, 0, 0
      pl3:
        PanCameraToPosition 152, 296, 10
        WaitFrames 60
        SetEntityPositionInstant 0, 0, 0
        SetEntityAnimation 0, 0
        PushActiveCharIndex
        PushByte 2
        CmpEq
        PushActiveCharIsTransformed
        And
        JumpIfFalse L1
        SetEntityAnimation 0, 36
      L1:
        SetEntityPositionInstant 11, 224, 344
        SetEntityFacing 11, 0
        SpawnCharacterEntity 8, 344, 368
        SetEntityFacing 8, 3
        SpawnCharacterEntity 9, 256, 288
        SpawnCharacterEntity 76, 88, 432
        FindCharacterEntity 0
        FindCharacterEntity 1
        FindCharacterEntity 2
        FindCharacterEntity 3
        FindCharacterEntity 4
        SetEntityFacing 76, 3
        FadeFromWhite 90
        WalkToPosition 9, 256, 336
        WaitFrames 60
        WalkToPosition 9, 208, 368
        WaitFrames 40
        PanCameraToPosition 32, 312, 3
        WaitFrames 60
        SetEntityAnimation 76, 4
  stockseq @083d98ac 3 11                ; 17: "We want Goku", the birds, Krillin's plea
  script                                 ; Hercule's actor unless player 2 plays him: player 1 is off the stage here
        CoopCall 5, 0, 0, 0
        CoopCall 8, 0, 0, 0
        PushByte 5
        CmpEq
        And
        JumpIfFalse sp
        Jump nosp
      sp:
        SpawnCharacterEntity 72, 60, 372
        WalkToPosition 72, 128, 372
        SetEntityFacing 72, 3
      nosp:
        END
  text 67 "#HERCULE: Y-yeah!  What the little guy said!\x0bLeave Goku alone, or...  or you'll have to deal with me!"
  script                                 ; ...and thinks better of it
        CoopCall 22, 2, 72, 0
        JumpIfFalse a
        WalkToPosition 72, 16, 372
        DespawnEntity 72
      a:
        END
  stockseq @083d98ac 12 48               ; 17's game, the kiss, Vegeta storms off, Piccolo leaves alone
end
