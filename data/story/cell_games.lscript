; ---- map 323 (zone 14 area 1), the arena grounds: the ring's barrier lets only Goku through, at any level (Ryan:
;      Goku-locked as in the stock game, no level gate; its condition and the gate label: byte patches in data/hercule.json) ----

script cg_barrier_cond
    PushActiveCharIndex
    PushByte 4
    CmpNe
    StackTestStoryFlagNot 195
    And
    END
end

sequence cg_barrier
  script
        PlayAudio 28
  stock @083e8048    ; "Only Goku is allowed to pass through this barrier."
end

; the world map's arena landing: the Dragon Balls returned (191) and Gero's computer done (421)
script cg_arena_open
    StackTestStoryFlag 191
    StackTestStoryFlag 421
    And
    END
end
