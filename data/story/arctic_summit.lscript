script watch_krillin
    StackTestStoryFlag 381
    StackTestStoryFlagNot 382
    And
    PushActiveCharIndex
    PushByte 6
    CmpNe
    And
    CoopCall 8, 0, 0, 0
    PushByte 6
    CmpNe
    And
end

; ---- the scene ---------------------------------------------------------------------------------------
