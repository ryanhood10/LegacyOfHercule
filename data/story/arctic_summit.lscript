      bf137:
        CoopCall 22, 2, 132, 0
        JumpIfFalse bf132
        SetEntityFacing 132, 2
      bf132:
        WaitFrames 30
  text 0 "@^The whole mountain is shaking..."
  script                                 ; the reveal: a long white-out, Super 13, the biggest shake, his music
        PlayAudio 55
        FadeToWhite 40
        DespawnEntity 165
        SpawnCharacterEntity 180, 348, 300
        SetEntityFacing 180, 0
        PlayAudio 21
        WaitFrames 60
        WhiteFadeOut 60
        PlayMusic 30                     ; a boss track (Broly's fight's), on through the talk into the fight
        ScreenShake 0, 30, 90
        CoopCall 37, 1, 180, -3          ; as the white lifts he is drawing it all in (the helpers' charge: his crouching power-up), and bursts upright
        CoopCall 37, 7, 40, 2
  text 122 "SUPER 13: Now...  I am complete!"
  script                                 ; Tien and Yamcha's blasts do nothing; his one blast throws them to the rim
        ; proof, between story actors only: Tien and Yamcha fire everything (a volley each, the helpers'); he has not moved; his one big blast
        ; throws Tien, Yamcha goes down with him, and both end at the rim, where they lie through the fight
        CoopCall 37, 1, 121, 180
        CoopCall 37, 8, 1, 4
        CoopCall 37, 1, 156, 180
        CoopCall 37, 8, 1, 4
        WaitFrames 36
        SetEntityFacing 180, 3
        WaitFrames 20
        CoopCall 37, 1, 180, 121
        CoopCall 37, 8, 35, 0
        BeginCommandBatch
        GlideToPosition 121, 530, 380, 2500
        GlideToPosition 156, 530, 430, 2500
