  text 0 "@^The whole mountain is shaking..."
  script                                 ; the reveal: a long white-out, Super 13, the biggest shake, his music
        PlayAudio 55
        FadeToWhite 40
        DespawnEntity 165
        SpawnCharacterEntity 180, 348, 300
        SetEntityFacing 180, 0
        PlayAudio 21
        WaitFrames 60
        WhiteFadeOut 60
        PlayMusic 30                     ; a boss track (Broly's fight's), on through the talk into the fight
        ScreenShake 0, 30, 90
        WaitFrames 40
  text 122 "SUPER 13: Now...  I am complete!"
  script                                 ; Tien and Yamcha's blasts do nothing; his one blast throws them to the rim
        ; proof, between story actors only: Tien and Yamcha fire everything; he has not moved; one blast between them puts both down at the rim,
        ; where they lie through the fight
        BeginCommandBatch
        NPCFireKiBlastAtEntity 121, 180, 100
        NPCFireKiBlastAtEntity 156, 180, 100
        NPCFireKiBlastAtEntity 121, 180, 100
        NPCFireKiBlastAtEntity 156, 180, 100
