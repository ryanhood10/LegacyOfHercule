; The Arctic summit (zone 15 area 8, docs/story.md 4i): Android 13, 17 and 18 fighting when the players arrive, 13
; absorbs 17 then 18 and becomes Super 13, the players say they have to stop him, the fight, the explosion, Vegeta's
; "clankers", then back to the Lookout (postgame's arrival trigger plays the finale). Built into the map by tools/mapbuild.py from data/maps/arctic_summit.json ("sources").
; Speakers: 0 narration (13 has no portrait), 1 player 1's character, 28 Android 17, 29 Android 18, 106 Vegeta.
; Super 13: sprite 180, stat 145, portrait 122 (src/coop/super13.c, tools/super13sprites.py).

; ---- conditions --------------------------------------------------------------------------------------
script summit_on                                 ; the post-game's Arctic is open and Super 13 still stands
    StackTestStoryFlag 381
    StackTestStoryFlagNot 382
    And
end

; a sideline watcher stands only while neither player plays that character (party slot)
script watch_gohan
    StackTestStoryFlag 381
    StackTestStoryFlagNot 382
    And
    PushActiveCharIndex
    PushByte 0
    CmpNe
    And
    CoopCall 8, 0, 0, 0
    PushByte 0
    CmpNe
    And
    PushActiveCharIndex
    PushByte 8
    CmpNe
    And
    CoopCall 8, 0, 0, 0
    PushByte 8
    CmpNe
    And
end

script watch_piccolo
    StackTestStoryFlag 381
    StackTestStoryFlagNot 382
    And
    PushActiveCharIndex
    PushByte 1
    CmpNe
    And
    CoopCall 8, 0, 0, 0
    PushByte 1
    CmpNe
    And
end

script watch_vegeta
    StackTestStoryFlag 381
