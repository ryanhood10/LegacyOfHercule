script watch_krillin
    StackTestStoryFlag 381
    StackTestStoryFlagNot 382
    And
    PushActiveCharIndex
    PushByte 6
    CmpNe
    And
    CoopCall 8, 0, 0, 0
    PushByte 6
    CmpNe
    And
end

; ---- the scene ---------------------------------------------------------------------------------------
sequence summit_scene
  script                                 ; 13 against 17 and 18 at the centre of the clearing
        SetPlayerVisible 1
        PanCameraToPosition 228, 220, 3        ; the pan names the view's top-left corner
        BeginCommandBatch
        SetEntityAnimation 9, 6
        NPCFireKiBlastAtEntity 11, 165, 100
        CommitCommandBatch
        PlayDamageEffect 165
        SetEntityAnimation 165, 6
        PlayDamageEffect 9
        WaitFrames 30
  text 0 "ANDROID 13: Ha!  The Dragon Balls brought your brother back...\x0band you came along too.  Just for me!"
  text 28 "ANDROID 17: Sis, get out of here!"
  text 29 "ANDROID 18: Not a chance.  We finish him together!"
  script                                 ; 13 absorbs 17
        WalkToPosition 165, 316, 316
        WhiteFlash 20
        PlayAudio 61
        DespawnEntity 9
        ScreenShake 0, 10, 30
        WaitFrames 40
  text 0 "ANDROID 13: Your power is mine!"
  script                                 ; then 18
        WalkToPosition 165, 384, 316
        WhiteFlash 20
        PlayAudio 61
        DespawnEntity 11
        ScreenShake 0, 10, 30
        WaitFrames 40
        WalkToPosition 165, 348, 300
        FadeToWhite 20
        PlayAudio 55
        DespawnEntity 165
        SpawnCharacterEntity 180, 348, 300
        SetEntityFacing 180, 0
        WaitFrames 30
        WhiteFadeOut 30
        ScreenShake 0, 20, 60
  text 122 "SUPER 13: Now...  I am complete!"
  script                                 ; who speaks for the players: some characters have their own line
        PanCameraToPosition 216, 300, 3
        PushActiveCharIndex
        PushByte 2
        CmpEq
        JumpIfFalse L1
        PushByte 9
        END
      L1:
        PushActiveCharIndex
        PushByte 5
        CmpEq
        JumpIfFalse L2
        PushByte 10
        END
      L2:
        PushActiveCharIndex
        PushByte 6
        CmpEq
        JumpIfFalse L3
        PushByte 11
        END
      L3:
        PushActiveCharIndex
        PushByte 1
        CmpEq
        JumpIfFalse L4
        PushByte 12
        END
      L4:
        PushByte 13
        END
  text 1 "Hmph.  Another tin can to scrap." -> 14
  text 1 "Uh...  is it too late to go home?" -> 14
  text 1 "18...  You'll pay for this!" -> 14
  text 1 "Careful.  He's stronger than Cell was." -> 14
  text 1 "We have to stop this!"
  script                                 ; [14] player 2 answers when there is one; alone, straight to the fight
        CoopCall 5, 0, 0, 0
        JumpIfFalse L1
        PushByte 15
        END
      L1:
        PushByte 16
        END
  fmt 0 "%s: Let's take him down together!"
        CoopCall 14, 2, 0, 0
        END
  script                                 ; the fight: the boss record (stat 145, sprite 180)
        PlayMusic 30                     ; a boss track (Broly's fight's)
        DespawnEntity 180
        TriggerMapEvent 11
        DrawBossHealthBar 180
        SetActiveEntity 0
end

sequence summit_13_end
  script                                 ; Super 13 explodes, and 17 and 18 with him (his own 96-frame explosion first)
        WaitFrames 100
        FindPlayerEntity
        SetPlayerVisible 1
        WhiteFlash 30
        PlayAudio 21
        ScreenShake 0, 30, 90
        PlayAudio 20
        WaitFrames 60
        FadeToWhite 30
        WaitFrames 30
        WhiteFadeOut 60
  text 106 "VEGETA: *spits*  At last.  The end of those clankers."
  script
        SetStoryFlag 382
        PlayMusic 5                      ; the summit's own music again
        PlayAudio 62
  text 0 "@^Journal Updated!"
end
