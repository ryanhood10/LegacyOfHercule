sequence summit_13_end
  script                                 ; Super 13 explodes, and 17 and 18 with him (his own 96-frame explosion first)
        WaitFrames 100
        FindPlayerEntity
        SetPlayerVisible 1
        WhiteFlash 30
        PlayAudio 21
        ScreenShake 0, 30, 90
        PlayAudio 20
        WaitFrames 60
        FadeToWhite 30
        CoopCall 22, 2, 137, 0                 ; behind the white, Vegeta's actor comes over from the rim to say it
        JumpIfFalse V1
        PushByte 137
        PushEntityPosition 0
        PushVarint 65536
        Div
        PushVarint 36
        Add
        PushEntityPosition 0
        PushEntityPosition 0
        PushVarint 65536
        Div
        PushVarint 65536
        Mul
        Sub
        PushVarint 6
        Sub
        Step SetEntityPositionInstant
        SetEntityFacing 137, 2
        SetEntityFacing 0, 3
      V1:
        WaitFrames 30
        WhiteFadeOut 60
  text 106 "VEGETA: *spits*  At last.  The end of those clankers."
  script
        SetStoryFlag 382
        PlayMusic 5                      ; the summit's own music again
        PlayAudio 62
  text 0 "@^Journal Updated!"
  script                                 ; back to Dende's Lookout (Ryan): below Dende, where the finale starts on arrival
        FadeOut 120
        WarpToMapWithEntities 9, 1, 1, 760, 448
end
