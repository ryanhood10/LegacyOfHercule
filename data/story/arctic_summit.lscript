        ; 13 absorbs 17: he is over him at once, a pulse, and 17 is gone
        CoopCall 37, 1, 165, 9
        CoopCall 37, 4, 16, 10
        WaitFrames 14
        WhiteFlash 6
        PlayAudio 61
        DespawnEntity 9
        ScreenShake 0, 10, 30
        SetEntityAnimation 165, 2              ; it doubles him over for a moment
        WaitFrames 10
        CoopCall 37, 12, 11, -3                ; he turns to her; so does everyone
        WaitFrames 20
  text 169 "ANDROID 13: This is for the Doc.\x0bYour power is mine!"
  script                                 ; 18's volley as he walks through it; he absorbs her; the transformation's three surges
        ; 18 does not wait her turn: on her feet, a volley of five into him; he comes out of the last burst at her side
        CoopCall 37, 1, 11, 165
        CoopCall 37, 8, 1, 5
        WaitFrames 16
        CoopCall 37, 1, 165, 11
        CoopCall 37, 4, 0, 10
        WaitFrames 14
