        CoopCall 22, 2, 137, 0
        JumpIfFalse af137
        SetEntityFacing 137, 2
      af137:
        CoopCall 22, 2, 132, 0
        JumpIfFalse af132
        SetEntityFacing 132, 2
      af132:
        SetEntityFacing 121, 2
        SetEntityFacing 156, 2
        ; a fight already under way: 17's two blows land and do nothing (no flash on 13), 13's one answer throws him back; 18's blast, and
        ; 13 walks out of its dust
        WalkToPosition 9, 322, 306
        SetEntityFacing 165, 2
        SetEntityAnimation 9, 6
        PlaySFX 165, 34
        SetEntityAnimation 9, 7
        PlaySFX 165, 35
        SetEntityAnimation 165, 6
        PlayDamageEffect 9
        PlaySFX 9, 36
        BeginCommandBatch
        SetEntityAnimation 9, 3
        GlideToPosition 9, 288, 322, 2500
        CommitCommandBatch
        SpawnDustCloud 9, 284, 326
        SetEntityFacing 9, 3
        BeginCommandBatch
        NPCFireKiBlastAtEntity 11, 165, 100
        CommitCommandBatch
        SpawnDustCloud 165, 344, 296
        SpawnDustCloud 165, 354, 304
        WaitFrames 24
        WalkToPosition 165, 348, 312
        SetEntityFacing 165, 0
        SetEntityAnimation 165, 5              ; he cracks his knuckles
  text 169 "ANDROID 13: Ha!  The Dragon Balls brought your brother back...\x0band you came along too.  Just for me!"
  script                                 ; 17 comes forward again
        WalkToPosition 9, 306, 318
        SetEntityFacing 9, 3
  text 28 "ANDROID 17: Sis, get out of here!"
  script                                 ; 18 steps up: both sides of him
        WalkToPosition 11, 390, 314
        SetEntityFacing 11, 2
  text 29 "ANDROID 18: Not a chance.  We finish him together!"
  script                                 ; they go in together; 13 throws 17 down, knocks 18 back, and absorbs 17
        ; they go in together; 13 takes both blows, throws 17 down and knocks 18 back
        BeginCommandBatch
        WalkToPosition 9, 326, 310
        WalkToPosition 11, 372, 308
        CommitCommandBatch
        BeginCommandBatch
        SetEntityAnimation 9, 6
        SetEntityAnimation 11, 6
        CommitCommandBatch
        PlaySFX 165, 34
        PlaySFX 165, 35
