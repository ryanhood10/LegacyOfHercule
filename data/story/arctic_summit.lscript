end

sequence summit_13_end
  script                                 ; Super 13 explodes, and 17 and 18 with him (his own 96-frame explosion first)
        WaitFrames 100
        FindPlayerEntity
        SetPlayerVisible 1
        WhiteFlash 30
        PlayAudio 21
        ScreenShake 0, 30, 90
        PlayAudio 20
        WaitFrames 60
        FadeToWhite 30
        WaitFrames 30
        CoopCall 22, 2, 121, 0                 ; Tien and Yamcha, thrown to the rim in the scene, are on their feet when the white lifts
        JumpIfFalse T1
        SetEntityAnimationNoWait 121, 0
        SetEntityFacing 121, 2
      T1:
        CoopCall 22, 2, 156, 0
        JumpIfFalse Y1
        SetEntityAnimationNoWait 156, 0
        SetEntityFacing 156, 2
      Y1:
        WhiteFadeOut 60
        CoopCall 22, 4, 2, 0                   ; Vegeta's line only when someone plays him (next 1), else 2
        JumpIfFalse V1
        PushByte 1
        END
      V1:
        PushByte 2
        END
  [1] text 106 "VEGETA: *spits*  At last.  The end of those clankers."
  [2] script
        SetStoryFlag 382
        PlayMusic 5                      ; the summit's own music again
        PlayAudio 62
  text 0 "@^Journal Updated!"
  script                                 ; back to Dende's Lookout (Ryan): below Dende, where the finale starts on arrival
        FadeOut 120
        WarpToMapWithEntities 9, 1, 1, 760, 448
end
