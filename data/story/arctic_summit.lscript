      b72:
        CoopCall 22, 2, 137, 0
        JumpIfFalse b137
        WalkToPosition 137, 472, 250
      b137:
        CoopCall 22, 2, 132, 0
        JumpIfFalse b132
        WalkToPosition 132, 454, 280
      b132:
        CommitCommandBatch
        CoopCall 22, 2, 103, 0
        JumpIfFalse bf103
        SetEntityFacing 103, 3
      bf103:
        CoopCall 22, 2, 56, 0
        JumpIfFalse bf56
        SetEntityFacing 56, 3
