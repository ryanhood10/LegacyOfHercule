        SetEntityAnimationNoWait 121, 3
        SetEntityAnimationNoWait 156, 3
        SpawnDustCloud 121, 526, 384
        SpawnDustCloud 156, 526, 434
        WaitFrames 24
        SetEntityFacing 180, 0
  text 122 "SUPER 13: Look at me.  Even Cell would tremble!"
  script                                 ; [16] the players' lines (they are in the view already: no pan down)
        ; who speaks for the players: some characters have their own line; player 1 takes a step toward him (Hercule: a step back)
        PushActiveCharIndex
        PushByte 2
        CmpEq
        JumpIfFalse L1
        WalkToPosition 0, 324, 366
        SetEntityFacing 0, 1
        PushByte 17
        END
      L1:
        PushActiveCharIndex
        PushByte 5
        CmpEq
        JumpIfFalse L2
        WalkToPosition 0, 324, 386
        SetEntityFacing 0, 1
        PushByte 18
        END
      L2:
        PushActiveCharIndex
        PushByte 6
        CmpEq
        JumpIfFalse L3
        WalkToPosition 0, 324, 366
        SetEntityFacing 0, 1
        PushByte 19
        END
      L3:
        PushActiveCharIndex
        PushByte 1
        CmpEq
        JumpIfFalse L4
        WalkToPosition 0, 324, 366
        SetEntityFacing 0, 1
        PushByte 20
        END
      L4:
        WalkToPosition 0, 324, 366
        SetEntityFacing 0, 1
        PushByte 21
        END
  text 106 "VEGETA: Hmph.  Another tin can to scrap." -> 22
  text 67 "HERCULE: Uh...  is it too late to go home?" -> 22
  text 73 "KRILLIN: 18...  You'll pay for this!" -> 22
  text 90 "PICCOLO: Careful.  He's stronger than Cell was." -> 22
  text 1 "We have to stop this!"
  script                                 ; [22] player 2 answers when there is one; alone, straight to the fight
        CoopCall 5, 0, 0, 0
        JumpIfFalse L1
        PushByte 23
        END
      L1:
        PushByte 24
        END
  fmt 0 "%s: Let's take him down together!"
        CoopCall 14, 2, 0, 0
        END
  script                                 ; the fight: the boss record (stat 145, sprite 180); the party's watchers clear the field (Tien and Yamcha lie at the rim)
        BeginCommandBatch
        CoopCall 22, 2, 103, 0
