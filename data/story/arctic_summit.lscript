; The Arctic summit (zone 15 area 8, docs/story.md 4i): Android 13, 17 and 18 fighting when the players arrive, 13
; absorbs 17 then 18 and becomes Super 13, the players say they have to stop him, the fight, the explosion, Vegeta's
; "clankers", then back to the Lookout (postgame's arrival trigger plays the finale). Built into the map by tools/mapbuild.py from data/maps/arctic_summit.json ("sources").
; Speakers: 0 narration (13 has no portrait), 1 player 1's character, 28 Android 17, 29 Android 18, 106 Vegeta.
; Super 13: sprite 180, stat 145, portrait 122 (src/coop/super13.c, tools/super13sprites.py).

; ---- conditions --------------------------------------------------------------------------------------
script summit_on                                 ; the post-game's Arctic is open and Super 13 still stands
    StackTestStoryFlag 381
    StackTestStoryFlagNot 382
    And
end

; a sideline watcher of the party never stands now: a party member nobody plays is not in the scene (Ryan, 2026-11-05;
; docs/howto.md "Stage a scene" rule 2), and one who is played is a player. Tien and Yamcha (records with summit_on) stay.
; The scene's steps on the watchers' sprites stay guarded by CoopCall 22 op 2.
script watch_gohan
    PushByte 0
end

script watch_piccolo
    PushByte 0
end

script watch_vegeta
    PushByte 0
end

script watch_trunks
    PushByte 0
end

script watch_hercule
    PushByte 0
end

script watch_krillin
    PushByte 0
end

; ---- the scene ---------------------------------------------------------------------------------------
sequence summit_scene
  script                                 ; the players walk into the view; a retry's short form; else 13 against 17 and 18, a fight already under way
        SetPlayerVisible 1
        ; the players come into the picture (docs/cutscenes/batch3 0, 6.2 beat 1): they stood below the view for the whole scene. Player 1
        ; walks up to the view's bottom edge, player 2 beside him (by C: never a sprite step on a player), both facing the three
        WalkToPosition 0, 324, 372
        SetEntityFacing 0, 1
        CoopCall 9, 1, 350, 372
        PanCameraToPosition 228, 220, 3        ; the pan names the view's top-left corner
        ; a retry (a loss, a reload at the ridge pad) in the same session plays the short form: he stands transformed, his last line, the
        ; players' lines. A bit in RAM, not a flag (CoopCall 16 on 5 / 6, cellgames.c): a save made at the pad must not know
        CoopCall 16, 0, 6, 0
        JumpIfFalse FULL
        FadeToWhite 12
        DespawnEntity 9
        DespawnEntity 11
        DespawnEntity 165
        SpawnCharacterEntity 180, 348, 300
        SetEntityFacing 180, 0
        SetEntityPositionInstant 121, 530, 380
        SetEntityPositionInstant 156, 530, 430
        SetEntityAnimationNoWait 121, 3
        SetEntityAnimationNoWait 156, 3
        PlayMusic 30
        WhiteFadeOut 30
        ScreenShake 0, 12, 40
        WaitFrames 40
        PushByte 15
        END
      FULL:
        CoopCall 16, 0, 5, 1
        ; a fight already under way (the cinematic helpers, CoopCall 37: docs/cutscenes.md 5): 17 and 13 trade a flurry, queued in the batch so
        ; that the others run in from the rim to the view's edges while it plays (Ryan, 2026-11-05: no stagnant characters)
        BeginCommandBatch
        CoopCall 22, 2, 103, 0
        JumpIfFalse a103
        WalkToPosition 103, 240, 250
      a103:
        CoopCall 22, 2, 56, 0
        JumpIfFalse a56
        WalkToPosition 56, 258, 280
      a56:
        CoopCall 22, 2, 76, 0
        JumpIfFalse a76
        WalkToPosition 76, 240, 300
      a76:
        CoopCall 22, 2, 72, 0
        JumpIfFalse a72
        WalkToPosition 72, 232, 330
      a72:
        CoopCall 22, 2, 137, 0
        JumpIfFalse a137
        WalkToPosition 137, 456, 250
      a137:
        CoopCall 22, 2, 132, 0
        JumpIfFalse a132
        WalkToPosition 132, 438, 280
      a132:
        WalkToPosition 121, 456, 300
        WalkToPosition 156, 440, 328
        CoopCall 37, 1, 9, 165
        CoopCall 37, 6, 90, 2
        CommitCommandBatch
        CoopCall 22, 2, 103, 0
        JumpIfFalse af103
        SetEntityFacing 103, 3
      af103:
        CoopCall 22, 2, 56, 0
        JumpIfFalse af56
        SetEntityFacing 56, 3
      af56:
        CoopCall 22, 2, 76, 0
        JumpIfFalse af76
        SetEntityFacing 76, 3
      af76:
        CoopCall 22, 2, 72, 0
        JumpIfFalse af72
        SetEntityFacing 72, 3
      af72:
        CoopCall 22, 2, 137, 0
        JumpIfFalse af137
        SetEntityFacing 137, 2
      af137:
        CoopCall 22, 2, 132, 0
        JumpIfFalse af132
        SetEntityFacing 132, 2
      af132:
        SetEntityFacing 121, 2
        SetEntityFacing 156, 2
        ; (the flurry above, CoopCall 37 op 6: 13 ends it with the blow that throws 17 down) 18's blast bursts on him; he powers up before he speaks
        CoopCall 37, 1, 11, 165
        CoopCall 37, 8, 0, 0
        WaitFrames 10
        SetEntityFacing 165, 0
        CoopCall 37, 1, 165, -3
        CoopCall 37, 7, 30, 0
        CoopCall 37, 11, 165, -3               ; they all look at him
  text 169 "ANDROID 13: Ha!  The Dragon Balls brought your brother back...\x0band you came along too.  Just for me!"
  script                                 ; 17 gets up; they look at him, he looks at his sister
        CoopCall 37, 1, 9, 11
        CoopCall 37, 10, 0, 0
        CoopCall 37, 11, 9, 11
  text 28 "ANDROID 17: Sis, get out of here!"
  script                                 ; 18 steps up: both sides of him
        WalkToPosition 11, 390, 314
        SetEntityFacing 11, 2
        CoopCall 37, 11, 11, 165
  text 29 "ANDROID 18: Not a chance.  We finish him together!"
  script                                 ; they go in together; 13 throws 17 down, knocks 18 back, and absorbs 17
        ; they go in together: each vanishes and is at his side with a blow; 13 throws 17 down and sends 18 back onto a knee
        CoopCall 37, 1, 9, 165
        CoopCall 37, 4, 1, 4
        CoopCall 37, 1, 11, 165
        CoopCall 37, 4, 2, 4
        CoopCall 37, 5, 2, 0
        CoopCall 37, 1, 9, 165
        CoopCall 37, 5, 0, 0
        CoopCall 37, 1, 165, 9
        CoopCall 37, 5, 1, 44
        CoopCall 37, 1, 165, 11
