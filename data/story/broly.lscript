        PushByte 6
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 6
        CmpNe
        And
        JumpIfFalse N28
        DespawnEntity 76
      N28:
        CoopCall 10, 1, 0, 0             ; the party as before the trip; pushes player 1's slot
        Step SetActiveCharacter
        CoopCall 10, 2, 0, 0             ; player 2 as before the trip
        SetPlayerVisible 1
        SetActiveEntity 0
        ReloadMap
        FadeFromWhite 60
end
