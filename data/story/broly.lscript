; The Broly side chapter of the ten-day wait (docs/story.md 4g "Broly side chapter"), applied by
; data/story/broly.json (Capsule Corp maps) and data/maps/broly_arena.json (zone 15 area 3, which names
; this file in "sources"). Only who is played is in a scene (Ryan, 2026-11-05): the trip's others have no
; actors and their lines play only when someone plays them (CoopCall 22 op 4); Paragus, Broly and Bulma are the
; story's. A script step on a sprite with no entity writes through a null pointer: Vegeta's actor is guarded.
;
; Right after Cell's TV broadcast Bulma walks in: a Saiyan ship has landed in the backyard for Vegeta
; (flag 400). In the backyard (zone 6 area 21), with Vegeta as a player, Paragus steps out of the ship
; and offers him New Planet Vegeta; whoever plays Trunks, Krillin, Gohan or Piccolo speaks up; the players board through the
; ship's door, the ship shakes through the flight and lands (flag 401; the party's state is kept in flags 404-419 by CoopCall 10 and the trip's five
; are selectable, Hercule stays home). The arena (zone 15 area 3) has the landing zone with the ship (no
; save pad: there is no way back until Broly falls); crossing the basin's rim brings everyone on screen for Paragus' betrayal and Broly
; (sprite 159, waiting in the basin), then players 1 and 2 fight Broly (stat 115) and Paragus (stat
; 116, sprite 170) as a pair (bosses.c): if Paragus falls first Broly rages once (full HP, stronger,
; faster; the rage dialogue set by CoopCall 9). Both down: the planet explodes, Capsule Corp's backyard,
; everyone talks it over, fade to black, the party as before the trip (flag 402).
; Flags: 377 aboard allowed (Paragus' offer taken), 378 landed on New Planet Vegeta, 400 ship arrived, 401 trip
; under way, 402 chapter done, 403 confrontation seen, 404-419 the kept
; party (vmcall.c PartyKeep). Speakers: 0 narration (Broly has no portrait), 2 Gohan, 3 Piccolo,
; 4 Vegeta, 5 Trunks (party slots 0-3: their current portraits), 36 Bulma, 73 Krillin, 120 Paragus
; (tools/brolysprites.py).

; ---- zone 6 area 16: Cell's broadcast, then Bulma's news ------------------------------------------

; stock entries 0-8 keep their indexes (entry 6 returns 8 absolutely); Bulma's lines are appended as
; 9-11 and run between the broadcast's last line (5) and its closing script (6)
sequence broly_tv
  stockseq @083d1534 0 4                 ; Cell: "I am Cell...", the Cell Games in nine days
  stock @083d14ec -> 9                   ; "Now, let the games begin!"
  stock @083d150a                        ; stock 6: flag 157; Goku and Gohan's scene next when flag 156
  stop 0x0
  stock @083d152c                        ; stock 8: jump to "Meanwhile..."
  script
        SpawnCharacterEntity 24, 240, 256
        WalkToPosition 24, 240, 136
        SetEntityFacing 24, 1
        PlayAudio 50
  text 36 "BULMA: Hey, everybody!  A spaceship just landed in our backyard!\x0bIt looks like a Saiyan ship...  Somebody tell Vegeta.\x0bI think it's here for him."
  script -> 6
        WalkToPosition 24, 240, 256
        DespawnEntity 24
        SetStoryFlag 400
end

; ---- conditions -----------------------------------------------------------------------------------

; the ship stands in the backyard from Bulma's news until it leaves
script broly_ship_cond
        StackTestStoryFlag 400
        StackTestStoryFlagNot 401
        And
end

; the trip is under way (the arena's ship and Broly, the rim trigger)
script broly_trip_cond
        StackTestStoryFlag 401
        StackTestStoryFlagNot 402
        And
end

; ---- zone 6 area 21: the backyard ----------------------------------------------------------------

sequence broly_yard
  script                                 ; Vegeta is player 1 or player 2: the scene (3), else a hint (1); seen (377): nothing
        StackTestStoryFlag 377
        JumpIfFalse L0
        PushByte 2
        END
      L0:
        PushActiveCharIndex
        PushByte 2
        CmpEq
        CoopCall 8, 0, 0, 0
        PushByte 2
        CmpEq
        Add
        JumpIfFalse L1
        PushByte 3
        END
      L1:
        PushByte 1
        END
  text 0 "@^A round ship with Saiyan markings sits on the patio, humming quietly.\x0bVegeta should see this."
  stop 0x0
  script
        SetPlayerVisible 0
        PlayMusic 39
        WalkToPosition 0, 240, 452       ; the lawn in front of the ship, left of its door
        SetEntityFacing 0, 3
        CoopCall 9, 1, 208, 452
        PanCameraToPosition 128, 344, 2
        WaitFrames 30
        PlayAudio 50
        SpawnCharacterEntity 170, 344, 412  ; Paragus steps out of the ship's door and down its ramp
        WalkToPosition 170, 344, 456
        WalkToPosition 170, 288, 456
        SetEntityFacing 170, 2
        WaitFrames 20
  text 120 "PARAGUS: Prince Vegeta...  At last I have found you."
  text 4 "VEGETA: That armor...  You're a Saiyan!  Who are you?"
  text 120 "PARAGUS: My name is Paragus.\x0bI served your father, King Vegeta, before Frieza destroyed our world."
  text 120 "PARAGUS: I have found a new home for our people, my prince.  A New Planet Vegeta.\x0bIt has everything a Saiyan could want...  except a king."
  text 4 "VEGETA: A planet of my own...  Hmph.\x0bA prince belongs on a throne, not guarding this mud ball."
  [9] script
        CoopCall 22, 4, 3, 0
        JumpIfFalse skip
        PushByte 10
        END
      skip:
        PushByte 11
        END
  [10] text 5 "TRUNKS: Father, wait!  You can't just fly off with a stranger!\x0bWe don't know anything about this man!"
  [11] script
        CoopCall 22, 4, 6, 0
        JumpIfFalse skip
        PushByte 12
        END
      skip:
        PushByte 13
        END
  [12] text 73 "KRILLIN: A brand-new Planet Vegeta, out of nowhere?  This smells like a trap to me..."
  [13] script
        CoopCall 22, 4, 1, 0
        JumpIfFalse skip
        PushByte 14
        END
      skip:
        PushByte 15
        END
  [14] text 3 "PICCOLO: Then we all go.  If it's a trap, we spring it together."
  [15] script
        CoopCall 22, 4, 0, 0
        JumpIfFalse skip
        PushByte 16
        END
      skip:
        PushByte 17
        END
  [16] text 2 "GOHAN: I'm coming too!"
  [17] script
        CoopCall 22, 4, 3, 0
        CoopCall 22, 4, 6, 0
        Not
        CoopCall 22, 4, 1, 0
        Not
        CoopCall 22, 4, 0, 0
        Not
        JumpIfFalse skip
        PushByte 18
        END
      skip:
        PushByte 19
        END
  [18] text 120 "PARAGUS: ...As you wish.  All are welcome.  Come, my king."
  [19] script  ; Vegeta alone (draft)
        CoopCall 22, 4, 3, 0
        CoopCall 22, 4, 6, 0
        Not
        CoopCall 22, 4, 1, 0
        Not
        CoopCall 22, 4, 0, 0
        Not
        PushByte 0
        CmpEq
        JumpIfFalse skip
        PushByte 20
        END
      skip:
        PushByte 21
        END
  [20] text 120 "PARAGUS: Then come, my king.  Your people are waiting."
  [21] script  ; Paragus goes back in; the players board through the ship's door themselves (broly_board)
        WalkToPosition 170, 344, 456
        WalkToPosition 170, 344, 412
        DespawnEntity 170
        SetStoryFlag 377
        SetPlayerVisible 1
        SetActiveEntity 0
end

; ---- the ship (Ryan, 2026-10-20 / 21): board through its door, the flight inside it, the landing ----------
; The ship is map art (tools/shipart.py, 256 x 160: the backyard's variation while it is parked, data/maps/
; yard_ship.json + src/coop/shipyard.c; painted into New Planet Vegeta's landing zone, broly_arena.json), with an
; open door and a ramp at its front. Walking up the ramp into the doorway (the backyard's trigger there) takes
; the players inside once Paragus' offer is taken (flag 377; before that the hatch's line) (zone 15 area 9,
; data/maps/saiyan_ship.json: Buu's Fury's round room, its Capsule Corp pad cleared) for the flight: the ship
; shakes for a few seconds while nobody moves, then lands (flag 378); the room's door then leads out of the
; ship's door onto New Planet Vegeta. After Broly the ride home plays in the same room (broly_end) and its door
; leads out of the ship's door into the backyard (broly_home_out, flag 379), where the others wait.

; the ship stands in the backyard from Bulma's news on, except while it is away (it flew the players home)
script broly_ship_shown_cond
    StackTestStoryFlag 400
    StackTestStoryFlagNot 401
    StackTestStoryFlag 402
    Not
    And
    END
end

; the ride home landed, the players not yet out (the room's door: the backyard)
script broly_home_cond
    StackTestStoryFlag 402
    StackTestStoryFlagNot 379
    And
    END
end

sequence broly_board
  script                                 ; Paragus' offer taken (377): aboard (3), else the hatch (1)
        StackTestStoryFlag 377
        JumpIfFalse B1
        PushByte 3
        END
      B1:
        PushByte 1
        END
  text 0 "@^The ship's hatch stands open.  Whoever flew it here can't be far..."
  stop 0x0
  script                                 ; aboard: the trip's party, then inside the ship
        SetPlayerVisible 0
        FadeOut 60
        SetStoryFlag 401
        CoopCall 10, 0, 0, 0             ; keep the party as it is (flags 404-419) for the way home
        SetCharacterInPartyFlag 0
        SetCharacterFlag_Bit1 0
        SetCharacterFlag_Bit1 1
        SetCharacterFlag_Bit1 2
        SetCharacterFlag_Bit1 3
        SetCharacterFlag_Bit1 6
        ClearCharacterFlag_Bit1 4
        ClearCharacterFlag_Bit1 5
        ClearCharacterFlag_Bit1 7
        SetActiveCharacter 2
        WarpToMapWithEntities 15, 9, 1, 96, 192
        CoopCall 6, 3, 0, 0                ; player 2 (kept across the warp) plays Trunks
        CoopCall 9, 1, 128, 196
        SetEntityFacing 0, 0
        SpawnCharacterEntity 170, 120, 92  ; Paragus rides along (Ryan, 2026-10-21); the others only as players (Ryan, 2026-11-05)
        SetEntityFacing 170, 0
        SetPlayerVisible 1
        WaitFrames 40
        PlayAudio 26
        ScreenShake 0, 8, 200
        WaitFrames 60
  text 0 "@^The ship blasts off for New Planet Vegeta..."
  script                                 ; the flight: nobody moves while it shakes
        PlayAudio 26
        ScreenShake 0, 12, 200
        WaitFrames 170
        ScreenShake 0, 5, 60
        WaitFrames 70
        PlayAudio 50
        SetStoryFlag 378
  text 0 "@^The ship lands."
  script                                 ; Paragus gets off first, out of the room's door
        WaitFrames 20
        WalkToPosition 170, 120, 60
        DespawnEntity 170
        SetActiveEntity 0
end

sequence broly_ship_out
  script                                 ; out of the ship's door and down its ramp: New Planet Vegeta
        SetPlayerVisible 0
        FadeOut 60
        WarpToMapWithEntities 15, 3, 1, 320, 632
        CoopCall 6, 3, 0, 0
        CoopCall 9, 1, 352, 684            ; player 2 already down the ramp
        SetEntityFacing 0, 0
        PanCameraToPosition 200, 600, 8  ; the ship's door, its ramp and Paragus at its foot, above the text box
        SpawnCharacterEntity 170, 256, 680
        SetEntityFacing 170, 3
        FadeFromWhite 60
        PlayAudio 50
        WalkToPosition 0, 320, 680
        SetEntityFacing 0, 2
  text 120 "PARAGUS: Welcome to New Planet Vegeta, my king.\x0bYour people await you beyond that ridge.  Come."
  text 4 "VEGETA: Hmph.  Lead the way, old man."
  script
        BeginCommandBatch                ; Paragus around the ship, up to the basin's rim
        WalkToPosition 170, 176, 680
        CommitCommandBatch
        BeginCommandBatch
        WalkToPosition 170, 176, 520
        CommitCommandBatch
        WaitFrames 10
        DespawnEntity 170

        SetPlayerVisible 1
        SetActiveEntity 0
end

; ---- zone 15 area 3: New Planet Vegeta ------------------------------------------------------------

; Only who is played is in a scene (Ryan, 2026-11-05; docs/howto.md "Stage a scene" rule 2): the trip's others (Trunks, Gohan, Piccolo,
; Krillin) have no actors; a line of one nobody plays is skipped, or said by player 1 (speaker 250) where the scene needs it. Kept for the
; plot: Vegeta at the rim when nobody plays him (Paragus' betrayal and Broly are his). CoopCall 22 op 4: 1 = played.
sequence broly_rim
  [0] script                             ; seen before (flag 403): straight to the fight (the last entry, 18)
        StackTestStoryFlag 403
        JumpIfFalse L1
        PushByte 18
        END
      L1:
        PushByte 1
        END
  [1] script  ; Paragus comes round the rim from above; Vegeta's actor runs up from the left when nobody plays him (kept: the scene is his).
        SetPlayerVisible 0               ; The basin is empty: Broly waits out of view to the east (he strolled in beside them before)
        PlayMusic 39
        SetEntityPositionInstant 159, 520, 404
        SetEntityFacing 159, 3
        WalkToPosition 0, 326, 414
        SetEntityFacing 0, 3
        CoopCall 9, 1, 284, 400
        PanCameraToPosition 212, 330, 2
        SpawnCharacterEntity 170, 360, 310
        CoopCall 22, 1, 2, 0
        JumpIfFalse N9
        SpawnCharacterEntity 137, 190, 426
      N9:
        BeginCommandBatch
        WalkToPosition 170, 384, 380
        CoopCall 22, 2, 137, 0
        JumpIfFalse W1
        WalkToPosition 137, 352, 400
      W1:
        CommitCommandBatch
        SetEntityFacing 170, 2
        CoopCall 22, 2, 137, 0
        JumpIfFalse F1
        SetEntityFacing 137, 3
      F1:
        WaitFrames 30
  [2] text 4 "VEGETA: Paragus!  What is this?  Where are my people?"
  [3] text 120 "PARAGUS: Your people?  There are none, Prince.  There is no kingdom.\x0bThis planet is a graveyard...  and it is about to become yours."
  [4] text 120 "PARAGUS: Your father sentenced my son to death as an infant because his power dwarfed yours.\x0bWe survived.  Now meet him.  Broly!"
  [5] script  ; power before the body: Paragus turns to the basin; the ground shudders, dust at their feet; everyone looks east and the
        SetEntityFacing 170, 3           ; camera goes there: Broly, his back to them. He powers up (green light with the white), the
        PlayAudio 43                     ; players are pushed back; silence; he turns his head, then round
        BeginCommandBatch
        ScreenShake 0, 6, 40
        ScreenShake 0, 12, 40
        EntityWaitFrames 170, 30
        SpawnDustCloud 170, 318, 420
        SpawnDustCloud 170, 344, 408
        CommitCommandBatch
        StopAudio 43
        SetEntityPositionInstant 159, 456, 404
        CoopCall 37, 2, 456, 404
        CoopCall 37, 12, -2, -3
        PanCameraToPosition 268, 330, 1
        CoopCall 37, 1, 159, -3
        BeginCommandBatch
        CoopCall 37, 7, 90, 2
        EntityWaitFrames 170, 24
        FlashScreenColor 170, 150, 255, 170, 8
        EntityWaitFrames 170, 16
        FlashScreenColor 170, 150, 255, 170, 8
        EntityWaitFrames 170, 12
        FlashScreenColor 170, 150, 255, 170, 8
        SpawnDustCloud 170, 432, 412
        SpawnDustCloud 170, 480, 412
        SpawnDustCloud 170, 456, 424
        EntityWaitFrames 0, 70
        GlideToPosition 0, 318, 414, 80
        CommitCommandBatch
        SetEntityAnimation 159, 0
        SetEntityFacing 159, 3
        WaitFrames 30
        SetEntityFacing 159, 0
        WaitFrames 24
        SetEntityFacing 159, 2
        WaitFrames 10
        PlayAudio 50
  [6] text 0 "BROLY: ...Ka...  ka...  rot..."          ; the stock words in a bottom box (the centred caption half covered him)
  [7] script
        CoopCall 22, 4, 0, 0
        JumpIfFalse skip
        PushByte 8
        END
      skip:
        PushByte 9
        END
  [8] text 2 "GOHAN: Kakarot?  That's my dad's Saiyan name!  He thinks I'm...?"
  [9] script
        CoopCall 22, 4, 1, 0
        JumpIfFalse skip
        PushByte 10
        END
      skip:
        PushByte 11
        END
  [10] text 3 "PICCOLO: His power is off the charts...  Everyone, stay sharp!"
  [11] script  ; Vegeta backs away a step
        CoopCall 22, 2, 137, 0
        JumpIfFalse V1
        WalkToPosition 137, 338, 400
        SetEntityFacing 137, 3
      V1:
        PushActiveCharIndex
        PushByte 2
        CmpEq
        JumpIfFalse V2
        WalkToPosition 0, 306, 414
        SetEntityFacing 0, 3
      V2:
  [12] text 4 "VEGETA: The Legendary Super Saiyan...  It can't be..."
  [13] script
        CoopCall 22, 4, 3, 0
        JumpIfFalse skip
        PushByte 14
        END
      skip:
        PushByte 15
        END
  [14] text 5 "TRUNKS: Father, snap out of it!  We have to fight!"
  [15] script  ; the roar: a flash and the ground heaves before it
        WhiteFlash 8
        ScreenShake 0, 24, 40
  [16] text 0 "BROLY: KAKAROOOOT!!"
  [17] script  ; he is in front of them in a blink and his fist goes into the ground at their feet: dust, the players thrown back a step. He does
        SetStoryFlag 403                 ; not touch them: the fight is theirs. Paragus goes to his son's side through the dust, to the spot
        CoopCall 37, 2, 372, 416         ; his boss twin takes (TWIN_OFFSET right of Broly); Vegeta's actor steps out
        CoopCall 37, 1, 159, -2
        CoopCall 37, 3, 400, 414
        BeginCommandBatch
        CoopCall 37, 5, 1, 0
        EntityWaitFrames 170, 14
        SpawnDustCloud 170, 360, 420
        SpawnDustCloud 170, 376, 404
        SpawnDustCloud 170, 384, 426
        EntityWaitFrames 0, 14
        GlideToPosition 0, 298, 414, 150
        CommitCommandBatch
        SetEntityAnimation 159, 0
        SetEntityFacing 159, 2
        PanCameraToPosition 212, 330, 4
        BeginCommandBatch
        WalkToPosition 170, 424, 414
        CoopCall 22, 2, 137, 0
        JumpIfFalse W1
        WalkToPosition 137, 190, 426
      W1:
        CommitCommandBatch
        DespawnEntity 170
        CoopCall 22, 2, 137, 0
        JumpIfFalse D1
        DespawnEntity 137
      D1:
  [18] script
        PlayMusic 30
        CoopCall 37, 0, 0, 0
        CoopCall 9, 0, seq:broly_rage, 0
        DespawnCharacterAndRecordPosition 159, 2
        SetPlayerVisible 1
        DrawBossHealthBar 159
        SetActiveEntity 0
end

; Paragus fell while Broly stands (bosses.c BOSS_RAGE; queued by enemies.c)
sequence broly_rage
  script
        WhiteFlash 5
        ScreenShake 0, 20, 40
        PlayAudio 50
  text 0 "@^BROLY: Pa...  ra...  gus...?"
  text 0 "@^BROLY: RRRAAAAAAAAAGH!!"
  script
        WhiteFlash 5
        ScreenShake 0, 20, 60
  text 0 "@^Broly's power explodes!  He is stronger and faster than ever!"
end

; both down: the planet blows, home to Capsule Corp, the party as it was before the trip
sequence broly_end
  script
        PlayAudio 60
        FindPlayerEntity
        AddEXP 20000
        SetStoryFlag 402
        SetPlayerVisible 0
        WaitFrames 40
  text 0 "@^BROLY: KAKAROOOOOOT!!"
  script
        WhiteFlash 5
        BeginCommandBatch
        ScreenShake 0, 20, 30
        PlaySFX 159, 31
        PlayDamageEffect 159
        CommitCommandBatch
        WaitFrames 20
        WhiteFlash 5
        ScreenShake 0, 20, 40
        PlaySFX 159, 20
        WaitFrames 20
  [3] script
        CoopCall 22, 4, 2, 0
        JumpIfFalse skip
        PushByte 4
        END
      skip:
        PushByte 5
        END
  [4] text 4 "VEGETA: His power is tearing the whole planet apart!  Everyone, back to the ship!"
  [5] script  ; nobody plays Vegeta: player 1 says it
        CoopCall 22, 4, 2, 0
        PushByte 0
        CmpEq
        JumpIfFalse skip
        PushByte 6
        END
      skip:
        PushByte 7
        END
  [6] fmt 250 "%s: His power is tearing the whole planet apart!  Everyone, back to the ship!"
        PushActiveCharNameUpper
        END
  [7] script  ; back aboard: the ride home (Ryan), the players only
        BeginCommandBatch
        ScreenShake 0, 20, 80
        PlaySFX 159, 21
        CommitCommandBatch
        WaitFrames 20
        WhiteFlash 5
        ScreenShake 0, 20, 80
        PlaySFX 159, 31
        PlayAudioBlocking 10, 20
        FadeToWhite 10
        WhiteFadeOut 20
        WaitFrames 60
        WarpToMapWithEntities 15, 9, 1, 96, 192
        CoopCall 9, 1, 128, 196
        SetEntityFacing 0, 0
        SetPlayerVisible 1
        WaitFrames 30
        PlayAudio 26
        ScreenShake 0, 12, 200
        WaitFrames 60
  [8] text 0 "@^The ship escapes the exploding planet and heads home..."
  [9] script
        PlayAudio 26
        ScreenShake 0, 8, 160
        WaitFrames 150
        PlayAudio 50
  [10] text 0 "@^The ship lands back at Capsule Corp."
  [11] script  ; the players walk out of the room's door themselves (broly_home_out)
        WaitFrames 20
        SetActiveEntity 0
end

sequence broly_home_out
  [0] script  ; out of the ship's door and down its ramp: home, Bulma coming to meet them
        SetPlayerVisible 0
        FadeOut 60
        SetStoryFlag 379
        WarpToMapWithEntities 6, 21, 1, 344, 412
        SetEntityFacing 0, 0
        CoopCall 9, 1, 376, 476
        SpawnCharacterEntity 24, 248, 462
        SetEntityFacing 24, 3
        PlayMusic 41
        FadeFromWhite 60
        BeginCommandBatch
        WalkToPosition 0, 344, 456
        WalkToPosition 24, 316, 458
        CommitCommandBatch
        SetEntityFacing 0, 2
        SetEntityFacing 24, 3
  [1] text 36 "BULMA: You're back!  What happened out there?"
  [2] script
        CoopCall 22, 4, 6, 0
        JumpIfFalse skip
        PushByte 3
        END
      skip:
        PushByte 4
        END
  [3] text 73 "KRILLIN: Long story.  New Planet Vegeta was a trap...\x0band the guy waiting for us there was a monster."
  [4] script  ; nobody plays Krillin: player 1 answers her
        CoopCall 22, 4, 6, 0
        PushByte 0
        CmpEq
        JumpIfFalse skip
        PushByte 5
        END
      skip:
        PushByte 6
        END
  [5] fmt 250 "%s: Long story.  New Planet Vegeta was a trap...\x0band the guy waiting for us there was a monster."
        PushActiveCharNameUpper
        END
  [6] script
        CoopCall 22, 4, 0, 0
        JumpIfFalse skip
        PushByte 7
        END
      skip:
        PushByte 8
        END
  [7] text 2 "GOHAN: He kept calling me Kakarot.  He really hated my dad."
  [8] script
        CoopCall 22, 4, 3, 0
        JumpIfFalse skip
        PushByte 9
        END
      skip:
        PushByte 10
        END
  [9] text 5 "TRUNKS: If that's what a Legendary Super Saiyan is like...\x0bI hope we never meet another one."
  [10] script
        CoopCall 22, 4, 1, 0
        JumpIfFalse skip
        PushByte 11
        END
      skip:
        PushByte 12
        END
  [11] text 3 "PICCOLO: Then we keep training.  Something worse is always coming."
  [12] script
        CoopCall 22, 4, 2, 0
        JumpIfFalse skip
        PushByte 13
        END
      skip:
        PushByte 14
        END
  [13] text 4 "VEGETA: Hmph.  A Legendary Super Saiyan...  and I sent him to the grave.  Remember that."
  [14] script  ; the party as before the trip (CoopCall 10 op 1 pushes player 1's slot), player 2 too
        FadeOut 120
        WaitFrames 60
        DespawnEntity 24
        CoopCall 10, 1, 0, 0
        Step SetActiveCharacter
        CoopCall 10, 2, 0, 0
        SetPlayerVisible 1
        SetActiveEntity 0
        ReloadMap
        FadeFromWhite 60
end
