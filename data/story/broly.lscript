end

; Paragus fell while Broly stands (bosses.c BOSS_RAGE; queued by enemies.c)
sequence broly_rage
  script
        WhiteFlash 5
        ScreenShake 0, 20, 40
        PlayAudio 50
  text 0 "@^BROLY: Pa...  ra...  gus...?"
  text 0 "@^BROLY: RRRAAAAAAAAAGH!!"
  script
        WhiteFlash 5
        ScreenShake 0, 20, 60
  text 0 "@^Broly's power explodes!  He is stronger and faster than ever!"
end

; both down: the planet blows, home to Capsule Corp, the party as it was before the trip
sequence broly_end
  script
        PlayAudio 60
        FindPlayerEntity
        AddEXP 20000
        SetStoryFlag 402
        SetPlayerVisible 0
        WaitFrames 40
  text 0 "@^BROLY: KAKAROOOOOOT!!"
  script
        WhiteFlash 5
        BeginCommandBatch
        ScreenShake 0, 20, 30
        PlaySFX 159, 31
        PlayDamageEffect 159
        CommitCommandBatch
        WaitFrames 20
        WhiteFlash 5
        ScreenShake 0, 20, 40
        PlaySFX 159, 20
        WaitFrames 20
  text 4 "VEGETA: His power is tearing the whole planet apart!  Everyone, back to the ship!"
  script
        BeginCommandBatch
        ScreenShake 0, 20, 80
        PlaySFX 159, 21
        CommitCommandBatch
        WaitFrames 20
        WhiteFlash 5
        ScreenShake 0, 20, 80
        PlaySFX 159, 31
        PlayAudioBlocking 10, 20
        FadeToWhite 10
        WhiteFadeOut 20
        WaitFrames 60
        WarpToMapWithEntities 15, 9, 1, 96, 192   ; back aboard: the ride home (Ryan)
        CoopCall 9, 1, 128, 196
        SetEntityFacing 0, 0
        PushActiveCharIndex
        PushByte 2
        CmpNe
