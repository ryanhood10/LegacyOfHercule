; The Broly side chapter of the ten-day wait (docs/story.md 4g "Broly side chapter"), applied by
; data/story/broly.json (Capsule Corp maps) and data/maps/broly_arena.json (zone 15 area 3, which names
; this file in "sources"). Generated guard blocks: an actor of a trip member is spawned, moved or
; despawned only when neither player plays that character (the stock scenes' pattern; a script step on
; a sprite with no entity writes through a null pointer).
;
; Right after Cell's TV broadcast Bulma walks in: a Saiyan ship has landed in the backyard for Vegeta
; (flag 400). In the backyard (zone 6 area 21), with Vegeta as a player, Paragus steps out of the ship
; and offers him New Planet Vegeta; Trunks, Krillin, Gohan and Piccolo come along; everyone boards through the
; ship's door, the ship shakes through the flight and lands (flag 401; the party's state is kept in flags 404-419 by CoopCall 10 and the trip's five
; are selectable, Hercule stays home). The arena (zone 15 area 3) has the landing zone with the ship (no
; save pad: there is no way back until Broly falls); crossing the basin's rim brings everyone on screen for Paragus' betrayal and Broly
; (sprite 159, waiting in the basin), then players 1 and 2 fight Broly (stat 115) and Paragus (stat
; 116, sprite 170) as a pair (bosses.c): if Paragus falls first Broly rages once (full HP, stronger,
; faster; the rage dialogue set by CoopCall 9). Both down: the planet explodes, Capsule Corp's backyard,
; everyone talks it over, fade to black, the party as before the trip (flag 402).
; Flags: 377 aboard allowed (Paragus' offer taken), 378 landed on New Planet Vegeta, 400 ship arrived, 401 trip
; under way, 402 chapter done, 403 confrontation seen, 404-419 the kept
; party (vmcall.c PartyKeep). Speakers: 0 narration (Broly has no portrait), 2 Gohan, 3 Piccolo,
; 4 Vegeta, 5 Trunks (party slots 0-3: their current portraits), 36 Bulma, 73 Krillin, 120 Paragus
; (tools/brolysprites.py).

; ---- zone 6 area 16: Cell's broadcast, then Bulma's news ------------------------------------------

; stock entries 0-8 keep their indexes (entry 6 returns 8 absolutely); Bulma's lines are appended as
; 9-11 and run between the broadcast's last line (5) and its closing script (6)
sequence broly_tv
  stockseq @083d1534 0 4                 ; Cell: "I am Cell...", the Cell Games in nine days
  stock @083d14ec -> 9                   ; "Now, let the games begin!"
  stock @083d150a                        ; stock 6: flag 157; Goku and Gohan's scene next when flag 156
  stop 0x0
  stock @083d152c                        ; stock 8: jump to "Meanwhile..."
  script
        SpawnCharacterEntity 24, 240, 256
        WalkToPosition 24, 240, 136
        SetEntityFacing 24, 1
        PlayAudio 50
  text 36 "BULMA: Hey, everybody!  A spaceship just landed in our backyard!\x0bIt looks like a Saiyan ship...  Somebody tell Vegeta.\x0bI think it's here for him."
  script -> 6
        WalkToPosition 24, 240, 256
        DespawnEntity 24
        SetStoryFlag 400
end

; ---- conditions -----------------------------------------------------------------------------------

; the ship stands in the backyard from Bulma's news until it leaves
script broly_ship_cond
        StackTestStoryFlag 400
        StackTestStoryFlagNot 401
        And
end

; the trip is under way (the arena's ship and Broly, the rim trigger)
script broly_trip_cond
        StackTestStoryFlag 401
        StackTestStoryFlagNot 402
        And
end

; ---- zone 6 area 21: the backyard ----------------------------------------------------------------

sequence broly_yard
  script                                 ; Vegeta is player 1 or player 2: the scene (3), else a hint (1); seen (377): nothing
        StackTestStoryFlag 377
        JumpIfFalse L0
        PushByte 2
        END
      L0:
        PushActiveCharIndex
        PushByte 2
        CmpEq
        CoopCall 8, 0, 0, 0
        PushByte 2
        CmpEq
        Add
        JumpIfFalse L1
        PushByte 3
        END
      L1:
        PushByte 1
        END
  text 0 "@^A round ship with Saiyan markings sits on the patio, humming quietly.\x0bVegeta should see this."
  stop 0x0
  script
        SetPlayerVisible 0
        PlayMusic 39
        WalkToPosition 0, 240, 452       ; the lawn in front of the ship, left of its door
        SetEntityFacing 0, 3
        CoopCall 9, 1, 208, 452
        PanCameraToPosition 128, 344, 2
        WaitFrames 30
        PlayAudio 50
        SpawnCharacterEntity 170, 344, 412  ; Paragus steps out of the ship's door and down its ramp
        WalkToPosition 170, 344, 456
        WalkToPosition 170, 288, 456
        SetEntityFacing 170, 2
        WaitFrames 20
  text 120 "PARAGUS: Prince Vegeta...  At last I have found you."
  text 4 "VEGETA: That armor...  You're a Saiyan!  Who are you?"
  text 120 "PARAGUS: My name is Paragus.\x0bI served your father, King Vegeta, before Frieza destroyed our world."
  text 120 "PARAGUS: I have found a new home for our people, my prince.  A New Planet Vegeta.\x0bIt has everything a Saiyan could want...  except a king."
  text 4 "VEGETA: A planet of my own...  Hmph.\x0bA prince belongs on a throne, not guarding this mud ball."
  script
        PushActiveCharIndex
        PushByte 3
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 3
        CmpNe
        And
        JumpIfFalse N1
        SpawnCharacterEntity 132, 16, 272
        WalkToPosition 132, 200, 476
        SetEntityFacing 132, 3
      N1:
        PushActiveCharIndex
        PushByte 0
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 0
        CmpNe
        And
        JumpIfFalse N2
        SpawnCharacterEntity 56, 16, 272
        WalkToPosition 56, 176, 468
        SetEntityFacing 56, 3
      N2:
        PushActiveCharIndex
        PushByte 1
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 1
        CmpNe
        And
        JumpIfFalse N3
        SpawnCharacterEntity 103, 16, 272
        WalkToPosition 103, 152, 476
        SetEntityFacing 103, 3
      N3:
        PushActiveCharIndex
        PushByte 6
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 6
        CmpNe
        And
        JumpIfFalse N4
        SpawnCharacterEntity 76, 16, 272
        WalkToPosition 76, 176, 448
        SetEntityFacing 76, 3
      N4:
        WaitFrames 20
  text 5 "TRUNKS: Father, wait!  You can't just fly off with a stranger!\x0bWe don't know anything about this man!"
  text 73 "KRILLIN: A brand-new Planet Vegeta, out of nowhere?  This smells like a trap to me..."
  text 3 "PICCOLO: Then we all go.  If it's a trap, we spring it together."
  text 2 "GOHAN: I'm coming too!"
  text 120 "PARAGUS: ...As you wish.  All are welcome.  Come, my king."
  script
        WalkToPosition 170, 344, 456
        WalkToPosition 170, 344, 412
        DespawnEntity 170
        PushActiveCharIndex
        PushByte 3
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 3
        CmpNe
        And
        JumpIfFalse N5
        WalkToPosition 132, 344, 476
        WalkToPosition 132, 344, 412
        DespawnEntity 132
      N5:
        PushActiveCharIndex
        PushByte 0
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 0
        CmpNe
        And
        JumpIfFalse N6
        WalkToPosition 56, 344, 476
        WalkToPosition 56, 344, 412
        DespawnEntity 56
      N6:
        PushActiveCharIndex
        PushByte 1
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 1
        CmpNe
        And
        JumpIfFalse N7
        WalkToPosition 103, 344, 476
        WalkToPosition 103, 344, 412
        DespawnEntity 103
      N7:
        PushActiveCharIndex
        PushByte 6
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 6
        CmpNe
        And
        JumpIfFalse N8
        WalkToPosition 76, 344, 476
        WalkToPosition 76, 344, 412
        DespawnEntity 76
      N8:
        SetStoryFlag 377                 ; the players board through the ship's door themselves (broly_board)
        SetPlayerVisible 1
        SetActiveEntity 0
end

; ---- the ship (Ryan, 2026-10-20 / 21): board through its door, the flight inside it, the landing ----------
; The ship is map art (tools/shipart.py, 256 x 160: the backyard's variation while it is parked, data/maps/
; yard_ship.json + src/coop/shipyard.c; painted into New Planet Vegeta's landing zone, broly_arena.json), with an
; open door and a ramp at its front. Walking up the ramp into the doorway (the backyard's trigger there) takes
; the players inside once Paragus' offer is taken (flag 377; before that the hatch's line) (zone 15 area 9,
; data/maps/saiyan_ship.json: Buu's Fury's round room, its Capsule Corp pad cleared) for the flight: the ship
; shakes for a few seconds while nobody moves, then lands (flag 378); the room's door then leads out of the
; ship's door onto New Planet Vegeta. After Broly the ride home plays in the same room (broly_end) and its door
; leads out of the ship's door into the backyard (broly_home_out, flag 379), where the others wait.

; the ship stands in the backyard from Bulma's news on, except while it is away (it flew the players home)
script broly_ship_shown_cond
    StackTestStoryFlag 400
    StackTestStoryFlagNot 401
    StackTestStoryFlag 402
    Not
    And
    END
end

; the ride home landed, the players not yet out (the room's door: the backyard)
script broly_home_cond
    StackTestStoryFlag 402
    StackTestStoryFlagNot 379
    And
    END
end

sequence broly_board
  script                                 ; Paragus' offer taken (377): aboard (3), else the hatch (1)
        StackTestStoryFlag 377
        JumpIfFalse B1
        PushByte 3
        END
      B1:
        PushByte 1
        END
  text 0 "@^The ship's hatch stands open.  Whoever flew it here can't be far..."
  stop 0x0
  script                                 ; aboard: the trip's party, then inside the ship
        SetPlayerVisible 0
        FadeOut 60
        SetStoryFlag 401
        CoopCall 10, 0, 0, 0             ; keep the party as it is (flags 404-419) for the way home
        SetCharacterInPartyFlag 0
        SetCharacterFlag_Bit1 0
        SetCharacterFlag_Bit1 1
        SetCharacterFlag_Bit1 2
        SetCharacterFlag_Bit1 3
        SetCharacterFlag_Bit1 6
        ClearCharacterFlag_Bit1 4
        ClearCharacterFlag_Bit1 5
        ClearCharacterFlag_Bit1 7
        SetActiveCharacter 2
        WarpToMapWithEntities 15, 9, 1, 96, 192
        CoopCall 6, 3, 0, 0                ; player 2 (kept across the warp) plays Trunks
        CoopCall 9, 1, 128, 196
        SetEntityFacing 0, 0
        SpawnCharacterEntity 170, 120, 92  ; Paragus and the others ride along (Ryan, 2026-10-21)
        SetEntityFacing 170, 0
        PushActiveCharIndex
        PushByte 2
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 2
        CmpNe
        And
        JumpIfFalse R0
        SpawnCharacterEntity 137, 64, 112
        SetEntityFacing 137, 3
      R0:
        PushActiveCharIndex
        PushByte 3
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 3
        CmpNe
        And
        JumpIfFalse R1
        SpawnCharacterEntity 132, 48, 148
        SetEntityFacing 132, 3
      R1:
        PushActiveCharIndex
        PushByte 0
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 0
        CmpNe
        And
        JumpIfFalse R2
        SpawnCharacterEntity 56, 56, 184
        SetEntityFacing 56, 3
      R2:
        PushActiveCharIndex
        PushByte 1
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 1
        CmpNe
        And
        JumpIfFalse R3
        SpawnCharacterEntity 103, 168, 84
        SetEntityFacing 103, 2
      R3:
        PushActiveCharIndex
        PushByte 6
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 6
        CmpNe
        And
        JumpIfFalse R4
        SpawnCharacterEntity 76, 200, 100
        SetEntityFacing 76, 2
      R4:
        SetPlayerVisible 1
        WaitFrames 40
        PlayAudio 26
        ScreenShake 0, 8, 200
        WaitFrames 60
  text 0 "@^The ship blasts off for New Planet Vegeta..."
  script                                 ; the flight: nobody moves while it shakes
        PlayAudio 26
        ScreenShake 0, 12, 200
        WaitFrames 170
        ScreenShake 0, 5, 60
        WaitFrames 70
        PlayAudio 50
        SetStoryFlag 378
  text 0 "@^The ship lands."
  script                                 ; Paragus and the others get off first, out of the room's door
        WaitFrames 20
        WalkToPosition 170, 120, 60
        DespawnEntity 170
        PushActiveCharIndex
        PushByte 2
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 2
        CmpNe
        And
        JumpIfFalse O0
        WalkToPosition 137, 120, 100
        WalkToPosition 137, 120, 60
        DespawnEntity 137
      O0:
        PushActiveCharIndex
        PushByte 3
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 3
        CmpNe
        And
        JumpIfFalse O1
        WalkToPosition 132, 120, 100
        WalkToPosition 132, 120, 60
        DespawnEntity 132
      O1:
        PushActiveCharIndex
        PushByte 0
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 0
        CmpNe
        And
        JumpIfFalse O2
        WalkToPosition 56, 120, 100
        WalkToPosition 56, 120, 60
        DespawnEntity 56
      O2:
        PushActiveCharIndex
        PushByte 1
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 1
        CmpNe
        And
        JumpIfFalse O3
        WalkToPosition 103, 120, 100
        WalkToPosition 103, 120, 60
        DespawnEntity 103
      O3:
        PushActiveCharIndex
        PushByte 6
        CmpNe
        CoopCall 8, 0, 0, 0
        PushByte 6
        CmpNe
        And
        JumpIfFalse O4
        WalkToPosition 76, 120, 100
        WalkToPosition 76, 120, 60
        DespawnEntity 76
      O4:
        SetActiveEntity 0
end

