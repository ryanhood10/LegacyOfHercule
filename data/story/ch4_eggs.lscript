; half her health: the first half's record falls; the eggs left hatch, and she stands again on the second half's
sequence z8_dino_hatch
  script
        PlayAudio 60
        WaitFrames 30
  text 173 "@MOTHER DINOSAUR: Hah...  hah...\x0bYou hit harder than you look."
  text 173 "@MOTHER DINOSAUR: But you forgot about my other two."
  script                                 ; the eggs that are left begin to rattle
        ScreenShake 0, 4, 40
  text 0 "@^Behind her, the eggs that are left begin to rattle."
  script
        ScreenShake 0, 10, 24
        SetStoryFlag 478
        WhiteFlash 20
        PlayAudio 47
        StackTestStoryFlagNot 117
        JumpIfFalse a
        FindEntityByType 7
        TriggerMapEvent 3
      a:
        StackTestStoryFlagNot 118
        JumpIfFalse b
        FindEntityByType 8
        TriggerMapEvent 4
      b:
        StackTestStoryFlagNot 119
        JumpIfFalse c
        FindEntityByType 9
        TriggerMapEvent 5
      c:
        SetStoryFlag 117
        SetStoryFlag 118
        SetStoryFlag 119
        DespawnCharacterAndRecordPosition 245, 2
        DrawBossHealthBarRange 245, 0, 50
  text 0 "@^CRACK!  CRACK!\x0bTwo tiny, furious dinosaurs burst out of their shells!"
  text 173 "@MOTHER DINOSAUR: That's my babies!\x0bGet 'em!"
  script
        SetActiveEntity 0
end

; the second half's record falls: the warp opens the tubes and clears any baby still standing, then she and two actors of them walk out (Ryan, 2026-11-05: not a line over a fade); the second runs off late, without a caption (2026-11-05).
; Two babies show one sprite: a sprite-addressed step finds the first, so the first leaves, and only then is the second addressed.
sequence z8_dino_defeat
  script
        PlayAudio 60
        WaitFrames 40
        AddEXP 1500
        WaitFrames 30
  text 173 "@MOTHER DINOSAUR: Enough...  ENOUGH!\x0bCome, children.  We're leaving."
  script
        SetStoryFlag 477
        FadeToWhite 10
        WarpToMapNoEntities 8, 50, 1, 288, 340
        SpawnCharacterEntity 245, 352, 320
        SpawnCharacterEntity 246, 320, 366
        SpawnCharacterEntity 246, 384, 366
        FadeFromWhite 10
        BeginCommandBatch
        WalkToPosition 245, 480, 320
        WalkToPosition 246, 480, 366
        CommitCommandBatch
        DespawnEntity 245
        DespawnEntity 246
        SetEntityFacing 246, 2
        WaitFrames 60                    ; the second baby looks back a moment (where a caption was), then runs after them
        WalkToPosition 246, 480, 366
        DespawnEntity 246
  fmt 1 "@%s: ...I'm just gonna go break that generator now."
        PushActiveCharName
end
