; ---- zone 8 area 48: the sealed cave mouth -----------------------------------------------------------

sequence ch9_rubble
  [0] script                             ; both generators down: the rubble goes (next 1), else the generators first (8)
        SetPlayerVisible 0
        PanCameraToPosition 40, 170, 2
        PlayAudio 50
        StackTestStoryFlag 423
        StackTestStoryFlag 424
        And
        JumpIfFalse L1
        PushByte 1
        END
      L1:
        PushByte 8
        END
  [1] script                             ; Krillin played (next 2), else 3
        CoopCall 22, 4, 6, 0
        JumpIfFalse a
        PushByte 2
        END
      a:
        PushByte 3
        END
  [2] text 73 "KRILLIN: Aw, no...  The cave collapsed when the lab blew up.\x0bWe'll never dig through all that!"
  [3] script                             ; 16 played: he punches through (next 4), else Krillin blasts it (5)
        CoopCall 22, 4, 7, 0
        JumpIfFalse a
        PushByte 4
        END
      a:
        PushByte 5
        END
  [4] text 26 "ANDROID 16: Stand back." -> 6
  [5] text 73 "KRILLIN: ...Then again, nothing a little ki can't fix.\x0bStand back!" -> 6
  [6] script                             ; the rubble goes; then Krillin's quip when both are there (next 7), else 12
        CoopCall 22, 4, 7, 0
        JumpIfFalse K0
        PlayAudio 26
        Jump K9
      K0:
        BeginCommandBatch
        NPCFireKiBlast 0, 152, 264, 100
        CommitCommandBatch
      K9:
        WaitFrames 30
        WhiteFlash 10
        ScreenShake 0, 30, 40
        PlayAudio 20
        SpawnDustCloud 0, 152, 264
        DisableLayer 1
        SetCollisionRect 128, 272, 192, 296
        SetCollisionRect 136, 240, 168, 272
        SetStoryFlag 422
        WaitFrames 50
        CoopCall 22, 4, 6, 0
        CoopCall 22, 4, 7, 0
        And
        JumpIfFalse L1
        PushByte 7
        END
      L1:
        PushByte 12
        END
  [7] text 73 "KRILLIN: ...Remind me never to arm-wrestle you." -> 12
  [8] script                             ; the generators first: Krillin played (next 9), else 10
        CoopCall 22, 4, 6, 0
        JumpIfFalse a
        PushByte 9
        END
      a:
        PushByte 10
        END
  [9] text 73 "KRILLIN: Aw, no...  The cave collapsed when the lab blew up."
  [10] script                            ; 16 played (next 11), else player 1 says it (14)
        CoopCall 22, 4, 7, 0
        JumpIfFalse a
        PushByte 11
        END
      a:
        PushByte 14
        END
  [11] text 26 "ANDROID 16: The rubble is not the problem.\x0bTwo of Gero's generators feed the bunker's defenses again:\x0bone under the waterfall west of the mountain pass, one under the waterfall to the east.\x0bWe shut them down first."
  [12] script
        SetActiveEntity 0
        SetPlayerVisible 1
        END
  stop
  [14] fmt 250 "%s: The rubble is not the problem.\x0bTwo of Gero's generators feed the bunker's defenses again:\x0bone under the waterfall west of the mountain pass, one under the waterfall to the east.\x0bWe shut them down first." -> 12
        PushActiveCharNameUpper
        END
end

; ---- zone 8 area 63: the bunker. Two Android 19s, the file on 13, the computer smashed -------------

sequence ch9_bunker
  [0] script                             ; 16 played (next 1), else player 1 says it (2)
        SetPlayerVisible 0
        WalkToPosition 0, 216, 280
        PanCameraToPosition 64, 96, 2
        PlayAudio 50
        CoopCall 22, 4, 7, 0
        JumpIfFalse a
        PushByte 1
        END
      a:
        PushByte 2
        END
  [1] text 26 "ANDROID 16: Dr. Gero's computer.  It survived." -> 3
  [2] fmt 250 "%s: Dr. Gero's computer.  It survived." -> 3
        PushActiveCharNameUpper
        END
  [3] text 0 "@^ASSEMBLY COMPLETE:  UNIT 19, SPARE BODY A.\x0bASSEMBLY COMPLETE:  UNIT 19, SPARE BODY B.\x0bACTIVATING..."
  [4] script                             ; Krillin played (next 5), else 6
        CoopCall 22, 4, 6, 0
        JumpIfFalse a
        PushByte 5
        END
      a:
        PushByte 6
        END
  [5] text 73 "KRILLIN: TWO of them?!  Aw man, not those energy-sucking creeps!"
  [6] script                             ; 16's word to Krillin when both are there (next 7), else the fight (8)
        CoopCall 22, 4, 6, 0
        CoopCall 22, 4, 7, 0
        And
        JumpIfFalse a
        PushByte 7
        END
      a:
        PushByte 8
        END
  [7] text 26 "ANDROID 16: Do not let them grab you.  I will do the punching."
  [8] script
        TriggerMapEvent 1
        SetPlayerVisible 1
        DrawBossHealthBar 12
        PlayMusic 35
        SetActiveEntity 0
        END
end

; both 19s are down (the record's defeat action runs when the last of the pair falls)
sequence ch9_bunker_won
  [0] script                             ; Krillin played (next 1), else 2
        SetPlayerVisible 0
        StopMusic
        WaitFrames 60
        PanCameraToPosition 64, 96, 2
        CoopCall 22, 4, 6, 0
        JumpIfFalse a
        PushByte 1
        END
      a:
        PushByte 2
        END
  [1] text 73 "KRILLIN: Phew...  Okay.  Let's wreck this thing before it builds a third one."
  [2] script                             ; 16 played (next 3), else player 1 reads the file (4)
        CoopCall 22, 4, 7, 0
        JumpIfFalse a
        PushByte 3
        END
      a:
        PushByte 4
        END
  [3] text 26 "ANDROID 16: Wait.  There is one more file.\x0bANDROID 13:  UNFINISHED.  FINAL STAGE ON HOLD." -> 5
  [4] fmt 250 "%s: Wait.  There is one more file.\x0bANDROID 13:  UNFINISHED.  FINAL STAGE ON HOLD." -> 5
        PushActiveCharNameUpper
        END
  [5] script                             ; both there: Krillin asks (6), 16 answers (7); 16 alone: 7; Krillin alone: 8
        CoopCall 22, 4, 6, 0
        CoopCall 22, 4, 7, 0
        And
        JumpIfFalse a
        PushByte 6
        END
      a:
        CoopCall 22, 4, 7, 0
        JumpIfFalse b
        PushByte 7
        END
      b:
        PushByte 8
        END
  [6] text 73 "KRILLIN: Android 13?  The guy who's been hanging around with Gero?  Unfinished?\x0bFrom what Piccolo said, he sounded pretty finished to me!"
  [7] text 26 "ANDROID 16: The file names his final stage: he takes in two other androids.\x0bThe rest has been erased." -> 9
  [8] fmt 250 "%s: The file names his final stage: he takes in two other androids.\x0bThe rest has been erased." -> 9
        PushActiveCharNameUpper
        END
  [9] script                             ; Krillin's "Smash it!" when both are there (next 10), else 11
        CoopCall 22, 4, 6, 0
        CoopCall 22, 4, 7, 0
        And
        JumpIfFalse a
        PushByte 10
        END
      a:
        PushByte 11
        END
  [10] text 73 "KRILLIN: ...I don't like the sound of that.  Smash it!"
  [11] script                            ; the smash; outside player 1 on his own spot, the other of the two as an actor only when player 2 plays him
        SetStoryFlag 425                  ; (player 2 has no entity after the warp); alone as Krillin 16 stands there (kept for the plot: his decision)
        BeginCommandBatch
        NPCFireKiBlast 0, 184, 192, 100
        SpawnDustCloud 0, 184, 192
        CommitCommandBatch
        PlayAudio 20
        FadeToWhite 10
        WarpToMapNoEntities 8, 48, 1, 168, 330
        PushActiveCharIndex
        PushByte 7
        CmpEq
        JumpIfFalse B1
        SetEntityPositionInstant 0, 196, 326
        SetEntityFacing 0, 1
        CoopCall 22, 4, 6, 0
        JumpIfFalse B2
        SpawnCharacterEntity 76, 168, 330
        SetEntityFacing 76, 3
        Jump B2
      B1:
        SetEntityFacing 0, 3
        SpawnCharacterEntity 8, 196, 326
        SetEntityFacing 8, 1
      B2:
        SetPlayerVisible 0
        PanCameraToPosition 56, 240, 10
        WhiteFadeOut 30
        WaitFrames 60
        SpawnCharacterEntity 63, 150, 184         ; two hawks glide in over the clearing and settle above him (a walk: birds have no flying pose, group 12)
        SpawnCharacterEntity 64, 176, 192
        BeginCommandBatch
        WalkToPosition 63, 220, 250
        WalkToPosition 64, 244, 262
        CommitCommandBatch
        WaitFrames 30
        CoopCall 22, 2, 76, 0                     ; Krillin wanders over to 16, who is watching them (his actor, or player 1)
        JumpIfFalse B3
        WalkToPosition 76, 176, 328
        SetEntityFacing 76, 3
        PushByte 12
        END
      B3:
        PushActiveCharIndex
        PushByte 6
        CmpEq
        JumpIfFalse B4
        WalkToPosition 0, 176, 328
        SetEntityFacing 0, 3
        PushByte 12
        END
      B4:
        PushByte 13                               ; 16 alone: nobody to ask him
        END
  [12] text 73 "KRILLIN: Well, that's the last of Gero's toys.  ...16?  What are you looking at?"
  [13] text 26 "ANDROID 16: The birds.\x0bDr. Gero built me to destroy Goku.  He did not build me to watch birds.\x0b...I like them."
  [14] script                            ; Krillin there (next 15: his question, 16 turns to him), else 17
        CoopCall 22, 4, 6, 0
        JumpIfFalse a
        PushByte 15
        END
      a:
        PushByte 17
        END
  [15] text 73 "KRILLIN: Heh.  You're full of surprises, big guy.  So what now?"
  [16] script                            ; 16 turns from the birds to Krillin
        CoopCall 22, 2, 8, 0
        JumpIfFalse B4
        SetEntityFacing 8, 2
        END
      B4:
        SetEntityFacing 0, 2
        END
  [17] text 26 "ANDROID 16: Cell will destroy everything on this planet.  The birds too.\x0bI will go to the Cell Games."
  [18] script                            ; Krillin there (next 19), else 20
        CoopCall 22, 4, 6, 0
        JumpIfFalse a
        PushByte 19
        END
      a:
        PushByte 20
        END
  [19] text 73 "KRILLIN: Then I guess we'll see you there.  I'm heading back to Capsule Corp."
  [20] script
        FadeOut 60
        CoopCall 12, 0, 0, 0
        SetActiveCharacterNoReset 6
        CoopCall 6, 5, 0, 0
        WarpToMapWithEntities 6, 5, 1, 328, 188   ; by Briefs' table, with Bulma and her father on screen
        SetEntityFacing 0, 3
        SetPlayerVisible 0
        END
  [21] text 36 "BULMA: Krillin!  You're back!  So?  What happened with Gero's computer?"
  [22] text 73 "KRILLIN: Scrap metal.  And 16 is coming to the Cell Games.  He's on our side."
  [23] script                            ; two players: Hercule, player 2's character now, walks in (next 24; player 2's entity went at the warp
        CoopCall 5, 0, 0, 0                   ; out of the bunker); alone he is not in the scene (26)
        JumpIfFalse H0
        SpawnCharacterEntity 72, 224, 400
        WalkToPosition 72, 320, 300
        WalkToPosition 72, 318, 220
        WalkToPosition 72, 298, 178
        SetEntityFacing 72, 3
        SetEntityFacing 0, 2
        PushByte 24
        END
      H0:
        PushByte 26
        END
  [24] text 67 "HERCULE: Did somebody say the Cell Games?  Ha!  Don't worry, little buddy.\x0bThe world champion will handle that Cell personally!"
  [25] script                            ; he ends where player 2's entity appears (12 px left of player 1)
        PushByte 72
        PushEntityPosition 0
        PushVarint 65536
        Div
        PushVarint 12
        Sub
        PushEntityPosition 0
        PushEntityPosition 0
        PushVarint 65536
        Div
        PushVarint 65536
        Mul
        Sub
        Step WalkToPosition
        DespawnEntity 72
  [26] script
        SetActiveEntity 0
        SetPlayerVisible 1
        END
end
