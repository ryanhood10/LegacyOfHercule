; Chapter 9 side chapter "Gero's computer" (docs/story.md 4g): Krillin (player 1) and Android 16 (player 2,
; the last party slot: src/coop/a16player.c, CoopCall 11 / 12) go back to Dr. Gero's lab during the ten-day
; wait. Flags 420-439: 420 running (16 joined; he stays selectable until the Cell Games), 421 over, 422 rubble punched, 423 / 424 west / east generator down,
; 425 bunker done, 430 + slot the selectable bits saved by the lock.
; Opcode 0x05 (lscript "Not") is the VM's logical OR (decompiled 0x08008FE6; docs/scripts.md 2.1).

; ---- conditions ----------------------------------------------------------------------------------

; the workshop scene: after the memory scene (155), Cell's TV announcement (157) and the Scouter Note
; (the note, the part or the Scouter in hand, or the Scouter given: 156); once
script ch9_ws_cond
    StackTestStoryFlag 155
    StackTestStoryFlag 157
    And
    StackTestStoryFlagNot 420
    And
    StackGetItemCount 23
    StackGetItemCount 24
    Not
    StackGetItemCount 22
    Not
    StackTestStoryFlag 156
    Not
    And
    END
end

; the chapter runs (16 in the party, the bunker not done yet)
script ch9_active_cond
    StackTestStoryFlag 420
    StackTestStoryFlagNot 425
    And
    END
end

script ch9_gen_west_cond
    StackTestStoryFlag 420
    StackTestStoryFlagNot 421
    And
    StackTestStoryFlagNot 423
    And
    END
end

script ch9_gen_east_cond
    StackTestStoryFlag 420
    StackTestStoryFlagNot 421
    And
    StackTestStoryFlagNot 424
    And
    END
end

script ch9_rubble_cond
    StackTestStoryFlag 420
    StackTestStoryFlagNot 421
    And
    StackTestStoryFlagNot 422
    And
    END
end

; zone 8 area 64: the door goes to the computer room (63) before the self-destruct (140) or while the
; chapter runs, else to the wrecked room (65)
script ch9_door63_cond
    StackTestStoryFlagNot 140
    StackTestStoryFlag 420
    StackTestStoryFlagNot 425
    And
    Not
    END
end

script ch9_door65_cond
    StackTestStoryFlag 140
    StackTestStoryFlagNot 420
    StackTestStoryFlag 425
    Not
    And
    END
end

; ---- zone 8 area 48: the stock on-load script, with the rubble at the cave mouth (layer 1 and the
; blocked rect, both from the self-destruct, flag 141) left out once 16 has punched through (422) ----
script ch9_a48_onload
    DisableLayer 1
    StackTestStoryFlag 127
    JumpIfFalse L1
    FindEntityByType 1
  L1:
    StackTestStoryFlag 136
    JumpIfFalse L2
    FindEntityByType 11
    FindCharacterEntity 0
  L2:
    StackTestStoryFlag 140
    JumpIfFalse L3
    FindEntityByType 0
  L3:
    StackTestStoryFlag 141
    JumpIfFalse L5
    FindCharacterEntity 2
    ClearCollisionRect 192, 456, 208, 464
    StackTestStoryFlagNot 422
    JumpIfFalse L4
    FindCharacterEntity 10                   ; the boulders in the cave mouth
    EnableLayer 1
    ClearCollisionRect 128, 272, 192, 296
    Jump L5
  L4:
    SetCollisionRect 136, 240, 168, 272      ; the cave mouth itself (stock: opened by the Only Trunks barrier)
  L5:
    END
end

; ---- zone 6 area 5: Dr. Briefs' workshop. 16 wakes on the table, Gero's computer is running again -----
; Only who is played is in a scene (Ryan, 2026-11-05; docs/howto.md "Stage a scene" rule 2): Krillin walks in only with two players (he is
; player 1 after the scene); alone the one played sets out, the other is not shown. Lines of one nobody plays are skipped, or said by player 1
; (speaker 250, his own name) where the chapter needs them. Kept for the plot: 16 in the birds' scene alone as Krillin (his decision to go to
; the Cell Games). CoopCall 22 op 4: 1 = played.

sequence ch9_workshop
  [0] script
        SetPlayerVisible 0
        PanCameraToPosition 216, 96, 3
        PlayAudio 50
        CoopCall 5, 0, 0, 0                  ; two players and nobody plays Krillin: he walks in (he is player 1 after it)
        CoopCall 22, 1, 6, 0
        And
        JumpIfFalse L1
        SpawnCharacterEntity 76, 224, 400
        WalkToPosition 76, 320, 300                ; round the table
        WalkToPosition 76, 320, 200
        WalkToPosition 76, 300, 176
        SetEntityFacing 76, 3
      L1:
        END
  [1] text 48 "DR. BRIEFS: Ah, there you are!  Good news: Android 16 is all fixed up.\x0bAnd that nasty bomb Dr. Gero hid inside him?  Gone.  I took it out myself!"
  [2] text 36 "BULMA: He hasn't moved since we closed him up, though.\x0bDad, are you sure you connected everything?"
  [3] script                             ; 16 stirs on the table
        WaitFrames 40
        PlayAudio 62
        WaitFrames 50
        END
  [4] text 26 "ANDROID 16: ...Systems online."
  [5] text 26 "ANDROID 16: I am receiving a signal.\x0bIt comes from Dr. Gero's laboratory in the Northern Mountains.\x0bHis computer is running again."
  [6] text 36 "BULMA: The computer that made Cell?!  But Trunks blew it up!"
  [7] text 26 "ANDROID 16: The bunker below the lab was not destroyed.\x0bThe computer is building something.\x0bI will stop it."
  [8] script                             ; Krillin there (played, or two players): his offer (next 9), else 16 sets out alone (11)
        CoopCall 22, 4, 6, 0
        CoopCall 5, 0, 0, 0
        Not
        JumpIfFalse a
        PushByte 9
        END
      a:
        PushByte 11
        END
  [9] text 73 "KRILLIN: Then you're not going alone.  I've been down there with Trunks.\x0bI know the way to that bunker."
  [10] text 26 "ANDROID 16: ...Very well." -> 12
  [11] text 0 "@^Android 16 sets out for Dr. Gero's lab in the Northern Mountains." -> 13
  [12] text 0 "@^Krillin and Android 16 set out for Dr. Gero's lab in the Northern Mountains."
  [13] script
        CoopCall 11, 0, 0, 0
        CoopCall 5, 0, 0, 0                       ; two players: Krillin player 1, 16 player 2
        JumpIfFalse L0
        CoopCall 6, 7, 0, 0
        SetActiveCharacterNoReset 6
        Jump L2
      L0:
        SetActiveCharacterNoReset 7               ; alone, player 1 is 16 (Ryan); Krillin at a save pad
      L2:
        FadeOut 60
        WarpToMapWithEntities 6, 5, 1, 328, 188   ; the workshop again: the table is empty now (the on-load shows 16's body
        SetEntityFacing 0, 3                      ; only before flag 420); nobody else stands there
        WaitFrames 60
        SetActiveEntity 0
        SetPlayerVisible 1
        END
end

; ---- zone 8 areas 27 and 40: Gero's generators under the waterfalls -------------------------------
; 16's lines are his when someone plays him, else player 1's (alone as Krillin, who traded at a save pad)

sequence ch9_gen_west
  [0] script
        SetPlayerVisible 0
        PanCameraToPosition 270, 10, 3
        PlayAudio 50
        END
  [1] text 0 "@^Under the waterfall, one of Dr. Gero's generators is humming again."
  [2] script                             ; 16 played (next 3), else player 1 says it (4)
        CoopCall 22, 4, 7, 0
        JumpIfFalse a
        PushByte 3
        END
      a:
        PushByte 4
        END
  [3] text 26 "ANDROID 16: This generator feeds the bunker's defenses.  Stand back." -> 5
  [4] fmt 250 "%s: This generator feeds the bunker's defenses.  Stand back." -> 5
        PushActiveCharNameUpper
        END
  [5] script
        PlayAudio 26
        WaitFrames 20
        WhiteFlash 10
        ScreenShake 0, 20, 30
        PlayAudio 20
        WaitFrames 40
        SetStoryFlag 423
        StackTestStoryFlag 424
        JumpIfFalse one
        CoopCall 22, 4, 7, 0
        JumpIfFalse b2
        PushByte 8
        END
      b2:
        PushByte 9
        END
      one:
        CoopCall 22, 4, 7, 0
        JumpIfFalse o2
        PushByte 6
        END
      o2:
        PushByte 7
        END
  [6] text 26 "ANDROID 16: One generator is down.\x0bThe other is under the waterfall east of the mountain pass." -> 10
  [7] fmt 250 "%s: One generator is down.\x0bThe other is under the waterfall east of the mountain pass." -> 10
        PushActiveCharNameUpper
        END
  [8] text 26 "ANDROID 16: Both generators are down.  Now, the lab." -> 10
  [9] fmt 250 "%s: Both generators are down.  Now, the lab." -> 10
        PushActiveCharNameUpper
        END
  [10] script
        SetActiveEntity 0
        SetPlayerVisible 1
        END
end

